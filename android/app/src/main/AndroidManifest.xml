<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan 1.2 is the minimum: descriptor indexing, independentBlend, ... (PLAYER_ANDROID_PORT.md, A0). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x402000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- Loopback IPC (QA channel, batch A3) needs a socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="RayTrophi Player"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="com.raytrophi.player.PlayerActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|keyboard|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density|navigation"
            android:launchMode="singleTask"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
