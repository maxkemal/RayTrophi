# Agent runtime secrets. The repo is MIT and public; an API key committed once
# is a key that has to be rotated. .env.example carries the shape, never a value.
.env
RayTrophiAgent/.env

# Scripts the agent writes for script.run_file. Model output, not source.
RayTrophiAgent/agent_scripts/

# Measurement output from measure_horizon.py
RayTrophiAgent/horizon_result.json
docs/dev/grain_suite/

# Temporary agent verification screenshots, never documentation assets.
/docs/dev/.captures/
/docs/dev/**/*.png
/docs/dev/**/*.jpg
/docs/dev/**/*.jpeg
/docs/dev/**/*.webp
/docs/dev/**/*.bmp
/docs/dev/**/*.gif

