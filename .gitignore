# Player packages (scripts/package_player.ps1)
/dist/

# Demo scenes and the scripts tied to them stay LOCAL (user decision 2026-11-20):
# the repository carries the Studio and Player code and the notes, not the
# demo rooms. Only the application's default scene is published. Removed from
# the index with `git rm --cached`; the files themselves stay on disk.
/RayTrophiStudio/assets/scenes/*
!/RayTrophiStudio/assets/scenes/default/
/docs/dev/fixtures/balloon-paint-room/
/scripts/scenes/
