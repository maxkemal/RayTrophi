// Gas buoyancy on Y-oriented MAC faces.
#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int nx; int ny; int nz;
    float dt;
    float density_weight;
    float heat_weight;
    float ambient_temperature;
    // Channel presence, mirroring the CPU addBuoyancy fallbacks: an absent
    // density channel contributes 0 and an absent temperature channel reads as
    // ambient. Without these the shader reads a zeroed buffer and turns
    // heat_weight*(0 - ambient) into a constant domain-wide downdraft.
    int has_density;
    int has_temperature;
    // Stable stratification, in heat units per world unit of height above the
    // domain floor. 0 = the old uniform-ambient atmosphere. See addBuoyancy in
    // GridFluidSolver.cpp for why this is a POTENTIAL-temperature gradient (it
    // rises with height) and not the meteorological lapse rate.
    float stratification;
    float voxel_size;
} pc;

layout(set=0,binding=0) readonly buffer Density     { float density[]; };
layout(set=0,binding=1) readonly buffer Temperature { float temperature[]; };
layout(set=0,binding=2) buffer VelY                 { float vel_y[]; };

uint cellIndex(int x,int y,int z){
    return uint(x+y*pc.nx+z*pc.nx*pc.ny);
}

void main(){
    uint id=gl_GlobalInvocationID.x;
    uint count=uint(pc.nx*(pc.ny+1)*pc.nz);
    if(id>=count) return;
    int x=int(id%uint(pc.nx));
    int y=int((id/uint(pc.nx))%uint(pc.ny+1));
    int z=int(id/uint(pc.nx*(pc.ny+1)));
    if(y<=0||y>=pc.ny) return;
    uint below=cellIndex(x,y-1,z);
    uint above=cellIndex(x,y,z);
    float d=pc.has_density!=0 ? .5*(density[below]+density[above]) : 0.0;
    float t=pc.has_temperature!=0
        ? .5*(temperature[below]+temperature[above])
        : pc.ambient_temperature;
    float excess=t-pc.ambient_temperature;
    // Environment's potential temperature at this face's height above the
    // domain floor. The face at index y sits at y*voxel_size.
    //
    // ***** GATED ON SMOKE PRESENCE, NOT CLAMPED. This used to end in
    // max(excess-env,-abs(excess)), which kept still empty air from picking up
    // a phantom downdraft but inverted the ordering it was protecting: warm gas
    // above its equilibrium sank while fully cold gas hovered, so the heat left
    // in a cap was the thing dragging the cap down. Empty air is not a cold
    // parcel, it is not a parcel at all, and density is what tells them apart.
    // Keep this IDENTICAL to buoyantAnomaly() in GridFluidSolver.cpp - the three
    // paths (dense CPU, sparse VDB, this kernel) must agree or the same scene
    // drifts depending on which one ran.
    float presence=pc.has_density!=0
        ? clamp(d/0.01,0.0,1.0)     // kStratificationPresenceDensity
        : 0.0;                      // no density channel: stratification OFF
    float env=pc.stratification*max(float(y)*pc.voxel_size,0.0)*presence;
    // ***** The environment can CANCEL buoyancy, not reverse it. A ceiling
    // stops a rise; it does not push down. Above the neutral height the parcel
    // stops being lifted and stays where it stopped. Cold heavy smoke still
    // sinks through density_weight*d, which is its own correctly-signed term.
    // Bounding `env` rather than the result keeps this continuous with
    // stratification == 0. Keep IDENTICAL to buoyantAnomaly() in
    // GridFluidSolver.cpp.
    float heat_term=excess-min(env,max(excess,0.0));
    float force=pc.density_weight*d+pc.heat_weight*heat_term;
    vel_y[id]+=force*pc.dt;
}
