#version 450
#extension GL_GOOGLE_include_directive : require
#include "sim_dispatch.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer Values { float value[]; };
layout(push_constant) uniform Params { uint count; } pc;
void main() {
    uint i = simLane256(pc.count);
    if (i < pc.count) value[i] = 0.0;
}
