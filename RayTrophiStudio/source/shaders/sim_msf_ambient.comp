#version 450
// Material State Field — ambient / boundary-condition pass (Phase 4).
//
// One invocation per surface element. Resolves the element's LOCAL ambient
// temperature and relaxes its surface temperature toward it. Nothing else: no
// gas exchange, no pyrolysis, no writes outside the element's own state.
//
// WHY THIS IS A SEPARATE PASS
// ---------------------------
// Passive cooling used to live in sim_msf_gather, which runs once per GAS
// DOMAIN. Two consequences, both wrong:
//   - an object was cooled once per domain, so adding a second smoke box halved
//     how hot anything could get;
//   - a domain the object was not even inside cooled it just as hard, because
//     "no open cell nearby" and "not in this box at all" took the same branch.
// This pass runs ONCE per frame and does not need a gas domain to exist at all,
// which is the point: a burning log carried out of the smoke box must cool
// toward the room rather than freeze or reset.
//
// LAYERING (plan doc A.6):  World -> Domain override -> Thermal field -> MSF.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    ivec4 counts;   // element_count, source_count, zone_count, input bits (1 heat, 2 water)
    vec4  params;   // dt, air film W/(m^2 K), reference_K (normalized 0), inv_kelvin_per_unit
    vec4  params2;  // max_temperature, body J/(K m^2), emissivity, world_ambient_K
} pc;

layout(set=0, binding=0) readonly buffer Centers { vec4 centers[]; };  // xyz world, w area
// Two vec4 per element; [2i+0].x (temperature) and .w (surface water, kg/m^2)
// are touched here. char, fuel and mass loss are deliberately left alone —
// ambient conditions never un-burn anything, which is the whole reason MSF exists.
layout(set=0, binding=1)          buffer State   { vec4 state[]; };

// Thermal force fields, 96 B each (MaterialStateFieldSystem::ThermalSource).
//   a: xyz = world position, w = inner_radius
//   b: x = falloff_radius, y = delta_kelvin, z = falloff_type, w = infinite
//   c, d, e: rows of the world -> field-local affine transform
//   f: x = shape (0 sphere, 1 box, 2 cylinder, 3 cone), y = rate_per_s
// All floats on the host too (they used to be raw ints read as floats).
struct ThermalSource { vec4 a; vec4 b; vec4 c; vec4 d; vec4 e; vec4 f; };
layout(set=0, binding=2) readonly buffer Sources { ThermalSource sources[]; };

// Domain ambient overrides as world AABBs, 32 B each.
//   a: xyz = bounds_min, w = ambient_kelvin
//   b: xyz = bounds_max, w = 1 when the box simulates its own air (gas lane)
//   a.w <= 0: the box does not override the ambient.
struct AmbientZone { vec4 a; vec4 b; };
layout(set=0, binding=3) readonly buffer Zones { AmbientZone zones[]; };

// Liquid contact heat since the last pass, normalized temperature delta per
// element (MaterialStateFieldSystem::depositThermalContactHeat). Only read when
// counts.w bit 1; otherwise the state buffer is bound here as a dummy.
layout(set=0, binding=4) readonly buffer HeatIn { float heat_in[]; };
// Surface water queued by the host budget, kg/m^2 per element (absorbed minus
// evaporated, MaterialStateFieldSystem::depositWaterContact/stepSurfaceWater).
// Only read when counts.w bit 2 is set.
layout(set=0, binding=5) readonly buffer WaterIn { float water_in[]; };

// Mirrors Physics::FalloffType / ForceField::calculateFalloff on the host. Kept
// in the same order so the UI's falloff combo means the same thing for a heat
// source as it does for a force.
float falloffAt(float dist, float inner, float outer, int mode) {
    if (dist <= inner) return 1.0;
    if (dist >= outer) return 0.0;
    float span = max(outer - inner, 1e-5);
    float t = (dist - inner) / span;
    if (mode == 0) return 1.0;                       // None
    if (mode == 1) return 1.0 - t;                   // Linear
    if (mode == 2) return 1.0 - t * t * (3.0 - 2.0 * t); // Smooth
    if (mode == 3) return sqrt(max(0.0, 1.0 - t * t));   // Sphere
    if (mode == 4) {                                 // InverseSquare
        float r = max(inner + t * span, 0.01);
        float ref = max(inner, 0.01);
        return (ref * ref) / (r * r);
    }
    if (mode == 5) return exp(-3.0 * t);             // Exponential
    return 1.0 - t;                                  // Custom -> linear
}

// Mirrors thermalSourceWeight() in MaterialStateField.h.
float sourceWeight(ThermalSource s, vec3 p) {
    if (s.b.w > 0.5) return 1.0;
    vec4 hp = vec4(p, 1.0);
    vec3 l = vec3(dot(s.c, hp), dot(s.d, hp), dot(s.e, hp));
    int shape = int(s.f.x + 0.5);
    float dist = length(l);
    if (shape == 1) {
        dist = max(abs(l.x), max(abs(l.y), abs(l.z)));
    } else if (shape == 2) {
        dist = max(length(l.xz), abs(l.y));
    } else if (shape == 3 && (l.y < 0.0 || l.y > s.b.x || length(l.xz) > l.y)) {
        return 0.0;
    }
    return falloffAt(dist, s.a.w, s.b.x, int(s.b.z + 0.5));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.counts.x)) return;

    vec3 p = centers[id].xyz;

    // 1. World ambient is the floor: it is defined everywhere, which is what
    //    makes an object outside every domain still a physical object.
    // ★ params2.w, NOT params.z: since Faz 2 the world ambient can follow the
    //   climate while the calibration zero (params.z) stays put.
    float ambient_k = pc.params2.w;

    // 2. Domain boxes, per ELEMENT (one object can straddle a domain wall).
    //    Last override wins. A box with a gas lane is its own air.
    bool in_gas = false;
    int zone_count = pc.counts.z;
    for (int i = 0; i < zone_count; ++i) {
        vec3 lo = zones[i].a.xyz;
        vec3 hi = zones[i].b.xyz;
        if (all(greaterThanEqual(p, lo)) && all(lessThanEqual(p, hi))) {
            if (zones[i].a.w > 0.0) ambient_k = zones[i].a.w;
            if (zones[i].b.w > 0.5) in_gas = true;
        }
    }

    // 3. Thermal fields stack ON TOP of ambient: two burners under one plate
    //    are hotter than one. A field is an authored heat SOURCE with its own
    //    rate (weighted by falloff when several overlap).
    float field_delta = 0.0;
    float field_rate = 0.0;
    float field_weight = 0.0;
    int source_count = pc.counts.y;
    for (int i = 0; i < source_count; ++i) {
        float w = sourceWeight(sources[i], p);
        if (w <= 0.0) continue;
        field_delta += sources[i].b.y * w;
        field_rate += max(sources[i].f.y, 0.0) * w;
        field_weight += w;
    }

    vec4 st = state[id * 2u];
    float ambient = (ambient_k - pc.params.z) * pc.params.w;
    float dt = pc.params.x;

    // ★ The room as an AIR FILM against the body, not a rate (2026-10-19).
    // The old `relax at cooling_rate` was capacity-free: a 0.1 m iron block
    // cooled like a sheet, and inside a gas domain it was a second, energy-free
    // air on top of the gas lane's. Now: h = air film (x world convection) +
    // linearized radiation, over body = rho c depth, exact exponential. Inside
    // a gas lane the air is sim_msf_gather's, so nothing here.
    float body = pc.params2.y;
    if (!in_gas && body > 0.0 && pc.params.w > 0.0) {
        const float SIGMA = 5.670374e-8;
        float kpu = 1.0 / pc.params.w;
        float tk = max(1.0, pc.params.z + st.x * kpu);
        float ak = max(1.0, ambient_k);
        float h = pc.params.y + pc.params2.z * SIGMA * (tk * tk + ak * ak) * (tk + ak);
        st.x = ambient + (st.x - ambient) * exp(-h / body * dt);
    }
    if (field_weight > 0.0) {
        float target = (ambient_k + field_delta - pc.params.z) * pc.params.w;
        float rate = field_rate / field_weight;
        st.x = target + (st.x - target) * exp(-rate * dt);
    }
    if ((pc.counts.w & 1) != 0) st.x += heat_in[id];

    // A cold zone may legitimately sit below the world ambient, so the floor is
    // the local ambient rather than 0 - clamping at 0 would silently make every
    // freezer as warm as the room.
    st.x = clamp(st.x, min(ambient, 0.0), pc.params2.x);

    // ── Surface water (2026-10-18) ───────────────────────────────────────────
    // ★ No drying here any more. Water is mass: the host budget took it from a
    // liquid parcel or put it into a gas inventory, paid its latent heat
    // (heat_in above) and recorded it in the ledger. This pass only adds what
    // was queued.
    if ((pc.counts.w & 2) != 0) st.w = max(0.0, st.w + water_in[id]);

    state[id * 2u] = st;
}
