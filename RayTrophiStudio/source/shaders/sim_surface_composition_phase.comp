#version 450
#extension GL_GOOGLE_include_directive : require
// Per-substance material composition. CPU twin: buildCompositionGrid
// (FluidLevelSet.cpp). Per sim cell: the two heaviest material slots among the
// raw parcels inside the kernel, renormalised over the kept pair, sharpened by
// the pair's minimum miscibility; unsupported cells hold the fallback at full
// weight. Values are material id + 1 (0 = built-in dielectric).
// The raw-position bins are wider than the CPU's cell bins, but the kernel
// test selects the same parcel set (every parcel within R is reached).
//
// table: [0..9] slot material id (slot 0 = fallback), [10..19] slot miscibility.
// reach.y = slot count.
layout(local_size_x = 256) in;
#include "sim_surface_common.glsl"
layout(set = 0, binding = 0) readonly buffer Positions { float positions[]; };
layout(set = 0, binding = 1) readonly buffer Slots { uint slots[]; };
layout(set = 0, binding = 2) readonly buffer Offsets { uint offsets[]; };
layout(set = 0, binding = 3) readonly buffer Items { uint items[]; };
layout(set = 0, binding = 4) readonly buffer Table { float table[]; };
layout(set = 0, binding = 5) buffer Composition { float composition[]; };
const int kSlots = 10;
void main() {
    uint c = gl_GlobalInvocationID.x;
    uint cells = uint(pc.grid.x) * uint(pc.grid.y) * uint(pc.grid.z);
    if (c >= cells) return;
    int i = int(c % uint(pc.grid.x));
    int j = int((c / uint(pc.grid.x)) % uint(pc.grid.y));
    int k = int(c / (uint(pc.grid.x) * uint(pc.grid.y)));
    vec3 pcell = pc.origin.xyz + (vec3(i, j, k) + vec3(0.5)) * pc.cell.x;
    ivec3 b = binCoordinate(pcell);
    ivec3 lo = max(b - ivec3(pc.reach.x), ivec3(0));
    ivec3 hi = min(b + ivec3(pc.reach.x), pc.bins.xyz - ivec3(1));
    float R2 = pc.cell.z;
    int slot_count = clamp(pc.reach.y, 1, kSlots);
    float acc[kSlots];
    for (int s = 0; s < kSlots; ++s) acc[s] = 0.0;
    float acc_total = 0.0;
    for (int kk = lo.z; kk <= hi.z; ++kk)
    for (int jj = lo.y; jj <= hi.y; ++jj)
    for (int ii = lo.x; ii <= hi.x; ++ii) {
        uint bi = binIndex(ivec3(ii, jj, kk));
        uint end = offsets[bi + 1u];
        for (uint a = offsets[bi]; a < end; ++a) {
            uint p = items[a];
            vec3 d = pcell - vec3(positions[p * 3u], positions[p * 3u + 1u],
                                  positions[p * 3u + 2u]);
            float d2 = dot(d, d);
            if (d2 >= R2) continue;
            float t = 1.0 - d2 / R2;
            float w = t * t * t;
            acc[min(int(slots[p]), slot_count - 1)] += w;
            acc_total += w;
        }
    }
    uint o = c * 3u;
    if (acc_total <= 1e-12) {
        float fallback = table[0] + 1.0;
        composition[o] = fallback;
        composition[o + 1u] = fallback;
        composition[o + 2u] = 0.0;
        return;
    }
    // Top two by weight, in the CPU's slot order and tie rule.
    int best = 0, second = 0;
    float best_w = -1.0, second_w = -1.0;
    for (int s = 0; s < slot_count; ++s) {
        if (acc[s] > best_w) {
            second = best; second_w = best_w;
            best = s; best_w = acc[s];
        } else if (acc[s] > second_w) {
            second = s; second_w = acc[s];
        }
    }
    if (second_w < 0.0) { second = best; second_w = 0.0; }
    float pair_total = max(best_w + second_w, 1e-12);
    float w = clamp(second_w / pair_total, 0.0, 1.0);
    float m = min(table[kSlots + best], table[kSlots + second]);
    if (m < 0.999) {
        float gain = 1.0 / max(m, 1.0 / 64.0);
        w = clamp(0.5 + (w - 0.5) * gain, 0.0, 1.0);
    }
    composition[o] = table[best] + 1.0;
    composition[o + 1u] = table[second] + 1.0;
    composition[o + 2u] = w;
}
