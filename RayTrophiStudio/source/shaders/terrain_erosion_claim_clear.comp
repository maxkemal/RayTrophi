#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC { int width; int height; } pc;
layout(set = 0, binding = 0) writeonly buffer Claim { float erosionClaim[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.width * pc.height)) return;
    erosionClaim[i] = 0.0;
}
