// sim_fluid_cg_residual_init.comp
// MGPCG: r0 = b = -div*h*h/dt at fluid cells (0 elsewhere); pressure reset 0.
// 1:1 port of the CUDA fluid_cg_residual_init_kernel, including the density
// relaxation term (mask carries the per-cell parcel count): the 27-cell mean
// count is pulled to particles_per_cell over density_relaxation_s seconds,
// two-sided (sim_fluid_density_relaxation.glsl, APICFluidSolver.cpp).
#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int   nx; int ny; int nz;
    int   boundary;
    float voxel_size;
    float dt;
    float sor_omega;
    int   iterations;
    int   parity;
    float density_relaxation_s;
    int   particles_per_cell;
    int   variational;
    int   gfm_active;
} pc;

layout(set = 0, binding = 0) readonly buffer Divergence { float divergence[]; };
layout(set = 0, binding = 1) readonly buffer Mask       { float fluid_mask[]; };
layout(set = 0, binding = 2) buffer Residual            { float r[]; };
layout(set = 0, binding = 3) buffer Pressure            { float pressure[]; };

float rtDensityMask(ivec3 c) {
    if (c.x < 0 || c.y < 0 || c.z < 0 || c.x >= pc.nx || c.y >= pc.ny || c.z >= pc.nz) {
        return pc.boundary == 0 ? 0.0 : -1.0;
    }
    return fluid_mask[c.x + c.y * pc.nx + c.z * pc.nx * pc.ny];
}
#include "sim_fluid_density_relaxation.glsl"

void main() {
    int id = int(gl_GlobalInvocationID.x);
    if (id >= pc.nx * pc.ny * pc.nz) return;
    pressure[id] = 0.0;
    if (fluid_mask[id] < 0.5) { r[id] = 0.0; return; }
    float h      = pc.voxel_size > 1e-6 ? pc.voxel_size : 1.0;
    float inv_dt = pc.dt > 1e-8 ? 1.0 / pc.dt : 0.0;
    float rhs = -divergence[id] * h * h * inv_dt;
    if (pc.density_relaxation_s > 0.0 && pc.particles_per_cell > 0) {
        int sz = pc.nx * pc.ny;
        ivec3 cell = ivec3(id % pc.nx, (id / pc.nx) % pc.ny, id / sz);
        float target = float(pc.particles_per_cell);
        float excess = rtDensityExcess(rtDensitySample(cell), target, target);
        rhs += excess / max(pc.density_relaxation_s, pc.dt) * h * h * inv_dt;
    }
    r[id] = rhs;
}
