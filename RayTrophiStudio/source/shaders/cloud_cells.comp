#version 460
// Storm cell map (docs/dev/ATMOSPHERE_STORMS.md §3).
//
// Paints the live storm cells (CPU: atmosphere::evaluateStormCells, packed
// by Backend::makeCloudCellsGPU) into a map around the storm domain. Every
// cloud density sample then reads it instead of looping over the cells
// (cloud_common.glsl: cloudStormCellAt / cloudStormFlowAt / cloudStormColumnAt).
//
// The image is 256 x 768: three 256^2 fields stacked (one binding, no array
// view). Rows 0..255, the cell fields:
//   R  cover floor          (the layer is at least this covered)
//   G  tower                (genus / development floor: towering)
//   B  rain potential       (convective core on the forward flank, plus the
//                            wide light rain of a dissipating cell)
//   A  cover MAJORANT       the envelope at (distance - dilation): it falls
//                            monotonically with the distance, so it bounds R
//                            anywhere within `dilation` of the texel.
// Rows 256..511, the cell structure (§3.1):
//   RG swirl              horizontal displacement (m) of the SHAPE lookup:
//                          the cell's rotation winds its noise into spiral
//                          bands (never the coverage, so the majorant holds)
//   B  top fraction       local cloud top as a share of the storm column:
//                          rising turrets reach it, the body between is lower
//   A  updraft            turret core weight: crisp, less eroded towers
// Rows 512..767, the storm column (ATMOSPHERE_CELL_CLOUDS.md §1):
//   R  anvil cover        mature / dissipating cells spread an elliptic sheet
//                          downwind at the tropopause
//   G  wall cloud         lowered base under the main updraft (inflow side)
//   B  reserved           gust front (Faz 5b)
//   A  anvil MAJORANT     R dilated like the cell majorant: the elliptic
//                          distance is Lipschitz with 1 / min(semi-axis), so
//                          moving `dilation` metres lowers it by at most
//                          dilation / min(semi-axis)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct CloudCellG {
    vec4 a;   // world x, z, radius m, cover floor
    vec4 b;   // tower, convective rain, stratiform rain, lightning weight
    vec4 c;   // id (0..65535), age s, rotation (signed 0..1), turret detail 0..1
    vec4 d;   // life 0..1, peak, anvil spread 0..1, wall cloud 0..1
};

layout(set = 0, binding = 0, std430) readonly buffer CloudCells {
    vec4 header;   // count, map centre x, z, map size m
    vec4 wind;     // wind direction x, z, majorant dilation m, reserved
    CloudCellG cells[24];
} cloudCells;

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D cellMap;

const int kTurrets = 5;

float cellCover(float d) {   // d = distance / radius
    return 1.0 - smoothstep(0.55, 1.15, d);
}

uint cellHash(uint v) {
    v ^= v >> 16u;
    v *= 0x7feb352du;
    v ^= v >> 15u;
    v *= 0x846ca68bu;
    return v ^ (v >> 16u);
}

float cellRandom(inout uint s) {
    s = cellHash(s + 0x9e3779b9u);
    return float(s & 0x00ffffffu) / 16777216.0;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 full = imageSize(cellMap);
    ivec2 size = ivec2(full.x, full.x);
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 q = cloudCells.header.yz +
             ((vec2(px) + 0.5) / vec2(size) - 0.5) * cloudCells.header.w;
    vec2 windDir = cloudCells.wind.xy;
    float dilation = cloudCells.wind.z;
    vec4 o = vec4(0.0);
    vec4 flow = vec4(0.0);
    vec4 column = vec4(0.0);
    vec2 along = dot(windDir, windDir) > 1e-6 ? windDir : vec2(1.0, 0.0);
    vec2 across = vec2(-along.y, along.x);
    int count = min(int(cloudCells.header.x + 0.5), 24);
    for (int i = 0; i < count; ++i) {
        CloudCellG c = cloudCells.cells[i];
        float r = max(c.a.z, 1.0);
        float dist = length(q - c.a.xy);
        float d = dist / r;
        float envelope = cellCover(d);
        o.a = max(o.a, c.a.w * cellCover(max(dist - dilation, 0.0) / r));
        o.g = max(o.g, c.b.x * (1.0 - smoothstep(0.25, 0.9, d)));
        // Heaviest rain on the forward flank: the core sits 0.3 r downwind.
        float df = length(q - (c.a.xy + windDir * 0.3 * r)) / r;
        float rain = max(c.b.y * (1.0 - smoothstep(0.0, 0.55, df)),
                         c.b.z * (1.0 - smoothstep(0.3, 1.2, d)));
        o.b = max(o.b, rain);

        // Anvil: from early maturity, an ellipse pushed and stretched
        // downwind as the cell ages; gone at the end of the life.
        float life = c.d.x;
        float anvil = c.d.y * c.d.z * smoothstep(0.3, 0.5, life) * (1.0 - smoothstep(0.92, 1.0, life));
        if (anvil > 0.0) {
            float age01 = smoothstep(0.3, 0.9, life);
            float spread = mix(1.6, 3.2, age01);
            vec2 centre = c.a.xy + along * r * mix(0.3, 1.4, age01) * c.d.z;
            float ax = r * spread * mix(1.0, 1.4, c.d.z);
            float ay = r * spread * 0.75;
            vec2 rel = q - centre;
            float e = length(vec2(dot(rel, along) / ax, dot(rel, across) / ay));
            float eDil = max(e - dilation / min(ax, ay), 0.0);
            // Anchored over the core: the anvil grows OUT of the tower top.
            float core = 1.0 - smoothstep(0.3, 0.9, d);
            float coreDil = 1.0 - smoothstep(0.3, 0.9, max(dist - dilation, 0.0) / r);
            column.r = max(column.r, anvil * max(1.0 - smoothstep(0.3, 1.0, e), core));
            column.a = max(column.a, anvil * max(1.0 - smoothstep(0.3, 1.0, eDil), coreDil));
        }
        // Wall cloud: under the main updraft, a little to the inflow side.
        float wallD = length(q - (c.a.xy - windDir * 0.2 * r)) / (0.3 * r);
        column.g = max(column.g, c.b.x * c.d.w * (1.0 - smoothstep(0.4, 1.0, wallD)));

        if (d >= 1.3) {
            o.r = max(o.r, c.a.w * envelope);
            continue;
        }

        // Updraft turrets: a mature cell is not one uniform column but a few
        // updrafts, each born, rising to its own height and collapsing on its
        // own cycle (~15 min), new ones replacing them on the inflow side.
        // Pure function of (id, age): the same frame twice paints the same map.
        float tower = c.b.x;
        float detail = c.c.w;
        float age = max(c.c.y, 0.0);
        float spin = c.c.z;
        uint id = uint(c.c.x + 0.5);
        // The ring of turrets turns with the cell (bounded: positions only).
        float spinAngle = spin * age * 0.0015;
        float top = 0.0, lift = 0.0, mass = 0.0;
        for (int t = 0; t < kTurrets; ++t) {
            uint s0 = cellHash(id * 7919u + uint(t) * 104729u + 17u);
            float period = 900.0 * (0.75 + 0.5 * cellRandom(s0));
            float cycle = age / period + float(t) / float(kTurrets) + cellRandom(s0);
            float generation = floor(cycle);
            float u = cycle - generation;
            uint s = cellHash(s0 ^ (uint(generation) * 2654435761u));
            float angle = cellRandom(s) * 6.28318530718 + spinAngle;
            float ring = r * (0.06 + 0.42 * sqrt(cellRandom(s)));
            vec2 centre = c.a.xy + vec2(cos(angle), sin(angle)) * ring - windDir * 0.12 * r;
            // A turret is a DOME (sqrt profile), kilometres wide: a linear
            // fall-off across a narrow turret drew needles and cones.
            float turretRadius = r * (0.3 + 0.18 * cellRandom(s));
            float height = mix(0.7, 1.0, cellRandom(s));
            float x = length(q - centre) / turretRadius;
            if (x >= 1.0) continue;
            float k = sqrt(1.0 - x * x);
            float rise = smoothstep(0.0, 0.35, u) * (1.0 - 0.45 * smoothstep(0.6, 1.0, u));
            float strength = smoothstep(0.0, 0.12, u) * (1.0 - smoothstep(0.65, 1.0, u));
            top = max(top, height * rise * k);
            lift = max(lift, strength * smoothstep(0.0, 0.6, k));
            mass = max(mass, smoothstep(0.0, 0.4, k) * mix(0.5, 1.0, rise));
        }
        // The body between the turrets: a lower, broad dome.
        float body = sqrt(max(1.0 - d * d / 0.9, 0.0));
        top = max(top, 0.55 * body);
        // Without turrets (detail 0) one dome over the whole cell; never a
        // flat plateau out to the rim (that drew a wide skirt with a wall).
        float cellTop = tower * mix(body, top, detail);
        // Cover dips between turrets (<= envelope: A still bounds R).
        o.r = max(o.r, c.a.w * envelope * mix(1.0, mix(0.7, 1.0, max(mass, 0.6 * body)), detail));

        // Rotation (mesocyclone): rotate the shape lookup about the cell
        // centre by an angle that peaks in the core and fades outward, so the
        // noise winds into spiral bands. It grows and relaxes with the tower.
        vec2 rel = q - c.a.xy;
        float theta = spin * tower * 1.4 * (1.0 - smoothstep(0.15, 1.2, d));
        float cs = cos(theta), sn = sin(theta);
        flow.xy += vec2(cs * rel.x - sn * rel.y, sn * rel.x + cs * rel.y) - rel;
        flow.z = max(flow.z, cellTop * step(0.0, 1.2 - d));
        flow.w = max(flow.w, lift * tower * detail);
    }
    imageStore(cellMap, px, o);
    imageStore(cellMap, px + ivec2(0, size.y), flow);
    imageStore(cellMap, px + ivec2(0, 2 * size.y), column);
}
