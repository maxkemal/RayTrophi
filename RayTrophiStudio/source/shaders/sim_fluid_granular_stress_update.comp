#version 450
layout(local_size_x = 256) in;

layout(set=0,binding=0) readonly buffer Affine { float c_data[]; };
layout(set=0,binding=1) buffer StressDiag { float sd[]; };
layout(set=0,binding=2) buffer StressShear { float ss[]; };
layout(set=0,binding=3) buffer PlasticVolume { float pv[]; };
layout(set=0,binding=4) buffer StateFlags { uint flags[]; };
layout(set=0,binding=5) buffer YieldValues { float yield_values[]; };
layout(set=0,binding=6) buffer PlasticIncrements { float plastic_increments[]; };
layout(set=0,binding=7) buffer Damage { float damage[]; };
layout(set=0,binding=8) buffer HardeningState { float hardening_state[]; };
layout(set=0,binding=9) buffer FractureHistory { float fracture_history[]; };
layout(set=0,binding=10) buffer DeformationCol0 { float f0[]; };
layout(set=0,binding=11) buffer DeformationCol1 { float f1[]; };
layout(set=0,binding=12) buffer DeformationCol2 { float f2[]; };

layout(push_constant) uniform PC {
    uint count;
    float dt;
    float young_modulus;
    float poisson_ratio;
    float friction_tangent;
    float cohesion;
    float dilatancy_tangent;
    float tensile_cutoff;
    float fracture_strain;
    float damage_rate;
    float healing_rate;
    uint rebonding;
    float hardening_coefficient;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

// Rankine damage is driven by the largest principal (tensile) stress, not by
// hydrostatic mean stress and not by ordinary frictional plastic flow. Analytic
// eigenvalue for a real symmetric 3x3 tensor (stable diagonal fast path).
float maxPrincipalStress(mat3 A) {
    float off2=A[0][1]*A[0][1]+A[0][2]*A[0][2]+A[1][2]*A[1][2];
    if(off2<1.0e-16)
        return max(A[0][0],max(A[1][1],A[2][2]));
    float center=(A[0][0]+A[1][1]+A[2][2])/3.0;
    float spread2=(A[0][0]-center)*(A[0][0]-center)
                 +(A[1][1]-center)*(A[1][1]-center)
                 +(A[2][2]-center)*(A[2][2]-center)+2.0*off2;
    float radius=sqrt(max(spread2/6.0,1.0e-20));
    mat3 B=(A-center*mat3(1.0))/radius;
    float r=clamp(determinant(B)*0.5,-1.0,1.0);
    float phi=acos(r)/3.0;
    return center+2.0*radius*cos(phi);
}

vec3 principalDirection(mat3 A,float eigenvalue) {
    mat3 M=A-eigenvalue*mat3(1.0);
    vec3 row0=vec3(M[0][0],M[1][0],M[2][0]);
    vec3 row1=vec3(M[0][1],M[1][1],M[2][1]);
    vec3 row2=vec3(M[0][2],M[1][2],M[2][2]);
    vec3 c01=cross(row0,row1),c02=cross(row0,row2),c12=cross(row1,row2);
    float n01=dot(c01,c01),n02=dot(c02,c02),n12=dot(c12,c12);
    vec3 v=(n01>=n02&&n01>=n12)?c01:((n02>=n12)?c02:c12);
    float n2=dot(v,v);
    if(n2<1.0e-16){
        v=(A[0][0]>=A[1][1]&&A[0][0]>=A[2][2])?vec3(1,0,0):
          ((A[1][1]>=A[2][2])?vec3(0,1,0):vec3(0,0,1));
        n2=1.0;
    }
    return v*inversesqrt(n2);
}

bool finiteMat3(mat3 A){
    return !any(isnan(A[0]))&&!any(isnan(A[1]))&&!any(isnan(A[2]))&&
           !any(isinf(A[0]))&&!any(isinf(A[1]))&&!any(isinf(A[2]));
}

// Rotation from the deformation gradient. Newton polar iteration makes the
// elastic predictor objective under large rigid rotations, unlike directly
// integrating Cauchy stress from sym(C).
mat3 polarRotation(mat3 F){
    mat3 R=F;
    for(int iteration=0;iteration<4;++iteration){
        float determinant_r=determinant(R);
        if(abs(determinant_r)<1.0e-8||isnan(determinant_r)||isinf(determinant_r))
            return mat3(1.0);
        R=0.5*(R+transpose(inverse(R)));
    }
    return R;
}

void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    uint a=i*9u;
    mat3 C=mat3(vec3(c_data[a],c_data[a+1],c_data[a+2]),
                vec3(c_data[a+3],c_data[a+4],c_data[a+5]),
                vec3(c_data[a+6],c_data[a+7],c_data[a+8]));
    float nu=clamp(pc.poisson_ratio,-0.49,0.49);
    float mu=pc.young_modulus/(2.0*(1.0+nu));
    float lambda=pc.young_modulus*nu/((1.0+nu)*(1.0-2.0*nu));
    mat3 F=mat3(vec3(f0[i*3],f0[i*3+1],f0[i*3+2]),
                vec3(f1[i*3],f1[i*3+1],f1[i*3+2]),
                vec3(f2[i*3],f2[i*3+1],f2[i*3+2]));
    mat3 F_trial=(mat3(1.0)+pc.dt*C)*F;
    bool bad_kinematics=!finiteMat3(F_trial)||determinant(F_trial)<=1.0e-6;
    if(bad_kinematics)
        F_trial=(finiteMat3(F)&&determinant(F)>1.0e-6)?F:mat3(1.0);
    mat3 R=polarRotation(F_trial);
    mat3 stretch=transpose(R)*F_trial;
    mat3 elastic_strain=0.5*(stretch+transpose(stretch))-mat3(1.0);
    mat3 local_stress=2.0*mu*elastic_strain+
        lambda*(elastic_strain[0][0]+elastic_strain[1][1]+elastic_strain[2][2])*mat3(1.0);
    mat3 S=R*local_stress*transpose(R);
    float mean=(S[0][0]+S[1][1]+S[2][2])/3.0;
    float pressure=-mean;
    mat3 dev=S-mean*mat3(1.0);
    float ssq=dev[0][0]*dev[0][0]+dev[1][1]*dev[1][1]+dev[2][2]*dev[2][2]
             +2.0*(dev[0][1]*dev[0][1]+dev[0][2]*dev[0][2]+dev[1][2]*dev[1][2]);
    float q=sqrt(max(1.5*ssq,0.0));
    float d=clamp(damage[i],0.0,1.0);
    bool has_bonds=pc.cohesion>0.0||pc.tensile_cutoff>0.0;
    float accumulated_plastic=max(hardening_state[i],0.0);
    float bond_opening=max(fracture_history[i],0.0);
    float hardening_scale=exp(clamp(pc.hardening_coefficient*accumulated_plastic,0.0,4.0));
    float effective_cohesion=(1.0-d)*max(pc.cohesion,0.0);
    float strength=max((effective_cohesion+max(pressure,0.0)*pc.friction_tangent)*hardening_scale,0.0);
    float tensile=max(maxPrincipalStress(S),0.0);
    float effective_tensile=(1.0-d)*max(pc.tensile_cutoff,0.0);
    bool tensile_failure=tensile>effective_tensile+1.0e-6;
    bool detached=false;
    bool yielded=q>strength+1e-6;
    float trial_yield_overstress=max(q-strength,0.0);
    float plastic_increment=0.0;
    if(yielded){
        float scale=strength/max(q,1e-6);
        S=mean*mat3(1.0)+scale*dev;
        float dp=(q-strength)/max(pc.young_modulus,1e-6);
        plastic_increment=dp;
        accumulated_plastic+=dp;
        pv[i]=clamp(pv[i]*exp(-pc.dilatancy_tangent*dp),0.25,4.0);
    }
    if(tensile_failure){
        if(has_bonds){
            float tensile_overstress_strain=max(
                tensile-effective_tensile,0.0)/max(pc.young_modulus,1.0e-6);
            // Rankine history is a maximum equivalent opening, not a time
            // integral. Adding the same elastic overstress every solver
            // substep makes the result depend on substep count and eventually
            // fractures a body under harmless APIC/free-surface noise.
            bond_opening=max(bond_opening,tensile_overstress_strain);
        }
        else
            detached=true;
    }
    if(has_bonds){
        float damage_driver=max(bond_opening-pc.fracture_strain,0.0);
        float target_damage=1.0-exp(-pc.damage_rate*damage_driver);
        d=max(d,target_damage);
    }
    float undamaged_strength=max((max(pc.cohesion,0.0)+max(pressure,0.0)*pc.friction_tangent)*hardening_scale,0.0);
    if(pc.rebonding!=0u && pressure>max(pc.cohesion,0.1) && q<=undamaged_strength+1.0e-6){
        d-=pc.healing_rate*pc.dt;
        if(pc.damage_rate>1.0e-6){
            float compatible_history=pc.fracture_strain-
                log(max(1.0-clamp(d,0.0,0.999999),1.0e-6))/pc.damage_rate;
            bond_opening=min(bond_opening,max(compatible_history,0.0));
        }
    }
    d=clamp(d,0.0,1.0);
    effective_tensile=(1.0-d)*max(pc.tensile_cutoff,0.0);
    float max_principal=maxPrincipalStress(S);
    if(max_principal>effective_tensile){
        vec3 direction=principalDirection(S,max_principal);
        S-=(max_principal-effective_tensile)*outerProduct(direction,direction);
    }
    mean=(S[0][0]+S[1][1]+S[2][2])/3.0;
    pressure=-mean;
    dev=S-mean*mat3(1.0);
    ssq=dev[0][0]*dev[0][0]+dev[1][1]*dev[1][1]+dev[2][2]*dev[2][2]
       +2.0*(dev[0][1]*dev[0][1]+dev[0][2]*dev[0][2]+dev[1][2]*dev[1][2]);
    q=sqrt(max(1.5*ssq,0.0));
    effective_cohesion=(1.0-d)*max(pc.cohesion,0.0);
    strength=max((effective_cohesion+max(pressure,0.0)*pc.friction_tangent)*hardening_scale,0.0);
    if(q>strength+1.0e-6)
        S=mean*mat3(1.0)+(strength/max(q,1.0e-6))*dev;
    detached=detached||(has_bonds&&d>=0.999);
    // Return the projected stress to a small elastic stretch and keep the
    // rotation. Particle positions carry the large plastic motion; F stores
    // only the recoverable part, preventing stress drift over many rotations.
    local_stress=transpose(R)*S*R;
    float local_mean=(local_stress[0][0]+local_stress[1][1]+local_stress[2][2])/3.0;
    mat3 local_dev=local_stress-local_mean*mat3(1.0);
    float bulk=max(lambda+2.0*mu/3.0,1.0e-6);
    mat3 projected_strain=local_dev/max(2.0*mu,1.0e-6)+
        (local_mean/(3.0*bulk))*mat3(1.0);
    mat3 F_projected=R*(mat3(1.0)+projected_strain);
    bool bad=bad_kinematics||!finiteMat3(S)||!finiteMat3(F_projected)||
             determinant(F_projected)<=1.0e-6||
             isnan(d)||isinf(d)||isnan(accumulated_plastic)||isinf(accumulated_plastic)||
             isnan(bond_opening)||isinf(bond_opening);
    if(bad){S=mat3(0.0);F_projected=mat3(1.0);d=1.0;accumulated_plastic=0.0;bond_opening=0.0;plastic_increment=0.0;detached=true;yielded=false;}
    sd[i*3]=S[0][0];sd[i*3+1]=S[1][1];sd[i*3+2]=S[2][2];
    ss[i*3]=S[0][1];ss[i*3+1]=S[0][2];ss[i*3+2]=S[1][2];
    yield_values[i]=bad?0.0:trial_yield_overstress;
    plastic_increments[i]=plastic_increment;
    damage[i]=d;
    hardening_state[i]=clamp(accumulated_plastic,0.0,1000.0);
    fracture_history[i]=clamp(bond_opening,0.0,1000.0);
    f0[i*3]=F_projected[0][0];f0[i*3+1]=F_projected[0][1];f0[i*3+2]=F_projected[0][2];
    f1[i*3]=F_projected[1][0];f1[i*3+1]=F_projected[1][1];f1[i*3+2]=F_projected[1][2];
    f2[i*3]=F_projected[2][0];f2[i*3+1]=F_projected[2][1];f2[i*3+2]=F_projected[2][2];
    flags[i]=(yielded?1u:0u)|(detached?2u:0u)|(bad?4u:0u);
}
