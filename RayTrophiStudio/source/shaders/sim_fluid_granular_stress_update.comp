#version 450
layout(local_size_x = 256) in;

layout(set=0,binding=0) readonly buffer Affine { float c_data[]; };
layout(set=0,binding=1) buffer StressDiag { float sd[]; };
layout(set=0,binding=2) buffer StressShear { float ss[]; };
layout(set=0,binding=3) buffer PlasticVolume { float pv[]; };
layout(set=0,binding=4) buffer StateFlags { uint flags[]; };
layout(set=0,binding=5) buffer YieldValues { float yield_values[]; };
layout(set=0,binding=6) buffer PlasticIncrements { float plastic_increments[]; };
layout(set=0,binding=7) buffer Damage { float damage[]; };
layout(set=0,binding=8) buffer HardeningState { float hardening_state[]; };
layout(set=0,binding=9) buffer FractureHistory { float fracture_history[]; };
layout(set=0,binding=10) buffer DeformationCol0 { float f0[]; };
layout(set=0,binding=11) buffer DeformationCol1 { float f1[]; };
layout(set=0,binding=12) buffer DeformationCol2 { float f2[]; };
// Thermal/burn softening, 1 = cold and intact. Derived on the host from the
// particle's temperature and remaining mass; the kernel needs no thermal model.
layout(set=0,binding=13) readonly buffer Softening { float softening[]; };
// Cohesion/tensile multiplier. Deliberately a SEPARATE array rather than a
// curve evaluated here: bond strength does NOT track stiffness (a thermoplastic
// goes tacky before it flows), and a second copy of that curve in GLSL would
// drift from the host the first time either side was tuned. The host derives
// both scalars once per frame; this shader only multiplies.
layout(set=0,binding=14) readonly buffer BondScale { float bond_scale_buf[]; };

layout(push_constant) uniform PC {
    uint count;
    float dt;
    float young_modulus;
    float poisson_ratio;
    float friction_tangent;
    float cohesion;
    float dilatancy_tangent;
    float tensile_cutoff;
    float fracture_strain;
    float damage_rate;
    float healing_rate;
    uint rebonding;
    float hardening_coefficient;
    float max_stored_strain;
    uint pad1;
    uint pad2;
} pc;

// Rankine damage is driven by the largest principal (tensile) stress, not by
// hydrostatic mean stress and not by ordinary frictional plastic flow. Analytic
// eigenvalue for a real symmetric 3x3 tensor (stable diagonal fast path).
float maxPrincipalStress(mat3 A) {
    float off2=A[0][1]*A[0][1]+A[0][2]*A[0][2]+A[1][2]*A[1][2];
    if(off2<1.0e-16)
        return max(A[0][0],max(A[1][1],A[2][2]));
    float center=(A[0][0]+A[1][1]+A[2][2])/3.0;
    float spread2=(A[0][0]-center)*(A[0][0]-center)
                 +(A[1][1]-center)*(A[1][1]-center)
                 +(A[2][2]-center)*(A[2][2]-center)+2.0*off2;
    float radius=sqrt(max(spread2/6.0,1.0e-20));
    mat3 B=(A-center*mat3(1.0))/radius;
    float r=clamp(determinant(B)*0.5,-1.0,1.0);
    float phi=acos(r)/3.0;
    return center+2.0*radius*cos(phi);
}

vec3 principalDirection(mat3 A,float eigenvalue) {
    mat3 M=A-eigenvalue*mat3(1.0);
    vec3 row0=vec3(M[0][0],M[1][0],M[2][0]);
    vec3 row1=vec3(M[0][1],M[1][1],M[2][1]);
    vec3 row2=vec3(M[0][2],M[1][2],M[2][2]);
    vec3 c01=cross(row0,row1),c02=cross(row0,row2),c12=cross(row1,row2);
    float n01=dot(c01,c01),n02=dot(c02,c02),n12=dot(c12,c12);
    vec3 v=(n01>=n02&&n01>=n12)?c01:((n02>=n12)?c02:c12);
    float n2=dot(v,v);
    if(n2<1.0e-16){
        v=(A[0][0]>=A[1][1]&&A[0][0]>=A[2][2])?vec3(1,0,0):
          ((A[1][1]>=A[2][2])?vec3(0,1,0):vec3(0,0,1));
        n2=1.0;
    }
    return v*inversesqrt(n2);
}

bool finiteMat3(mat3 A){
    return !any(isnan(A[0]))&&!any(isnan(A[1]))&&!any(isnan(A[2]))&&
           !any(isinf(A[0]))&&!any(isinf(A[1]))&&!any(isinf(A[2]));
}

// Rotation from the deformation gradient. Newton polar iteration makes the
// elastic predictor objective under large rigid rotations, unlike directly
// integrating Cauchy stress from sym(C).
mat3 polarRotation(mat3 F){
    mat3 R=F;
    for(int iteration=0;iteration<4;++iteration){
        float determinant_r=determinant(R);
        if(abs(determinant_r)<1.0e-8||isnan(determinant_r)||isinf(determinant_r))
            return mat3(1.0);
        R=0.5*(R+transpose(inverse(R)));
    }
    return R;
}

void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    uint a=i*9u;
    mat3 C=mat3(vec3(c_data[a],c_data[a+1],c_data[a+2]),
                vec3(c_data[a+3],c_data[a+4],c_data[a+5]),
                vec3(c_data[a+6],c_data[a+7],c_data[a+8]));
    float nu=clamp(pc.poisson_ratio,-0.49,0.49);
    // ★★ BOND STRENGTH FALLS QUADRATICALLY, STIFFNESS LINEARLY, and that
    // asymmetry is what makes a melt read as a melt: the block stops holding
    // its shape before it goes soft. Falling together gives a body that sags
    // while still refusing to tear, which reads as rubber.
    // ★ tensile_cutoff follows cohesion — they are the same bonds.
    // The push-constant values are the AUTHORED material and are never
    // written back; only these locals are scaled.
    float soft=clamp(softening[i],0.0,1.0);
    if(isnan(soft)||isinf(soft))soft=1.0;
    float bond_scale=bond_scale_buf[i];
    if(isnan(bond_scale)||isinf(bond_scale))bond_scale=1.0;
    bond_scale=max(bond_scale,0.0);
    float young=max(pc.young_modulus*soft,1.0);
    float cohesion=max(pc.cohesion,0.0)*bond_scale;
    float tensile_cutoff=max(pc.tensile_cutoff,0.0)*bond_scale;
    float mu=young/(2.0*(1.0+nu));
    float lambda=young*nu/((1.0+nu)*(1.0-2.0*nu));
    mat3 F=mat3(vec3(f0[i*3],f0[i*3+1],f0[i*3+2]),
                vec3(f1[i*3],f1[i*3+1],f1[i*3+2]),
                vec3(f2[i*3],f2[i*3+1],f2[i*3+2]));
    // ★★★ (I + dt*C) IS A FIRST-ORDER EXPONENTIAL MAP AND IT HAS ITS OWN CFL,
    // one that contains no Young modulus. The host sizes the subcycle from the
    // PREVIOUS frame's C (elasticStepInfo/measureLoad), which cannot see a
    // gradient spike forming inside this frame and is capped by
    // granular_max_solver_substeps besides. Clamping the increment here is what
    // makes the step finite regardless.
    //
    // Frobenius bounds the spectral norm, so ||dC|| <= 0.25 keeps every
    // eigenvalue of I + dC at modulus >= 0.75 and det(I + dC) >= 0.42: the
    // trial gradient cannot invert or collapse in a single step no matter what
    // C arrives. Past this bound the increment is not physics being discarded,
    // it is integration error being manufactured -- but a clamped step is still
    // an UNDER-RESOLVED step, so it raises bit 16 rather than passing silently.
    mat3 dC=pc.dt*C;
    float strain_increment=sqrt(dot(dC[0],dC[0])+dot(dC[1],dC[1])+dot(dC[2],dC[2]));
    bool strain_limited=false;
    if(!(strain_increment<1.0e30)){dC=mat3(0.0);strain_limited=true;}
    else if(strain_increment>0.25){dC*=0.25/strain_increment;strain_limited=true;}
    mat3 F_trial=(mat3(1.0)+dC)*F;
    // Only a NON-FINITE gradient is unrecoverable now. The determinant floor
    // that used to live here fired constantly on soft material and dumped the
    // particle's whole stress in one step; the cause was downstream (see the
    // stored-strain cap near F_projected) and is fixed there instead of being
    // absorbed by a reset here.
    bool bad_kinematics=!finiteMat3(F_trial);
    if(bad_kinematics)
        F_trial=finiteMat3(F)?F:mat3(1.0);
    mat3 R=polarRotation(F_trial);
    mat3 stretch=transpose(R)*F_trial;
    mat3 elastic_strain=0.5*(stretch+transpose(stretch))-mat3(1.0);
    mat3 local_stress=2.0*mu*elastic_strain+
        lambda*(elastic_strain[0][0]+elastic_strain[1][1]+elastic_strain[2][2])*mat3(1.0);
    mat3 S=R*local_stress*transpose(R);
    float mean=(S[0][0]+S[1][1]+S[2][2])/3.0;
    float pressure=-mean;
    mat3 dev=S-mean*mat3(1.0);
    float ssq=dev[0][0]*dev[0][0]+dev[1][1]*dev[1][1]+dev[2][2]*dev[2][2]
             +2.0*(dev[0][1]*dev[0][1]+dev[0][2]*dev[0][2]+dev[1][2]*dev[1][2]);
    float q=sqrt(max(1.5*ssq,0.0));
    float d=clamp(damage[i],0.0,1.0);
    bool has_bonds=cohesion>0.0||tensile_cutoff>0.0;
    float accumulated_plastic=max(hardening_state[i],0.0);
    float bond_opening=max(fracture_history[i],0.0);
    float hardening_scale=exp(clamp(pc.hardening_coefficient*accumulated_plastic,0.0,4.0));
    float effective_cohesion=(1.0-d)*cohesion;
    float strength=max((effective_cohesion+max(pressure,0.0)*pc.friction_tangent)*hardening_scale,0.0);
    float tensile=max(maxPrincipalStress(S),0.0);
    float effective_tensile=(1.0-d)*tensile_cutoff;
    bool tensile_failure=tensile>effective_tensile+1.0e-6;
    bool detached=false;
    bool yielded=q>strength+1e-6;
    float trial_yield_overstress=max(q-strength,0.0);
    float plastic_increment=0.0;
    if(yielded){
        float scale=strength/max(q,1e-6);
        S=mean*mat3(1.0)+scale*dev;
        float dp=(q-strength)/young;
        plastic_increment=dp;
        accumulated_plastic+=dp;
        pv[i]=clamp(pv[i]*exp(-pc.dilatancy_tangent*dp),0.25,4.0);
    }
    if(tensile_failure){
        if(has_bonds){
            float tensile_overstress_strain=max(
                tensile-effective_tensile,0.0)/young;
            // Rankine history is a maximum equivalent opening, not a time
            // integral. Adding the same elastic overstress every solver
            // substep makes the result depend on substep count and eventually
            // fractures a body under harmless APIC/free-surface noise.
            bond_opening=max(bond_opening,tensile_overstress_strain);
        }
        else
            detached=true;
    }
    if(has_bonds){
        float damage_driver=max(bond_opening-pc.fracture_strain,0.0);
        float target_damage=1.0-exp(-pc.damage_rate*damage_driver);
        d=max(d,target_damage);
    }
    float undamaged_strength=max((cohesion+max(pressure,0.0)*pc.friction_tangent)*hardening_scale,0.0);
    if(pc.rebonding!=0u && pressure>max(cohesion,0.1) && q<=undamaged_strength+1.0e-6){
        d-=pc.healing_rate*pc.dt;
        if(pc.damage_rate>1.0e-6){
            float compatible_history=pc.fracture_strain-
                log(max(1.0-clamp(d,0.0,0.999999),1.0e-6))/pc.damage_rate;
            bond_opening=min(bond_opening,max(compatible_history,0.0));
        }
    }
    d=clamp(d,0.0,1.0);
    effective_tensile=(1.0-d)*tensile_cutoff;
    float max_principal=maxPrincipalStress(S);
    if(max_principal>effective_tensile){
        vec3 direction=principalDirection(S,max_principal);
        S-=(max_principal-effective_tensile)*outerProduct(direction,direction);
    }
    mean=(S[0][0]+S[1][1]+S[2][2])/3.0;
    pressure=-mean;
    dev=S-mean*mat3(1.0);
    ssq=dev[0][0]*dev[0][0]+dev[1][1]*dev[1][1]+dev[2][2]*dev[2][2]
       +2.0*(dev[0][1]*dev[0][1]+dev[0][2]*dev[0][2]+dev[1][2]*dev[1][2]);
    q=sqrt(max(1.5*ssq,0.0));
    effective_cohesion=(1.0-d)*cohesion;
    strength=max((effective_cohesion+max(pressure,0.0)*pc.friction_tangent)*hardening_scale,0.0);
    if(q>strength+1.0e-6)
        S=mean*mat3(1.0)+(strength/max(q,1.0e-6))*dev;
    detached=detached||(has_bonds&&d>=0.999);
    // Return the projected stress to a small elastic stretch and keep the
    // rotation. Particle positions carry the large plastic motion; F stores
    // only the recoverable part, preventing stress drift over many rotations.
    local_stress=transpose(R)*S*R;
    float local_mean=(local_stress[0][0]+local_stress[1][1]+local_stress[2][2])/3.0;
    mat3 local_dev=local_stress-local_mean*mat3(1.0);
    float bulk=max(lambda+2.0*mu/3.0,1.0e-6);
    mat3 projected_strain=local_dev/max(2.0*mu,1.0e-6)+
        (local_mean/(3.0*bulk))*mat3(1.0);
    // ★★★★★ THIS IS WHERE THE "POP" WAS BORN, AND IT IS A PLASTICITY QUESTION,
    // NOT A STABILITY ONE. The strain a given stress implies is stress/E, so as
    // E falls the elastic strain this back-projection asks the gradient to store
    // grows without bound. Measured: a 1 kPa pile carries 26 kPa of its own
    // overburden, K = 667 Pa, so the volumetric strain wanted is about -39.
    // I + eps is then wildly negative-determinant, the NEXT step's kinematics
    // check called it invalid, and the particle's entire stress was dumped to
    // zero in a single step. That step-function discharge is exactly what reads
    // as a small burst escaping the pile. 22 such events in a 240-step run.
    //
    // A deformation gradient can only carry RECOVERABLE strain. Strain past what
    // the material can elastically hold is permanent -- it is compaction, and it
    // belongs in the particle positions, which already carry the plastic motion.
    // So clamp what gets STORED and let the excess be plastic. The stress S
    // written out this step is untouched (it was already return-mapped), so
    // nothing is discarded and there is nothing to discharge.
    //
    // Frobenius <= 0.5 bounds every eigenvalue of eps by 0.5, so I + eps keeps
    // det >= 0.125 and the determinant floor downstream becomes unreachable by
    // this route -- which is why that floor is now a non-finite check only.
    float stored_strain=sqrt(dot(projected_strain[0],projected_strain[0])+
                             dot(projected_strain[1],projected_strain[1])+
                             dot(projected_strain[2],projected_strain[2]));
    bool compaction_capped=false;
    if(!(stored_strain<1.0e30)){projected_strain=mat3(0.0);compaction_capped=true;}
    else if(stored_strain>pc.max_stored_strain){
        projected_strain*=pc.max_stored_strain/stored_strain;
        compaction_capped=true;
    }
    mat3 F_projected=R*(mat3(1.0)+projected_strain);
    bool bad=bad_kinematics||!finiteMat3(S)||!finiteMat3(F_projected)||
             determinant(F_projected)<=1.0e-6||
             isnan(d)||isinf(d)||isnan(accumulated_plastic)||isinf(accumulated_plastic)||
             isnan(bond_opening)||isinf(bond_opening);
    if(bad){S=mat3(0.0);F_projected=mat3(1.0);d=1.0;accumulated_plastic=0.0;bond_opening=0.0;plastic_increment=0.0;detached=true;yielded=false;compaction_capped=false;}
    sd[i*3]=S[0][0];sd[i*3+1]=S[1][1];sd[i*3+2]=S[2][2];
    ss[i*3]=S[0][1];ss[i*3+1]=S[0][2];ss[i*3+2]=S[1][2];
    yield_values[i]=bad?0.0:trial_yield_overstress;
    plastic_increments[i]=plastic_increment;
    damage[i]=d;
    hardening_state[i]=clamp(accumulated_plastic,0.0,1000.0);
    fracture_history[i]=clamp(bond_opening,0.0,1000.0);
    f0[i*3]=F_projected[0][0];f0[i*3+1]=F_projected[0][1];f0[i*3+2]=F_projected[0][2];
    f1[i*3]=F_projected[1][0];f1[i*3+1]=F_projected[1][1];f1[i*3+2]=F_projected[1][2];
    f2[i*3]=F_projected[2][0];f2[i*3+1]=F_projected[2][1];f2[i*3+2]=F_projected[2][2];
    // Bit 8 (sleeping) is the settle kernel's, and settle runs right after this
    // one, so clearing it here is deliberate and unchanged. Bit 16 is new: "the
    // subcycle was too coarse for the strain rate I was handed". It exists so
    // an under-resolved step is COUNTABLE instead of merely survivable.
    //
    // Bit 32 is different in kind: it says the material compacted past what it
    // can elastically store, so the excess became permanent. That is REAL
    // PLASTICITY, not an error -- a soft pile is expected to show it steadily.
    // It is reported so "soft but valid" can be told apart from "diverging",
    // which is the distinction the det(F) reset used to destroy.
    flags[i]=(yielded?1u:0u)|(detached?2u:0u)|(bad?4u:0u)|(strain_limited?16u:0u)|
             (compaction_capped?32u:0u);
}
