#version 450
// sim_collider_bvh_query.comp - distance from a lattice of query points to a
// triangle mesh, through the flat collider BVH (MatterGrainBvhNode layout;
// docs/dev/COLLIDER_TEMAS_YUZEYI.md, P2/P3).
//
// One kernel for two jobs:
//   mode 0  unsigned distance (mesh_bvh shell colliders, every frame). On the
//           CPU this was one nearest-triangle query per cell: 1.2 s a frame for
//           a 352k-triangle collider over 885k cells (2026-11-02 measure).
//   mode 1  signed distance (mesh_sdf cook): sign from a ray-parity vote over
//           three fixed non-axis directions, the CPU cook's exact rule.
// Query point n (linear index over dims) sits at  q = M * (idx + base + 0.5),
// M a 3x4 affine map into the mesh's own space, so the caller folds grid
// origin, voxel size and the world-to-local transform into one matrix.
// Output is in mesh-space units; the caller rescales.
layout(local_size_x = 256) in;
layout(push_constant) uniform PC {
    vec4 row0;   // M row 0 (xyz linear, w translation)
    vec4 row1;
    vec4 row2;
    ivec4 dims;  // xyz lattice size, w = mode
    ivec4 base;  // xyz index offset, w = point count
} pc;
struct Node {
    float lx, ly, lz;
    uint first;   // leaf: 0x80000000 | first triangle; else left child
    float hx, hy, hz;
    uint second;  // leaf: triangle count; else right child
};
layout(set = 0, binding = 0) readonly buffer Nodes { Node nodes[]; };
layout(set = 0, binding = 1) readonly buffer Vertices { float vertices[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float result[]; };

vec3 vertex(uint v) {
    return vec3(vertices[3u * v], vertices[3u * v + 1u], vertices[3u * v + 2u]);
}

// Ericson, Real-Time Collision Detection 5.1.5.
vec3 closestOnTriangle(vec3 p, vec3 a, vec3 b, vec3 c) {
    vec3 ab = b - a, ac = c - a, ap = p - a;
    float d1 = dot(ab, ap), d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) return a;
    vec3 bp = p - b;
    float d3 = dot(ab, bp), d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) return b;
    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) return a + ab * (d1 / (d1 - d3));
    vec3 cp = p - c;
    float d5 = dot(ab, cp), d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) return c;
    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) return a + ac * (d2 / (d2 - d6));
    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0)
        return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
    float denom = 1.0 / (va + vb + vc);
    return a + ab * (vb * denom) + ac * (vc * denom);
}

float boxDistance2(vec3 p, Node n) {
    vec3 d = max(max(vec3(n.lx, n.ly, n.lz) - p, p - vec3(n.hx, n.hy, n.hz)), vec3(0.0));
    return dot(d, d);
}

const int kStack = 64;

float nearestDistance2(vec3 p) {
    float best = 3.4e38;
    uint stack[kStack];
    int top = 0;
    stack[top++] = 0u;
    while (top > 0) {
        Node n = nodes[stack[--top]];
        if (boxDistance2(p, n) >= best) continue;
        if ((n.first & 0x80000000u) != 0u) {
            uint start = n.first & 0x7fffffffu;
            for (uint t = start; t < start + n.second; ++t) {
                vec3 q = closestOnTriangle(p, vertex(3u * t), vertex(3u * t + 1u), vertex(3u * t + 2u));
                vec3 d = q - p;
                best = min(best, dot(d, d));
            }
        } else if (top + 2 <= kStack) {
            // Nearer child last, so it is popped first.
            float dl = boxDistance2(p, nodes[n.first]);
            float dr = boxDistance2(p, nodes[n.second]);
            if (dl < dr) { stack[top++] = n.second; stack[top++] = n.first; }
            else { stack[top++] = n.first; stack[top++] = n.second; }
        }
    }
    return best;
}

bool rayBox(vec3 o, vec3 inv, Node n) {
    vec3 t0 = (vec3(n.lx, n.ly, n.lz) - o) * inv;
    vec3 t1 = (vec3(n.hx, n.hy, n.hz) - o) * inv;
    vec3 tmin = min(t0, t1), tmax = max(t0, t1);
    float enter = max(max(tmin.x, tmin.y), max(tmin.z, 0.0));
    float leave = min(min(tmax.x, tmax.y), tmax.z);
    return leave >= enter;
}

// Moller-Trumbore, hits at t > 0.
bool rayTriangle(vec3 o, vec3 d, vec3 a, vec3 b, vec3 c) {
    vec3 e1 = b - a, e2 = c - a;
    vec3 h = cross(d, e2);
    float det = dot(e1, h);
    if (abs(det) < 1e-12) return false;
    float f = 1.0 / det;
    vec3 s = o - a;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(s, e1);
    float v = f * dot(d, q);
    if (v < 0.0 || u + v > 1.0) return false;
    return f * dot(e2, q) > 1e-7;
}

uint rayHits(vec3 o, vec3 d) {
    vec3 inv = 1.0 / d;
    uint hits = 0u;
    uint stack[kStack];
    int top = 0;
    stack[top++] = 0u;
    while (top > 0) {
        Node n = nodes[stack[--top]];
        if (!rayBox(o, inv, n)) continue;
        if ((n.first & 0x80000000u) != 0u) {
            uint start = n.first & 0x7fffffffu;
            for (uint t = start; t < start + n.second; ++t) {
                if (rayTriangle(o, d, vertex(3u * t), vertex(3u * t + 1u), vertex(3u * t + 2u))) {
                    ++hits;
                }
            }
        } else if (top + 2 <= kStack) {
            stack[top++] = n.first;
            stack[top++] = n.second;
        }
    }
    return hits;
}

void main() {
    uint id = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    if (id >= uint(pc.base.w)) return;
    ivec3 dims = pc.dims.xyz;
    ivec3 idx = ivec3(int(id) % dims.x, (int(id) / dims.x) % dims.y, int(id) / (dims.x * dims.y));
    vec4 g = vec4(vec3(idx + pc.base.xyz) + 0.5, 1.0);
    vec3 p = vec3(dot(pc.row0, g), dot(pc.row1, g), dot(pc.row2, g));
    float dist = sqrt(nearestDistance2(p));
    if (pc.dims.w == 1) {
        // The CPU cook's three probe directions and its two-of-three vote.
        const vec3 probes[3] = vec3[3](vec3(0.5060, 0.7071, 0.4943),
                                       vec3(-0.3651, 0.5345, 0.7625),
                                       vec3(0.8112, -0.2701, 0.5184));
        int inside = 0;
        for (int k = 0; k < 3; ++k) {
            if ((rayHits(p, probes[k]) & 1u) != 0u) ++inside;
        }
        if (inside >= 2) dist = -dist;
    }
    result[id] = dist;
}
