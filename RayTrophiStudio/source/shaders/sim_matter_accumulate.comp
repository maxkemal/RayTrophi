#version 450
// target += scale * source. The grain coupling's frame-averaged liquid
// pressure: one call per liquid substep with scale = substep dt / frame dt.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Source { float source_value[]; };
layout(set = 0, binding = 1) buffer Target { float target_value[]; };
layout(push_constant) uniform Params { uint count; float scale; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) target_value[i] += pc.scale * source_value[i];
}
