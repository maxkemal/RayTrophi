#version 450
#extension GL_EXT_shader_atomic_float : require
layout(local_size_x = 256) in;

// Same 36-byte layout as FluidP2GGpuConstants and sim_fluid_clear_float.
layout(push_constant) uniform PC {
    int nx; int ny; int nz; int particle_count;
    int component; // 0: stamp compact solid cells; 1: weighted particle scatter.
    float origin_x; float origin_y; float origin_z; float voxel_size;
} pc;

layout(set = 0, binding = 0) readonly buffer Positions { float positions[]; };
layout(set = 0, binding = 1) readonly buffer Mass { float mass_fraction[]; };
layout(set = 0, binding = 2) readonly buffer Solids { uint solid_indices[]; };
layout(set = 0, binding = 3) buffer Mask { float mask[]; };

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.particle_count)) {
        return;
    }
    if (pc.component == 0) {
        uint cell = solid_indices[id];
        if (cell < uint(pc.nx * pc.ny * pc.nz)) {
            mask[cell] = -1.0;
        }
        return;
    }
    if (pc.voxel_size <= 1e-6) {
        return;
    }
    vec3 p = vec3(positions[id * 3], positions[id * 3 + 1], positions[id * 3 + 2]);
    float inv_h = 1.0 / pc.voxel_size;
    vec3 local = (p - vec3(pc.origin_x, pc.origin_y, pc.origin_z)) * inv_h;
    if (any(isnan(local)) || any(isinf(local)) || any(lessThan(local, vec3(0.0))) ||
        any(greaterThanEqual(local, vec3(pc.nx, pc.ny, pc.nz)))) {
        return;
    }
    ivec3 cell = ivec3(floor(local));
    uint index = uint(cell.x + cell.y * pc.nx + cell.z * pc.nx * pc.ny);
    // Atomic read avoids mixing ordinary reads with concurrent float atomics.
    if (atomicAdd(mask[index], 0.0) < -0.5) {
        return;
    }
    float mass = clamp(mass_fraction[id], 0.0, 1.0);
    if (mass > 0.02) {
        atomicAdd(mask[index], mass);
    }
}
