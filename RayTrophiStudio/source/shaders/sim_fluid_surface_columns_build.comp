#version 450
layout(local_size_x=256) in;
layout(push_constant) uniform PC {
    int particle_count; float dt;
    float gravity_x; float gravity_y; float gravity_z;
    float container_velocity_x; float container_velocity_y; float container_velocity_z;
    float max_velocity; uint force_count; float time_seconds; uint system_mask; uint pad0;
    uint align_pad0; uint align_pad1; uint align_pad2;
    vec4 grid_origin; int column_nx; int column_nz; float voxel_size; uint pad1;
} pc;
layout(set=0,binding=0) readonly buffer Positions { float pos_data[]; };
layout(set=0,binding=1) buffer Columns { uint heights[]; };
void main(){
    int id=int(gl_GlobalInvocationID.x);if(id>=pc.particle_count)return;
    vec3 p=vec3(pos_data[id*3],pos_data[id*3+1],pos_data[id*3+2]);
    int x=clamp(int(floor((p.x-pc.grid_origin.x)/pc.voxel_size)),0,pc.column_nx-1);
    int z=clamp(int(floor((p.z-pc.grid_origin.z)/pc.voxel_size)),0,pc.column_nz-1);
    float localY=max(0.0,(p.y-pc.grid_origin.y)/pc.voxel_size);
    atomicMax(heights[z*pc.column_nx+x],floatBitsToUint(localY));
}
