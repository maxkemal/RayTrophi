#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(push_constant) uniform Constants {
    uint cells;
    uint blocks;
    uint phase;
    int nx;
    int ny;
    float voxel;
    float origin_x;
    float origin_y;
    float origin_z;
} pc;
layout(set = 0, binding = 0) readonly buffer Mass { float mass[]; };
layout(set = 0, binding = 1) readonly buffer Energy { float energy[]; };
struct Summary { dvec4 first; dvec4 second; };
layout(set = 0, binding = 2) buffer Partials { Summary partials[]; };
layout(set = 0, binding = 3) buffer Totals { Summary totals; };
shared dvec4 first[256];
shared dvec4 second[256];
double positive(float value) {
    return isnan(value) || isinf(value) ? 0.0 : double(max(value, 0.0));
}
void main() {
    uint lane = gl_LocalInvocationID.x;
    uint block_id = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (pc.phase == 0u && block_id >= pc.blocks) {
        return;
    }
    uint cell = gl_GlobalInvocationID.x +
        gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    dvec4 a = dvec4(0.0);
    dvec4 b = dvec4(0.0);
    if (pc.phase == 0u && cell < pc.cells) {
        double m = positive(mass[cell]);
        uint nx = uint(pc.nx);
        uint ny = uint(pc.ny);
        dvec3 position = dvec3(pc.origin_x, pc.origin_y, pc.origin_z) +
            (dvec3(cell % nx, (cell / nx) % ny, cell / (nx * ny)) + 0.5) *
            double(pc.voxel);
        a = dvec4(m, positive(energy[cell]), m > 0.0 ? 1.0 : 0.0, m * position.x);
        b = dvec4(m * position.y, m * position.z, 0.0, 0.0);
    } else if (pc.phase == 1u) {
        for (uint block = lane; block < pc.blocks; block += 256u) {
            a += partials[block].first;
            b += partials[block].second;
        }
    }
    first[lane] = a;
    second[lane] = b;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            first[lane] += first[lane + stride];
            second[lane] += second[lane + stride];
        }
        barrier();
    }
    if (lane == 0u) {
        if (pc.phase == 0u) {
            partials[block_id] = Summary(first[0], second[0]);
        } else {
            totals = Summary(first[0], second[0]);
        }
    }
}
