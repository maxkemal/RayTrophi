// Race-free thermal weathering with lithology/hardness resistance.
#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int mapWidth; int mapHeight;
    float talusAngle; float erosionAmount;
    float cellSize; float heightScale;
    uint hasMask;
    float anisotropy; float directionX; float directionY;
    float talusSettling; float sedimentRemoval;
} pc;

layout(set = 0, binding = 0) readonly buffer HeightIn { float heightIn[]; };
layout(set = 0, binding = 1) writeonly buffer HeightOut { float heightOut[]; };
layout(set = 0, binding = 2) readonly buffer Hardness { float hardnessMap[]; };
layout(set = 0, binding = 3) readonly buffer Mask { float maskMap[]; };

void main() {
    int id = int(gl_GlobalInvocationID.x);
    int total = pc.mapWidth * pc.mapHeight;
    if (id >= total) return;
    int x = id % pc.mapWidth;
    int y = id / pc.mapWidth;
    float center = heightIn[id];
    if (x <= 0 || x >= pc.mapWidth - 1 || y <= 0 || y >= pc.mapHeight - 1) {
        heightOut[id] = center;
        return;
    }

    const int dxs[8] = int[8](-1, 0, 1, -1, 1, -1, 0, 1);
    const int dys[8] = int[8](-1, -1, -1, 0, 0, 1, 1, 1);
    const float distances[8] = float[8](1.41421356, 1.0, 1.41421356, 1.0,
                                        1.0, 1.41421356, 1.0, 1.41421356);
    float safeHeightScale = max(abs(pc.heightScale), 0.001);
    float safeCellSize = max(pc.cellSize, 0.001);
    float delta = 0.0;
    for (int d = 0; d < 8; ++d) {
        int neighbor = (y + dys[d]) * pc.mapWidth + x + dxs[d];
        float other = heightIn[neighbor];
        float signedSlope = (center - other) * safeHeightScale /
            (safeCellSize * distances[d]);
        int source = signedSlope > 0.0 ? id : neighbor;
        float hardness = clamp(hardnessMap[source], 0.0, 1.0);
        float effectiveTalus = pc.talusAngle + hardness * 0.3;
        float excess = abs(signedSlope) - effectiveTalus;
        if (excess <= 0.0) continue;
        float transfer = excess * safeCellSize * distances[d] / safeHeightScale *
            pc.erosionAmount * 0.0625 * (1.0 - hardness * 0.7);
        float alignment = abs((float(dxs[d]) * pc.directionX +
            float(dys[d]) * pc.directionY) / distances[d]);
        transfer *= mix(1.0, 0.35 + 0.65 * alignment, clamp(pc.anisotropy, 0.0, 1.0));
        transfer *= clamp(pc.talusSettling, 0.0, 2.0);
        if (pc.hasMask != 0u) transfer *= clamp(maskMap[source], 0.0, 1.0);
        delta += signedSlope > 0.0 ? -transfer : transfer * (1.0 - clamp(pc.sedimentRemoval, 0.0, 1.0));
    }
    heightOut[id] = center + delta;
}
