#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC { int width; int height; float heightScale; } pc;
layout(set = 0, binding = 0) buffer Height { float heightField[]; };
layout(set = 0, binding = 1) buffer Erosion { float erosionField[]; };
layout(set = 0, binding = 2) readonly buffer Center { float centerErosion[]; };
layout(set = 0, binding = 3) readonly buffer Gathered { float gatheredErosion[]; };
layout(set = 0, binding = 4) readonly buffer OriginalHeight { float originalHeight[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.width * pc.height)) return;
    float center = max(centerErosion[i], 0.0);
    float gathered = max(gatheredErosion[i], 0.0);
    // Droplets temporarily applied the accepted erosion at their center so
    // their following steps observed a live surface. Replace that center
    // footprint with the atomics-free gathered brush result.
    float oldHeight = heightField[i];
    float totalCapMeters = clamp(pc.heightScale * 0.04, 2.0, 25.0);
    float totalCap = totalCapMeters / max(pc.heightScale, 1.0e-3);
    float floorHeight = originalHeight[i] - totalCap;
    float redistributedHeight = oldHeight + center - gathered;
    // A preceding LEM pass may legitimately have incised below the droplet
    // texture floor. Never raise that physical result merely because this
    // safety limit belongs only to the later droplet stage.
    float newHeight = oldHeight <= floorHeight
        ? max(redistributedHeight, oldHeight)
        : max(redistributedHeight, floorHeight);
    heightField[i] = newHeight;
    erosionField[i] = max(0.0, erosionField[i] + oldHeight - newHeight);
}
