#version 460
#extension GL_GOOGLE_include_directive : require
// RayFusion clouds, pass 1 of 2: the MARCH (docs/dev/ATMOSPHERE_CLOUDS.md §3.2,
// Faz 3c).
//
// The SAME cloudMarch() as Vulkan RT (cloud_rt.glsl), but only for 1 of every
// N x N pixels of the cloud target per frame (Nubis-style interleave). The
// marched pixel inside each N x N cell rotates every frame, so every pixel is
// refreshed once per N^2 frames; cloud_resolve.comp carries the others with a
// full-resolution reprojected history.
//
// ★ Compacted dispatch, one thread per MARCHED pixel. Masking 3 of 4 threads
//   in a full-resolution dispatch would save nothing: a warp waits for its
//   slowest lane, and the march is the whole cost.
//
// Output (fresh grid, ceil(w/N) x ceil(h/N)):
//   cloudFresh    rgb in-scatter, a transmittance
//   cloudFreshAux rgb flash in-scatter (not accumulated), a cloud depth (m, -1 none)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// cloud_rt.glsl reads worldData.w.{sunDir, sunIntensity, atmosphereHeight,
// _pad5} and atmosphereLUTs[0]; this block provides exactly those names.
#include "cloud_raster_frame.glsl"

#define CLOUD_SET 0
#define CLOUD_BINDING_BASE 0
#define CLOUD_MAJORANT_BINDING 5
#define CLOUD_CELL_BINDING 16
#define CLOUD_RT_LIGHTING
#define CLOUD_SEPARATE_FLASH_HISTORY
#include "cloud_rt.glsl"
#include "cloud_interleave.glsl"

layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D cloudFresh;
layout(set = 0, binding = 15, rgba16f) uniform writeonly image2D cloudFreshAux;

// Same sky-view LUT addressing as miss.rmiss (no sun disk: NEE brings it).
vec3 cloudSkyAmbient(vec3 dir) {
    if (worldData.w._pad5 == 0) return vec3(0.0);
    float u = atan(dir.z, dir.x) / (2.0 * CLOUD_PI);
    if (u < 0.0) u += 1.0;
    float v = (1.0 - clamp(dir.y, -1.0, 1.0)) * 0.5;
    return textureLod(atmosphereLUTs[1], vec2(u, v), 0.0).rgb;
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (cell.x >= int(cloudInterleave.freshW) || cell.y >= int(cloudInterleave.freshH)) return;
    uvec2 sz = worldData.info.xy;
    uint frame = worldData.info.z;
    ivec2 px = cloudInterleavePixel(cell);

    vec3 inscatter = vec3(0.0);
    float T = 1.0, depth = -1.0;
    cloudFlashInscatter = vec3(0.0);
    if (px.x < int(sz.x) && px.y < int(sz.y) && cloudRtEnabled()) {
        // R2 low-discrepancy sub-pixel jitter; the march offset comes from seed.
        vec2 jit = fract(vec2(0.7548776662, 0.5698402910) * float(frame % 4096u) + 0.5);
        vec2 uv = (vec2(px) + jit) / vec2(sz);
        vec2 ndc = uv * 2.0 - 1.0;
        float tanH = worldData.camPos.w;
        vec3 d = normalize(worldData.camFwd.xyz +
                           worldData.camRight.xyz * (ndc.x * worldData.camRight.w * tanH) -
                           worldData.camUp.xyz * (ndc.y * tanH));
        uint seed = (uint(px.x) * 1973u) ^ (uint(px.y) * 9277u) ^ (frame * 26699u) ^ 0x68bc21ebu;
        cloudMarch(worldData.camPos.xyz, d, int(worldData.info.w), seed, inscatter, T, depth);
    }
    imageStore(cloudFresh, cell, vec4(inscatter, T));
    imageStore(cloudFreshAux, cell, vec4(cloudFlashInscatter, depth));
}
