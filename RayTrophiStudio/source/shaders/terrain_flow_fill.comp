// terrain_flow_fill.comp
// GPU depression filling: Planchon-Darboux (2001) relaxation toward the same
// depression-free surface an exact priority flood (Barnes et al.) produces.
// Each interior cell may only DECREASE each pass, starting from +infinity,
// until it settles at max(ownHeight, min-over-neighbours(neighbourFilled) +
// eps). Border cells are pinned to their own height, which is the role the CPU
// version's boundary-seeded priority queue plays.
//
// ---------------------------------------------------------------------------
// ★★★ eps == 0 IS THE LEM PATH, AND IT IS NOT AN OPTIMISATION.
// ---------------------------------------------------------------------------
// This pass used to always raise each flood ring by a few ulp so that a filled
// flat would still have "somewhere downhill" for a router to find. That ladder
// was the single largest source of artificial drainage geometry in the solver:
//
//   * A ladder with the SAME step for cardinal and diagonal moves is a
//     Chebyshev distance field from the outlet, and the level sets of that are
//     SQUARES. Steepest descent over it runs along 0 and 45 degrees, which is
//     exactly the straight, angular, never-merging channel pattern that showed
//     up on flats and around filled pits while the real slopes either side
//     looked perfect.
//   * A few ulp of drop is numerically zero drop. terrain_lem_incise clamps
//     erosion to incisionSafety * (drop to the receiver), so a flat could not
//     incise at all and the drainage pattern drawn there on the first refresh
//     was frozen for the rest of the run.
//   * Dithering the step was tried (a 1.0-1.5x factor per destination cell)
//     and cannot work: the factors are SUMMED along the path, so the relative
//     spread falls as 1/sqrt(N) and a long flat converges straight back to a
//     linear ramp in geodesic distance. It changed the texture, not the shape.
//
// The LEM now passes eps = 0, which makes every cell of one filled basin
// settle on exactly the SAME float. That is what turns "the flat" into a well
// defined set that terrain_lem_flat_seed can classify by exact equality, and
// the routing gradient over it is built properly (Garbrecht & Martz, two
// geodesic distance fields) in terrain_lem_flat_*.comp instead of being a
// side effect of the flood order.
//
// eps > 0 remains for the two OTHER callers - the coarse hydraulic macro grid
// and the flow-mask/watershed solve, both in TerrainManager - which derive
// their weights straight from this surface and have no flat-resolution stage of
// their own. Only they should pass a non-zero eps.
//
// `noiseAmplitude` perturbs the SURFACE and is likewise only for those callers
// (the watershed path passes 0.03). It is the move the LEM deliberately does
// not make: perturbing the surface creates dither pits mid-flat - cells with no
// strictly lower neighbour - which the weight pass writes as an all-zero row,
// i.e. a terminal sink that cuts a river in the middle of a plain. The flat
// ramp perturbs DISTANCES instead, which cannot do that. Left alone here rather
// than changed underneath a subsystem this batch did not otherwise touch.
//
// Convergence needs roughly as many passes as the largest connected
// flat/depression region, in cells. Under-convergence shows up as basins that
// are still over-filled, i.e. spurious lakes -- reported in the erosion stats,
// not silent.
#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int mapWidth; int mapHeight;
    float eps; float noiseAmplitude;
} pc;

layout(set = 0, binding = 0) readonly buffer OrigHeight { float origHeight[]; };
layout(set = 0, binding = 1) readonly buffer FilledIn   { float filledIn[]; };
layout(set = 0, binding = 2) buffer FilledOut           { float filledOut[]; };

const int dx8[8] = int[8](-1, 0, 1, -1, 1, -1, 0, 1);
const int dy8[8] = int[8](-1, -1, -1, 0, 0, 1, 1, 1);
// A diagonal ladder step costs sqrt(2), like the ground it covers. Charging it
// the same as a cardinal step is what makes the ladder square; this only
// matters on the eps > 0 path, and there it matters a lot.
const float dist8[8] = float[8](1.41421356, 1.0, 1.41421356, 1.0,
                                1.0, 1.41421356, 1.0, 1.41421356);

float hash2(int xi, int yi) {
    uint hh = uint(xi) * 374761393u + uint(yi) * 668265263u;
    hh = (hh ^ (hh >> 13u)) * 1274126177u;
    hh ^= hh >> 16u;
    return float(hh & 0xFFFFFFu) / float(0xFFFFFF);
}

float coherentNoise(int x, int y) {
    const float blobSize = 20.0;
    float fx = float(x) / blobSize;
    float fy = float(y) / blobSize;
    int ix = int(floor(fx));
    int iy = int(floor(fy));
    float tx = fx - float(ix);
    float ty = fy - float(iy);
    float a = hash2(ix, iy);
    float b = hash2(ix + 1, iy);
    float c = hash2(ix, iy + 1);
    float d = hash2(ix + 1, iy + 1);
    float sx = tx * tx * (3.0 - 2.0 * tx);
    float sy = ty * ty * (3.0 - 2.0 * ty);
    float top = a + (b - a) * sx;
    float bot = c + (d - c) * sx;
    return top + (bot - top) * sy;
}

void main() {
    int id = int(gl_GlobalInvocationID.x);
    int total = pc.mapWidth * pc.mapHeight;
    if (id >= total) return;

    int x = id % pc.mapWidth;
    int y = id / pc.mapWidth;

    float h = origHeight[id];
    if (pc.noiseAmplitude != 0.0) h += coherentNoise(x, y) * pc.noiseAmplitude;

    if (x == 0 || x == pc.mapWidth - 1 || y == 0 || y == pc.mapHeight - 1) {
        filledOut[id] = h;
        return;
    }

    float best = 1e18;
    for (int d = 0; d < 8; d++) {
        int nIdx = (y + dy8[d]) * pc.mapWidth + (x + dx8[d]);
        float nf = filledIn[nIdx];

        float stepEps = 0.0;
        if (pc.eps > 0.0) {
            // The ladder has to stay above float resolution at the height it
            // is actually walking, not at the one the constant was calibrated
            // for: a fixed 2e-7 is about three ulp near h = 0.5 but only 1.7
            // near h = 1, so on a tall terrain a long flat run stops stepping,
            // the surface goes bitwise flat, and every cell of it becomes a
            // terminal sink. Skipped while the relaxation is still seeded at
            // +infinity, where it would be nonsense.
            stepEps = pc.eps;
            if (nf < 1.0e6) stepEps = max(pc.eps, abs(nf) * 4.0 * 1.1920929e-7);
            stepEps *= dist8[d];
        }

        float candidate = max(h, nf + stepEps);
        best = min(best, candidate);
    }
    filledOut[id] = min(filledIn[id], best);
}
