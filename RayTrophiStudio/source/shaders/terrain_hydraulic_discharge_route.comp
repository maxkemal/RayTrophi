#version 450
layout(local_size_x=256) in;
layout(push_constant) uniform PC { int width; int height; float retention; float minFlow; } pc;
layout(set=0,binding=0) readonly buffer Current { float currentFlow[]; };
layout(set=0,binding=1) writeonly buffer Next { float nextFlow[]; };
layout(set=0,binding=2) buffer Accumulated { float accumulatedFlow[]; };
layout(set=0,binding=3) readonly buffer DirectionX { float directionX[]; };
layout(set=0,binding=4) readonly buffer DirectionY { float directionY[]; };
layout(set=0,binding=5) readonly buffer Height { float heightField[]; };

ivec2 routedStep(int x,int y,int idx){
 vec2 d=vec2(directionX[idx],directionY[idx]);
 if(length(d)>1e-5) return ivec2(clamp(int(round(d.x/length(d))),-1,1),clamp(int(round(d.y/length(d))),-1,1));
 float best=heightField[idx];ivec2 step=ivec2(0);
 for(int oy=-1;oy<=1;++oy)for(int ox=-1;ox<=1;++ox){if(ox==0&&oy==0)continue;
  int nx=clamp(x+ox,0,pc.width-1),ny=clamp(y+oy,0,pc.height-1);float h=heightField[ny*pc.width+nx];
  if(h<best){best=h;step=ivec2(ox,oy);}}
 return step;
}
void main(){uint ui=gl_GlobalInvocationID.x;if(ui>=uint(pc.width*pc.height))return;
 int i=int(ui),x=i%pc.width,y=i/pc.width;
 if(x<=0||x>=pc.width-1||y<=0||y>=pc.height-1){nextFlow[i]=0.0;return;}
 float incoming=0.0;
 for(int oy=-1;oy<=1;++oy)for(int ox=-1;ox<=1;++ox){if(ox==0&&oy==0)continue;
  int sx=x+ox,sy=y+oy,si=sy*pc.width+sx;ivec2 step=routedStep(sx,sy,si);
  if(sx+step.x==x&&sy+step.y==y)incoming+=max(currentFlow[si],0.0);}
 float routed=incoming*pc.retention; if(routed<pc.minFlow)routed=0.0;
 nextFlow[i]=routed; accumulatedFlow[i]+=routed;
}
