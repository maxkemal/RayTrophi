#version 450
#extension GL_GOOGLE_include_directive : require
// Fill grid.w uints of binding 0 with reach.w (bin counts, stats).
layout(local_size_x = 256) in;
#include "sim_surface_common.glsl"
layout(set = 0, binding = 0) buffer Values { uint values[]; };
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.grid.w)) return;
    values[id] = uint(pc.reach.w);
}
