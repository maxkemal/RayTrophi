#version 450
#extension GL_GOOGLE_include_directive : require
// GPU wet paint (docs/dev/PLAYER_GAME_PAINT_ROOM.md step 3, section 5.3).
//
// The CPU model is MeshPaintAdapter::noteWetDab / tickWetPaint. This kernel
// carries the same equations to the device over a multi-surface atlas:
//   * every paint surface is a W x H page of texels; a texel knows its world
//     position, normal and downhill pixel-flow (baked once on the host from the
//     surface's triangles, WetPaintGpu.cpp);
//   * pages are cut into 32 x 32 tiles; one workgroup = one tile;
//   * STAMP weighs the frame's sources (host dabs or particle collision events,
//     read straight from the particle system's device buffers) by WORLD distance
//     to the texel - no triangle search, seams come out right by construction;
//   * TICK runs only on active tiles (plus their 8 neighbours), RESOLVE commits,
//     ROTATE carries the "still wet" flags forward. Cost follows the wet area.
//
// Differences from the CPU model (all deliberate, listed in the design note):
//   * The CPU scatters "downstream transport" into a target pixel while it
//     scans; scatter races on the GPU. Here each texel GATHERS: it finds the
//     upstream texel q whose CPU target would be this texel (two fixed-point
//     steps along the local downhill direction) and accepts the transport only
//     if q's own target rounds to this texel - the CPU's rule, read backwards.
//   * The CPU reads live (already updated) neighbours in scan order; the device
//     reads the previous step everywhere (order independent).
//   * Terminal beads remain CPU-only; optional height deposition now uses the
//     existing write_height_mask equation and channel/height-normal resolve.
//   * Seam mirroring is not needed: stamping is in world space and the bake
//     dilates a 2-texel gutter around every UV island.
//   * The colour layer is a paint LAYER (alpha = coverage) composited over the
//     surface's original base colour into the output page.
layout(local_size_x = 256) in;
// Per-mode pipeline specialization (0xFFFFFFFFu = dynamic pc.mode fallback).
layout(constant_id = 0) const uint RT_PAINT_MODE = 0xFFFFFFFFu;
const uint RESET_INIT_ONLY_BIT = 16u; // pc._p1 bit 4: zero paint/scratch buffers only
const uint CHANNEL_RANGE_BIT = 32u; // modes 7/8: source_count = first tile

const uint TILE = 32u;
const uint TEXELS_PER_THREAD = 4u;   // 32*32 / 256
// 128 since 2026-11-18: balloon clumps land many drops on one tile and 64
// dropped a large share of a burst's splats (paint.wet_status sources_dropped).
const uint MAX_TILE_SOURCES = 128u;

const uint MODE_STAMP = 0u;
const uint MODE_TICK = 1u;
const uint MODE_RESOLVE = 2u;
const uint MODE_ROTATE = 3u;
const uint MODE_CONSUME = 4u;
const uint MODE_COVERAGE = 5u;
const uint MODE_RESET = 6u;
const uint MODE_CHANNELS = 7u;
const uint MODE_SEED_HEIGHT = 8u;
const uint MODE_COMPACT_CHANNELS = 9u;
const uint MODE_CHANNELS_LIST = 10u;
const uint COMPACT_CHANNELS = 4u; // pc._p1 bit 2

const uint SOURCE_DABS = 0u;
const uint SOURCE_EVENTS = 1u;

const uint STATS_STRIDE = 18u;
const uint ST_ACTIVE_TILES = 0u;
const uint ST_DIRTY_MIN_X = 1u;
const uint ST_DIRTY_MIN_Y = 2u;
const uint ST_DIRTY_MAX_X = 3u;
const uint ST_DIRTY_MAX_Y = 4u;
const uint ST_STAMPED_TEXELS = 5u;
const uint ST_TICKED_TILES = 6u;
const uint ST_SOURCES_DROPPED = 7u;
const uint ST_COVERED_TEXELS = 8u;
const uint ST_VALID_TEXELS = 9u;
const uint ST_SUM_R = 10u;
const uint ST_SUM_G = 11u;
const uint ST_SUM_B = 12u;
const uint ST_WET_TEXELS = 13u;
const uint ST_ROUGHNESS_TEXELS = 14u;
const uint ST_NORMAL_TEXELS = 15u;
const uint ST_PICTURE_TEXELS = 16u;    // colourable picture texels (valid texels of picture surfaces)
const uint ST_PICTURE_REVEALED = 17u;  // of those, revealed (w >= 0.5)

const uint SURFACE_OIL = 1u;
const uint SURFACE_ROUGHNESS = 2u;
const uint SURFACE_HEIGHT_NORMAL = 4u;
const uint SURFACE_REVEAL_OPACITY = 8u;
// Hidden picture: flags bit 4 = surface has a picture, bits 8..15 outline opacity, bits 16..23 hue
// tolerance (byte of deg/180), bits 24..31 hint (byte of 0..1). Source plane 6
// of the channel atlas is the picture (RGBA8 sRGB); pc._p1 bit 3 = plane exists.
const uint SURFACE_PICTURE = 16u;
const uint PICTURE_PLANE_BIT = 8u;
// Canvas over a tiled base (docs/dev/WET_PAINT_CANVAS_UV.md): the output page
// is the paint (and picture) alone, PREMULTIPLIED, alpha = coverage; the
// renderer composites it over the material's tiled base texture. The base
// plane's rgb is only the pickup colour then, its alpha is 0.
const uint SURFACE_OVERLAY = 32u;

struct Surface {
    uint width; uint height; uint page_offset; uint tile_offset;
    uint tiles_x; uint tiles_y; uint flags; uint pbr_params;
    // Already scaled by the host exactly like tickWetPaint's derived terms
    // (oil factors, lifetime runoff factor).
    float diffusion; float runoff; float absorption; float drip_head;
    float lifetime; float brush_radius_px; float falloff; float paint_load;
    float wetness; float deposit_rate; float pickup_rate; float normal_strength;
};

struct Tile {
    uint surface; uint tx; uint ty; uint valid_texels;
    vec4 bmin;   // world AABB of the tile's texels (incl. gutter), w unused
    vec4 bmax;
};

struct Dab {
    vec4 pos_radius;     // world xyz, world radius
    vec4 color_amount;   // display-referred (sRGB) 0..1 rgb, strength
    vec4 normal_facing;  // xyz normal, w > 0.5: only texels facing the normal
};

struct CollisionEvent {
    float position[3]; uint collider;
    float normal[3]; uint profile;
    float speed; float age_fraction; uint particle; uint flags;
};

layout(push_constant) uniform PC {
    uint mode; uint surface_count; uint tile_count; uint source_kind;
    uint source_count; uint event_capacity; uint max_events; uint lookup_count;
    float dt; float splat_radius; float splat_amount; float splat_min_speed;
    float facing_min; uint lut_rows; uint _p0; uint _p1;
} pc;

layout(set=0, binding=0, std430) readonly buffer Surfaces { Surface surfaces[]; };
layout(set=0, binding=1, std430) readonly buffer Tiles { Tile tiles[]; };
layout(set=0, binding=2) readonly buffer PosValid { vec4 pos_valid[]; };   // w: 0 none, 1 covered, 2 gutter
layout(set=0, binding=3) readonly buffer FlowNormal { vec4 flow_normal[]; }; // flow_x, flow_y, slope, oct normal
layout(set=0, binding=4) readonly buffer BaseColor { uint base_color[]; };
layout(set=0, binding=5) buffer Color { uint color[]; };
layout(set=0, binding=6) buffer State { vec4 state[]; };                   // wet, pigment, thickness, revealed (hidden picture)
layout(set=0, binding=7) buffer ColorScratch { uint color_scratch[]; };
layout(set=0, binding=8) buffer StateScratch { vec4 state_scratch[]; };
layout(set=0, binding=9) buffer Output { uint out_color[]; };
// [2t] active, [2t+1] next, then three indirect counts and tile_count list entries.
layout(set=0, binding=10) buffer TileFlags { uint tile_flags[]; };
layout(set=0, binding=11) buffer Stats { uint stats[]; };
layout(set=0, binding=12, std430) readonly buffer Dabs { Dab dabs[]; };
layout(set=0, binding=13, std430) readonly buffer Events { CollisionEvent events[]; };
layout(set=0, binding=14) buffer Counter { uint counter[]; };              // {count, overflow}
layout(set=0, binding=15) readonly buffer Lut { float lut[]; };
layout(set=0, binding=16) readonly buffer Lookup { uint lookup[]; };

// ── helpers (MeshPaintAdapter.cpp equivalents) ──────────────────────────────

float srgbToLinear01(float v) {
    v = clamp(v, 0.0, 1.0);
    return v * (v * (v * 0.305306011 + 0.682171111) + 0.012522878);
}
float linearToSrgb01(float v) {
    v = clamp(v, 0.0, 1.0);
    float s1 = sqrt(v);
    float s2 = sqrt(s1);
    float s3 = sqrt(s2);
    return clamp(0.585122381 * s1 + 0.783140355 * s2 - 0.368262736 * s3, 0.0, 1.0);
}
// Colours are carried as byte-valued floats (0..255), like CompactVec4.
float blendChannelLinear(float dst, float target, float alpha) {
    float t = clamp(alpha, 0.0, 1.0);
    if (t <= 0.0 || dst == target) return dst;
    if (t >= 1.0) return target;
    float c = srgbToLinear01(dst / 255.0);
    float g = srgbToLinear01(target / 255.0);
    return clamp(floor(linearToSrgb01(c + (g - c) * t) * 255.0 + 0.5), 0.0, 255.0);
}
vec4 unpackColor(uint c) { return unpackUnorm4x8(c) * 255.0; }
// ★ NaN guard (2026-11-18): a NaN colour packs to rgb 0 while the alpha comes
// from a finite pigment, i.e. BLACK paint, and NaN state spreads down the
// runoff. A bad colour becomes an empty (transparent) texel instead.
uint packColor(vec4 c) {
    if (any(isnan(c)) || any(isinf(c))) return 0u;
    return packUnorm4x8(clamp(c, 0.0, 255.0) / 255.0);
}
vec4 cleanState(vec4 v) { return (any(isnan(v)) || any(isinf(v))) ? vec4(0.0) : v; }

float brushWeight(float dist_norm, float radius_px, float falloff) {
    if (radius_px <= 0.0) return 0.0;
    if (radius_px <= 1.0) {
        float scale = radius_px / (radius_px + 0.75);
        return clamp(1.0 - dist_norm * scale, 0.0, 1.0);
    }
    float n = clamp(dist_norm, 0.0, 1.0);
    float inner = clamp(1.0 - falloff, 0.0, 1.0);
    if (n <= inner) return 1.0;
    float t = clamp((n - inner) / max(0.001, 1.0 - inner), 0.0, 1.0);
    return 1.0 - (t * t * (3.0 - 2.0 * t));
}

vec3 octDecode(float packed) {
    vec2 e = unpackSnorm2x16(floatBitsToUint(packed));
    vec3 n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) {
        vec2 s = vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        n.xy = (1.0 - abs(n.yx)) * s;
    }
    return normalize(n);
}

// liftLayerAlpha (the GPU layer always "uses layers").
void liftLayerAlpha(inout vec4 px, float pigment_amount, float wet_amount,
                    float incoming_alpha, float blend_alpha) {
    float current = px.a / 255.0;
    float pigment_alpha = clamp(pigment_amount * (0.24 + clamp(wet_amount, 0.0, 1.0) * 0.60), 0.0, 1.0);
    float carried = clamp(incoming_alpha * blend_alpha, 0.0, 1.0);
    float target_a = max(current, max(pigment_alpha, carried));
    if (target_a > current) px.a = clamp(target_a * 255.0, 0.0, 255.0);
}

// ── addressing ──────────────────────────────────────────────────────────────

uint texelIndex(Surface s, int x, int y) {
    x = clamp(x, 0, int(s.width) - 1);
    y = clamp(y, 0, int(s.height) - 1);
    return s.page_offset + uint(y) * s.width + uint(x);
}

void tileTexel(Tile t, uint k, out int x, out int y) {
    uint i = gl_LocalInvocationIndex + k * 256u;
    x = int(t.tx * TILE + (i % TILE));
    y = int(t.ty * TILE + (i / TILE));
}

// Per-tile "changed this step" bits (2026-11-24), after the channel list in
// binding 10: [3*tile_count + 3 + t]. Set by STAMP (both), RESOLVE (by
// comparing old/new) and RESET (both); read by the channel gate; cleared by
// ROTATE. CONTENT: colour or wetness changed (the tile's own roughness/colour
// planes). HEIGHT: thickness or coverage changed (normals read 2 texels, so
// the 3x3 tile neighbourhood). Replaces the 5x5 ACTIVE dilation, which redid
// every plane of ~25 tiles per wet tile whether anything changed or not.
const uint CHANGED_CONTENT = 1u;
const uint CHANGED_HEIGHT = 2u;
uint tileChangedIndex(uint tile_index) { return 3u * pc.tile_count + 3u + tile_index; }
// ★ An exe from before 2026-11-24 allocates binding 10 WITHOUT the changed
//   region: writing it would run off the buffer (device loss). Such a host
//   gets no changed bits and the channel gate falls back to the old 5x5
//   ACTIVE dilation, so this SPIR-V is safe with either build.
bool changedBitsAvailable() { return uint(tile_flags.length()) >= 4u * pc.tile_count + 3u; }
void markTileChanged(uint tile_index, uint bits) {
    if (changedBitsAvailable()) atomicOr(tile_flags[tileChangedIndex(tile_index)], bits);
}

bool inSurface(Surface s, int x, int y) {
    return x >= 0 && y >= 0 && x < int(s.width) && y < int(s.height);
}

// Bilinear reads of the previous step (CPU: sampleSourceScalar / sampleSourcePixel).
vec3 sampleStateXYZ(Surface s, float gx, float gy) {
    gx = clamp(gx, 0.0, float(s.width - 1u));
    gy = clamp(gy, 0.0, float(s.height - 1u));
    int x0 = int(floor(gx)); int y0 = int(floor(gy));
    float fx = gx - float(x0); float fy = gy - float(y0);
    vec3 a = state[texelIndex(s, x0, y0)].xyz;
    vec3 b = state[texelIndex(s, x0 + 1, y0)].xyz;
    vec3 c = state[texelIndex(s, x0, y0 + 1)].xyz;
    vec3 d = state[texelIndex(s, x0 + 1, y0 + 1)].xyz;
    return mix(mix(a, b, fx), mix(c, d, fx), fy);
}
vec4 sampleColor(Surface s, float gx, float gy) {
    gx = clamp(gx, 0.0, float(s.width - 1u));
    gy = clamp(gy, 0.0, float(s.height - 1u));
    int x0 = int(floor(gx)); int y0 = int(floor(gy));
    float fx = gx - float(x0); float fy = gy - float(y0);
    vec4 a = unpackColor(color[texelIndex(s, x0, y0)]);
    vec4 b = unpackColor(color[texelIndex(s, x0 + 1, y0)]);
    vec4 c = unpackColor(color[texelIndex(s, x0, y0 + 1)]);
    vec4 d = unpackColor(color[texelIndex(s, x0 + 1, y0 + 1)]);
    // ★ Weighted by coverage (alpha): an empty texel is rgb 0 / alpha 0, and a
    // plain bilinear mix pulled its BLACK into every stain edge the runoff read.
    vec4 w = vec4((1.0 - fx) * (1.0 - fy), fx * (1.0 - fy), (1.0 - fx) * fy, fx * fy) *
             vec4(a.a, b.a, c.a, d.a);
    float sw = w.x + w.y + w.z + w.w;
    float alpha = mix(mix(a.a, b.a, fx), mix(c.a, d.a, fx), fy);
    if (sw <= 1e-4) return vec4(0.0, 0.0, 0.0, alpha);
    return vec4((a.rgb * w.x + b.rgb * w.y + c.rgb * w.z + d.rgb * w.w) / sw, alpha);
}

// Paint carried by the runoff/transport into dst. The colour layer of an empty
// texel is rgb 0 / alpha 0, so blending raw rgb made black both ways: an empty
// SOURCE (the top of a fresh stain) pulled the paint toward black, and an empty
// DESTINATION (the drip front) went from black part way to the paint colour
// while its alpha rose. Only covered paint carries colour, and an uncovered
// destination takes the incoming colour as its own.
vec4 carryPaint(vec4 dst, vec4 src, float alpha) {
    float src_cov = clamp(src.a / 255.0 * 4.0, 0.0, 1.0);
    float t = alpha * src_cov;
    if (t <= 0.0005) return dst;
    vec3 base = mix(src.rgb, dst.rgb, clamp(dst.a / 255.0 * 4.0, 0.0, 1.0));
    dst.r = blendChannelLinear(base.r, src.r, t);
    dst.g = blendChannelLinear(base.g, src.g, t);
    dst.b = blendChannelLinear(base.b, src.b, t);
    return dst;
}


// ── hidden picture ──────────────────────────────────────────────────────────

bool pictureOn(Surface s) {
    return (pc._p1 & PICTURE_PLANE_BIT) != 0u && pc._p0 != 0u && (s.flags & SURFACE_PICTURE) != 0u;
}
uint pictureTexel(uint ti) { return base_color[6u * pc._p0 + ti]; }
// 0 not part of the picture, 1 achromatic (pure black outline / white / gray),
// 2 colourable (hidden until matching or component paint lands).
// Keep the achromatic threshold tight (sat < 0.10 or val < 0.12) so pastel
// wall textures used with "@base" are colour-matched instead of acting like a
// scratch-off mask that reveals on any paint colour.
uint pictureKind(uint pic) {
    vec4 p = unpackColor(pic);
    if (p.a < 128.0) return 0u;
    float mx = max(p.r, max(p.g, p.b)) / 255.0;
    float mn = min(p.r, min(p.g, p.b)) / 255.0;
    float sat = mx > 0.0 ? (mx - mn) / mx : 0.0;
    if (sat < 0.10 || mx < 0.12) return 1u;
    return 2u;
}
// rgb 0..1 -> hue in degrees (0..360), saturation and value out.
float hueDegrees(vec3 c, out float sat, out float val) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float d = mx - mn;
    val = mx;
    sat = mx > 0.0 ? d / mx : 0.0;
    if (d <= 1e-6) return 0.0;
    float h;
    if (mx == c.r) h = mod((c.g - c.b) / d, 6.0);
    else if (mx == c.g) h = (c.b - c.r) / d + 2.0;
    else h = (c.r - c.g) / d + 4.0;
    return h * 60.0;
}
float hueDistance(float a, float b) {
    float d = abs(a - b);
    return min(d, 360.0 - d);
}
// Gradual reveal target (0..1) for a colourable picture texel (kind 2).
// Exact hue match (within tolerance) can reveal all the way to 1.0.
// A component colour of a mix (e.g. red or yellow on an orange pixel, within
// ~2.4x tolerance) reveals partially (up to 0.45); once the complementary
// colour also hits and mixes toward the target hue, exact_match rises and
// brings the texel smoothly to 1.0 (full original pixel colour).
float pictureRevealTarget(Surface s, uint pic, vec4 paint) {
    float cov = clamp(paint.a / 255.0, 0.0, 1.0);
    if (cov <= 0.05) return 0.0;
    float psat, pval, qsat, qval;
    float ph = hueDegrees(paint.rgb / 255.0, psat, pval);
    if (psat < 0.2) return 0.0;
    float qh = hueDegrees(unpackColor(pic).rgb / 255.0, qsat, qval);
    float tol = float((s.flags >> 16u) & 255u) / 255.0 * 180.0;
    float d = hueDistance(ph, qh);
    float exact_match = 1.0 - smoothstep(tol * 0.5, tol, d);
    float comp_match = 1.0 - smoothstep(tol, min(90.0, tol * 2.4), d);
    float color_cap = max(exact_match, 0.45 * comp_match);
    return color_cap * smoothstep(0.10, 0.85, cov);
}

// ── STAMP ───────────────────────────────────────────────────────────────────

const uint STAMP_BATCH = 16u;
shared uint s_list[MAX_TILE_SOURCES];
shared uint s_count;
shared uint s_flag;
shared uint s_sum[4];
shared uint s_pic[4];
// Workgroup-uniform activity gate (one tile per workgroup). See
// workgroupDilatedActive: the neighbourhood flags are read ONCE per tile, not
// once per thread. Idle tiles were the bulk of paint_wet's cost: every mode
// launches one workgroup per tile of all surfaces (8 x 1024^2 -> 32768 groups),
// and each of the 256 threads re-read 9 (tick/resolve) or 25 (channels) flags.
shared uint s_gate;
// Per-batch source cache for STAMP: constant event/dab fields and precomputed
// finger capsules are loaded once per workgroup instead of per texel.
shared vec4 s_pos_r[STAMP_BATCH];       // p.xyz, bound radius r
shared vec4 s_norm_face[STAMP_BATCH];   // n.xyz (unit for events), facing (0/1)
shared vec4 s_col_amt[STAMP_BATCH];     // srgb255.rgb, amount
shared vec4 s_u_g[STAMP_BATCH];         // u.xyz, graze g
shared vec4 s_w_cr[STAMP_BATCH];        // w.xyz, core_r
shared vec4 s_ph[STAMP_BATCH];          // ph.xyzw
shared vec4 s_misc[STAMP_BATCH];        // load_base, jag, inv_stretch_cr, inv_cr
shared uvec2 s_seed_f[STAMP_BATCH];     // seed, uint(fingers)
shared vec4 s_f0[STAMP_BATCH * 8u];     // finger dir.xy, len, root
shared float s_fbead[STAMP_BATCH * 8u]; // finger bead_r

// ── Event splat shape (2026-11-18) ──────────────────────────────────────────
// A drop hitting a wall is not a disc. sim_particle_collide.comp packs the
// drop's size_scale (flags bits 8..15, /64; 0 = unknown -> 1) and its impact
// direction (bits 16..31, octahedral) into the event. From those:
//   * core radius and paint LOAD grow with the drop (load ~ size^2): a big drop
//     leaves a wet, heavy centre that the TICK's runoff carries down a little,
//     a small one dries in place;
//   * a grazing hit stretches the splat along the wall and shifts it forward;
//   * the rim is a few random low lobes plus 3..8 tapering fingers ending in a
//     bead (more and longer with impact speed; 2026-11-24 - the old sharp
//     14-fold spikes read as ice crystals), and teardrop satellite droplets
//     sit just outside the rim.
// Everything is seeded per event (particle slot + position), so it costs a few
// ALU ops per texel-source pair and no memory.
uint hashU(uint x) {
    x ^= x >> 16u; x *= 0x7feb352du; x ^= x >> 15u; x *= 0x846ca68bu; x ^= x >> 16u;
    return x;
}
float hash01(uint x) { return float(hashU(x) & 0xFFFFFFu) / 16777216.0; }

float eventDropSize(uint flags) {
    uint q = (flags >> 8u) & 255u;
    return q == 0u ? 1.0 : clamp(float(q) / 64.0, 0.35, 2.5);
}
bool eventImpactDir(uint flags, out vec3 d) {
    d = vec3(0.0, -1.0, 0.0);
    if (((flags >> 8u) & 255u) == 0u) return false;
    vec2 o = vec2(float((flags >> 16u) & 255u), float((flags >> 24u) & 255u)) / 255.0 * 2.0 - 1.0;
    vec3 n = vec3(o.x, o.y, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    d = normalize(n);
    return true;
}
uint eventSeed(CollisionEvent e) {
    return hashU(e.particle * 747796405u ^ hashU(floatBitsToUint(e.position[0]) ^
                 hashU(floatBitsToUint(e.position[1]) + floatBitsToUint(e.position[2]))));
}
float eventCoreRadius(CollisionEvent e) {
    float speed_f = clamp(0.8 + 0.035 * e.speed, 0.85, 1.25);
    return pc.splat_radius * (0.5 + 0.5 * eventDropSize(e.flags)) * speed_f;
}
// Tangential share of the impact (0 head-on, 1 grazing) and its direction.
float eventGraze(CollisionEvent e, vec3 n, out vec3 u) {
    vec3 v;
    if (eventImpactDir(e.flags, v)) {
        vec3 vt = v - n * dot(v, n);
        float g = length(vt);
        if (g > 0.05) { u = vt / g; return g; }
    }
    vec3 helper = abs(n.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 a = normalize(cross(n, helper));
    vec3 b = cross(n, a);
    float phi = hash01(eventSeed(e) + 7u) * 6.2831853;
    u = a * cos(phi) + b * sin(phi);
    return 0.0;
}
// Tangential graze magnitude only (for lightweight tile culling without seed/sin/cos).
float eventGrazeFactor(uint flags, vec3 n) {
    vec3 v;
    if (eventImpactDir(flags, v)) {
        vec3 vt = v - n * dot(v, n);
        float g = length(vt);
        if (g > 0.05) return g;
    }
    return 0.0;
}
// Lightweight tile culling info: avoids LUT lookups, linearToSrgb01 pow(),
// eventSeed, and tangent-frame trig during the per-tile source scan.
bool sourceCullAt(uint idx, out vec3 p, out float r) {
    if (pc.source_kind == SOURCE_DABS) {
        Dab d = dabs[idx];
        p = d.pos_radius.xyz;
        r = d.pos_radius.w;
        return r > 0.0 && d.color_amount.a > 0.0;
    }
    CollisionEvent e = events[idx];
    p = vec3(e.position[0], e.position[1], e.position[2]);
    if (e.speed < pc.splat_min_speed || pc.splat_radius <= 0.0 || pc.splat_amount <= 0.0) {
        r = 0.0;
        return false;
    }
    vec3 n = normalize(vec3(e.normal[0], e.normal[1], e.normal[2]));
    float g = eventGrazeFactor(e.flags, n);
    r = eventCoreRadius(e) * (2.0 * (1.0 + 0.9 * g) + 0.3);
    return r > 0.0;
}
void loadBatchSource(uint slot, uint idx) {
    if (pc.source_kind == SOURCE_DABS) {
        Dab d = dabs[idx];
        s_pos_r[slot] = d.pos_radius;
        s_norm_face[slot] = vec4(d.normal_facing.xyz, d.normal_facing.w > 0.5 ? 1.0 : 0.0);
        s_col_amt[slot] = vec4(clamp(d.color_amount.rgb, 0.0, 1.0) * 255.0, d.color_amount.a);
        return;
    }
    CollisionEvent e = events[idx];
    vec3 p = vec3(e.position[0], e.position[1], e.position[2]);
    vec3 n = normalize(vec3(e.normal[0], e.normal[1], e.normal[2]));
    uint seed = eventSeed(e);
    float size = eventDropSize(e.flags);
    float core_r = eventCoreRadius(e);
    vec3 u;
    float g = eventGraze(e, n, u);
    vec3 w = cross(n, u);
    float r = core_r * (2.0 * (1.0 + 0.9 * g) + 0.3);
    // Colour: the particle's appearance LUT at its age (linear rgb -> sRGB 0..255).
    vec3 lin = vec3(1.0);
    uint row = e.profile < pc.lookup_count ? lookup[e.profile] : 0xFFFFFFFFu;
    if (row < pc.lut_rows) {
        float s = clamp(e.age_fraction, 0.0, 1.0) * 63.0;
        uint i0 = uint(floor(s)); uint i1 = min(i0 + 1u, 63u); float f = s - float(i0);
        uint base = row * 512u;
        vec3 c0 = vec3(lut[base + i0 * 8u], lut[base + i0 * 8u + 1u], lut[base + i0 * 8u + 2u]);
        vec3 c1 = vec3(lut[base + i1 * 8u], lut[base + i1 * 8u + 1u], lut[base + i1 * 8u + 2u]);
        lin = mix(c0, c1, f);
    }
    vec3 srgb255 = vec3(linearToSrgb01(lin.r), linearToSrgb01(lin.g), linearToSrgb01(lin.b)) * 255.0;
    float load_base = clamp(size * size, 0.3, 3.0) * (0.85 + 0.3 * hash01(seed + 6u));
    vec4 ph = vec4(hash01(seed + 1u), hash01(seed + 2u), hash01(seed + 3u), hash01(seed + 4u)) * 6.2831853;
    float jag = clamp(0.25 + 0.03 * e.speed, 0.25, 0.7) * (0.7 + 0.6 * hash01(seed + 5u));
    uint fingers = uint(min(8, 3 + int(floor(hash01(seed + 9u) * (1.0 + 7.0 * jag)))));
    s_pos_r[slot] = vec4(p, r);
    s_norm_face[slot] = vec4(n, 1.0);
    s_col_amt[slot] = vec4(srgb255, pc.splat_amount);
    s_u_g[slot] = vec4(u, g);
    s_w_cr[slot] = vec4(w, core_r);
    s_ph[slot] = ph;
    s_misc[slot] = vec4(load_base, jag, 1.0 / ((1.0 + 0.9 * g) * core_r), 1.0 / core_r);
    s_seed_f[slot] = uvec2(seed, fingers);
}
void loadBatchFinger(uint slot, uint fi) {
    uvec2 sf = s_seed_f[slot];
    if (fi >= sf.y) return;
    uint seed = sf.x;
    float g = s_u_g[slot].w;
    float phw = s_ph[slot].w;
    float jag = s_misc[slot].y;
    uint fs = hashU(seed ^ ((fi + 1u) * 0x9E3779B9u));
    float ang = (float(fi) + 0.2 + 0.6 * hash01(fs)) / float(sf.y) * 6.2831853 + phw;
    ang = atan(sin(ang), cos(ang)) * (1.0 - 0.55 * g);
    vec2 dir = vec2(cos(ang), sin(ang));
    float len = min(1.85, 1.1 + (0.3 + 0.55 * jag) * hash01(fs + 1u) + 0.35 * g * max(0.0, dir.x));
    float root = 0.17 + 0.12 * hash01(fs + 2u);
    float bead_r = root * (0.55 + 0.35 * hash01(fs + 3u));
    uint fidx = slot * 8u + fi;
    s_f0[fidx] = vec4(dir, len, root);
    s_fbead[fidx] = bead_r;
}
// Weight of cached batch event `slot` at offset `dv = tp - p`; load = paint carried there.
float eventSplatWeightBatch(uint slot, vec3 dv, float falloff, out float load) {
    vec4 ug = s_u_g[slot];
    vec4 wcr = s_w_cr[slot];
    vec4 misc = s_misc[slot];
    vec3 n = s_norm_face[slot].xyz;
    float x = (dot(dv, ug.xyz) - 0.3 * ug.w * wcr.w) * misc.z;
    float y = dot(dv, wcr.xyz) * misc.w;
    // Distance OFF the contact plane counts too (prevents floor splats painting wall foot).
    float h = dot(dv, n) * misc.w;
    float rho2 = x * x + y * y + h * h;
    load = misc.x;
    if (rho2 > 4.41) return 0.0;   // 2.1^2
    float rho = sqrt(rho2);
    // atan(0, 0) is undefined in GLSL (NaN on some drivers).
    float th = rho > 1e-5 ? atan(y, x) : 0.0;
    vec4 ph = s_ph[slot];
    float rim = 1.0 + 0.14 * sin(3.0 * th + ph.x) + 0.09 * sin(5.0 * th + ph.y) +
                0.05 * sin(7.0 * th + ph.z);
    float weight = brushWeight(rho / max(0.4, rim), 2.0, falloff);
    uvec2 sf = s_seed_f[slot];
    uint fbase = slot * 8u;
    vec2 q2 = vec2(x, y);
    float h2 = h * h;
    for (uint i = 0u; i < sf.y; ++i) {
        vec4 f0 = s_f0[fbase + i];
        float bead_r = s_fbead[fbase + i];
        vec2 dir = f0.xy;
        float len = f0.z;
        float root = f0.w;
        float t = clamp(dot(q2, dir), 0.0, len);
        float half_w = mix(root, root * 0.4, t / len);
        vec2 df = q2 - dir * t;
        float d2f = dot(df, df) + h2;
        float wf = d2f < half_w * half_w ? brushWeight(sqrt(d2f) / half_w, 2.0, falloff) : 0.0;
        vec2 db = q2 - dir * len;
        float d2b = dot(db, db) + h2;
        float wb = d2b < bead_r * bead_r ? brushWeight(sqrt(d2b) / bead_r, 2.0, falloff) : 0.0;
        float wfinger = max(wf, wb);
        if (wfinger > weight) { weight = wfinger; load *= (wb > wf ? 0.85 : 0.6); }
    }
    const float K = 11.0;
    float sector = clamp(floor((th + 3.14159265) / 6.2831853 * K), 0.0, K - 1.0);
    uint sh = hashU(sf.x ^ (uint(sector) * 2654435761u));
    if (hash01(sh) < clamp(misc.y * 0.9, 0.2, 0.6)) {
        float tc = (sector + 0.25 + 0.5 * hash01(sh + 1u)) / K * 6.2831853 - 3.14159265;
        float rc = 1.25 + 0.55 * hash01(sh + 2u);
        float sr = 0.05 + 0.10 * hash01(sh + 3u) * hash01(sh + 4u);
        vec2 radial = vec2(cos(tc), sin(tc));
        vec2 rel = q2 - rc * radial;
        float along = dot(rel, radial);
        float across = dot(rel, vec2(-radial.y, radial.x));
        float stretch = 1.4 + 0.8 * hash01(sh + 5u);
        float al_s = along / stretch;
        float d2s = al_s * al_s + across * across + h2;
        if (d2s < sr * sr) {
            float ws = brushWeight(sqrt(d2s) / sr, 2.0, falloff) * 0.9;
            if (ws > weight) { weight = ws; load *= 0.5; }
        }
    }
    return weight;
}

float paintHeightGain(Surface s) {
    return clamp(float(s.pbr_params >> 16u) * (1.6 / 65535.0), 0.0, 1.0);
}

float paintBaseHeight(uint texel) {
    float original = float(base_color[2u * pc._p0 + texel] & 255u);
    return clamp((original - 128.0) / 127.0, 0.0, 1.0);
}

float buildPaintHeight(float current, float ceiling, float load) {
    // A deposit fills a fraction of the available relief and never lowers an
    // existing ridge when the operator turns the control down.
    return current + max(ceiling - current, 0.0) * clamp(load, 0.0, 0.30);
}

void stampTile(uint tile_index) {
    uint count = pc.source_count;
    const bool splat = pc.source_kind == SOURCE_EVENTS;
    if (splat) {
        if (pc.splat_radius <= 0.0 || pc.splat_amount <= 0.0) return;
        count = min(min(counter[0], pc.event_capacity), pc.max_events);
    }
    if (count == 0u) return;

    Tile t = tiles[tile_index];
    if (t.valid_texels == 0u) return;
    uint lid = gl_LocalInvocationIndex;

    if (lid == 0u) { s_count = 0u; s_flag = 0u; }
    barrier();
    for (uint base = 0u; base < count; base += 256u) {
        uint idx = base + lid;
        if (idx < count) {
            vec3 p; float r;
            if (sourceCullAt(idx, p, r)) {
                vec3 d = max(t.bmin.xyz - p, vec3(0.0)) + max(p - t.bmax.xyz, vec3(0.0));
                if (dot(d, d) <= r * r) {
                    uint slot = atomicAdd(s_count, 1u);
                    if (slot < MAX_TILE_SOURCES) s_list[slot] = idx;
                }
            }
        }
    }
    barrier();
    uint listed = min(s_count, MAX_TILE_SOURCES);
    if (lid == 0u && s_count > MAX_TILE_SOURCES) {
        atomicAdd(stats[t.surface * STATS_STRIDE + ST_SOURCES_DROPPED], s_count - MAX_TILE_SOURCES);
    }
    if (listed == 0u) return;
    Surface s = surfaces[t.surface];

    // The stroke terms of the CPU Wet/Oil brush (scene_ui_modifiers.cpp) at the
    // start of a stroke: loaded paint = the splat colour, load = paint_load.
    const bool oil = (s.flags & SURFACE_OIL) != 0u;
    const float surf_load = clamp(s.paint_load, 0.0, 1.0);
    const float wetness = clamp(s.wetness, 0.0, 1.0);
    const float pickup = clamp(s.pickup_rate, 0.0, 1.0);
    const float fresh_bias = clamp(clamp(s.deposit_rate, 0.0, 1.0) * (0.82 + 0.18 * wetness) *
                                   (0.78 + 0.22 * surf_load), 0.0, 1.0);
    const float deposit_ratio = clamp(fresh_bias * (0.78 + 0.22 * surf_load), 0.0, 1.0);
    const float deposited = deposit_ratio * (0.25 + surf_load * 0.75);
    const float surf_falloff = clamp(s.falloff, 0.0, 1.0);
    const float surf_act_scale = wetness * (0.04 + deposited * 0.96);
    const float underpaint_k = wetness * (1.0 - fresh_bias * (oil ? 0.92 : 0.82)) *
                               ((oil ? 0.08 : 0.18) + pickup * (oil ? 0.18 : 0.34));
    const float height_gain = paintHeightGain(s);
    const bool deposit_height = (s.flags & SURFACE_HEIGHT_NORMAL) != 0u &&
                                pc._p0 != 0u && height_gain > 0.0;
    uint touched_mask = 0u;

    for (uint b = 0u; b < listed; b += STAMP_BATCH) {
        uint batch_n = min(STAMP_BATCH, listed - b);
        if (lid < batch_n) {
            loadBatchSource(lid, s_list[b + lid]);
        }
        barrier();
        if (splat && lid < batch_n * 8u) {
            loadBatchFinger(lid >> 3u, lid & 7u);
        }
        barrier();

        for (uint k = 0u; k < TEXELS_PER_THREAD; ++k) {
            int x, y; tileTexel(t, k, x, y);
            if (!inSurface(s, x, y)) continue;
            uint ti = texelIndex(s, x, y);
            vec4 pv = pos_valid[ti];
            if (pv.w < 0.5) continue;
            bool tn_loaded = false;
            vec3 tn = vec3(0.0);
            bool hit = false;
            vec4 st = vec4(0.0);
            vec4 px = vec4(0.0);
            uint base_packed = 0u;
            float height_ceiling = 0.0;

            for (uint j = 0u; j < batch_n; ++j) {
                vec4 pr = s_pos_r[j];
                vec3 dv = pv.xyz - pr.xyz;
                float d2 = dot(dv, dv);
                if (d2 > pr.w * pr.w) continue;
                vec4 nf = s_norm_face[j];
                if (nf.w > 0.5) {
                    if (!tn_loaded) {
                        tn = octDecode(flow_normal[ti].w);
                        tn_loaded = true;
                    }
                    if (dot(tn, nf.xyz) < pc.facing_min) continue;
                }
                vec4 ca = s_col_amt[j];
                float activation = clamp(clamp(ca.a, 0.0, 1.0) * surf_act_scale, 0.0, 1.0);
                if (activation <= 0.001) continue;
                float drop_load = 1.0;
                float weight = splat
                    ? eventSplatWeightBatch(j, dv, surf_falloff, drop_load)
                    : brushWeight(sqrt(d2) / pr.w, 2.0, surf_falloff);
                if (!(weight > 0.001) || isinf(weight)) continue;   // also skips NaN
                float wet_add = min(weight * activation * drop_load, 1.0);
                if (wet_add <= 0.001) continue;

                if (!hit) {
                    st = state[ti];
                    px = unpackColor(color[ti]);
                    base_packed = base_color[ti];
                    if (deposit_height) {
                        float base_height = paintBaseHeight(ti);
                        height_ceiling = mix(base_height, 1.0, height_gain);
                        st.z = max(st.z, base_height);
                    }
                    hit = true;
                }
                float pigment_add = wet_add * deposited;
                st.x = clamp(st.x + wet_add * (0.18 + deposited * 0.82), 0.0, 1.0);
                st.y = clamp(st.y + pigment_add, 0.0, 1.0);
                if (deposit_height) {
                    st.z = buildPaintHeight(st.z, height_ceiling, pigment_add);
                }
                float seed = max(clamp(weight * clamp(ca.a * (splat ? 0.85 + 0.25 * drop_load : 1.0), 0.0, 1.0), 0.0, 1.0),
                                 clamp(wet_add * (0.22 + deposited * 0.78), 0.0, 1.0));
                float wet_gate = clamp((st.x - 0.04) / 0.28, 0.0, 1.0);
                float pigment_gate = clamp((st.y - 0.02) / 0.20, 0.0, 1.0);
                float reservoir = clamp(wet_gate * (0.30 + pigment_gate * 0.70), 0.0, 1.0);
                float underpaint_mix = clamp(reservoir * underpaint_k *
                                             ((oil ? 0.36 : 0.55) - drop_load * (oil ? 0.10 : 0.18)),
                                             0.0, oil ? 0.20 : 0.42) *
                                       (splat ? 1.0 - 0.7 * clamp(drop_load * 0.5, 0.0, 1.0) : 1.0);
                vec3 sampled = mix(unpackColor(base_packed).rgb, px.rgb, px.a / 255.0);
                vec3 c = mix(ca.rgb, sampled, underpaint_mix);
                float dst_a = px.a / 255.0;
                float out_a = seed + dst_a * (1.0 - seed);
                if (out_a > 1e-6) {
                    float keep = dst_a * (1.0 - seed);
                    px.rgb = clamp((c * seed + px.rgb * keep) / out_a, 0.0, 255.0);
                    px.a = clamp(out_a * 255.0, 0.0, 255.0);
                }
            }
            if (hit) {
                state[ti] = cleanState(st);
                color[ti] = packColor(px);
                touched_mask |= (1u << k);
            }
        }
        barrier();
    }

    uint touched = bitCount(touched_mask);
    if (touched > 0u) atomicAdd(s_flag, touched);
    barrier();
    if (lid == 0u && s_flag > 0u) {
        atomicAdd(stats[t.surface * STATS_STRIDE + ST_STAMPED_TEXELS], s_flag);
        tile_flags[2u * tile_index] = 1u;
        // Stamps write colour/state directly, before the step's RESOLVE
        // compares old with new: without this a fresh splat on a still tile
        // would never get its roughness/normal planes.
        markTileChanged(tile_index, CHANGED_CONTENT | CHANGED_HEIGHT);
    }
}

// ── TICK ────────────────────────────────────────────────────────────────────

bool tileActive(Surface s, int tx, int ty) {
    if (tx < 0 || ty < 0 || tx >= int(s.tiles_x) || ty >= int(s.tiles_y)) return false;
    return tile_flags[2u * (s.tile_offset + uint(ty) * s.tiles_x + uint(tx))] != 0u;
}
bool dilatedActive(Tile t, Surface s) {
    for (int oy = -1; oy <= 1; ++oy)
        for (int ox = -1; ox <= 1; ++ox)
            if (tileActive(s, int(t.tx) + ox, int(t.ty) + oy)) return true;
    return false;
}
// Same answer as dilatedActive for every thread of the workgroup. Must be
// reached in uniform control flow (all callers only return on tile-uniform
// conditions before it).
bool workgroupDilatedActive(Tile t, Surface s) {
    if (gl_LocalInvocationIndex == 0u) s_gate = dilatedActive(t, s) ? 1u : 0u;
    barrier();
    return s_gate != 0u;
}

// What one texel's flow does this step, from the previous step only. Used for
// the texel itself and for the upstream texel of the transport gather.
struct FlowEval {
    bool has_downhill;
    vec2 dir;
    float wet; float pigment;
    float flow_scale; float runoff_alpha; float drip_head_alpha;
    float advected_wet; float advected_pigment; float advected_thickness;
    vec2 advected_src;
    float color_runoff_alpha; float color_drip_head_alpha;
    float carrier_gate; float pigment_gate;
};

FlowEval evalFlow(Surface s, int px, int py, bool oil) {
    FlowEval f;
    uint ti = texelIndex(s, px, py);
    vec4 st = state[ti];
    vec4 fl = flow_normal[ti];
    f.wet = st.x; f.pigment = st.y;
    f.flow_scale = 0.0; f.runoff_alpha = 0.0; f.drip_head_alpha = 0.0;
    f.advected_wet = 0.0; f.advected_pigment = 0.0; f.advected_thickness = 0.0;
    f.advected_src = vec2(px, py);
    f.dir = vec2(0.0);
    float flow_len = length(fl.xy);
    f.has_downhill = flow_len > 1e-6 && fl.z > 0.0;
    if (f.has_downhill) {
        float effective_slope = max(0.18, fl.z);
        float metric = clamp(1.0 + log(1.0 + max(0.0, flow_len)) * 0.85, 1.0, 4.0);
        f.dir = fl.xy / flow_len;
        f.flow_scale = min(6.0, s.runoff * effective_slope * metric * max(f.wet, 0.05) * pc.dt * 60.0 * 1.65);
        if (f.flow_scale > 0.001) {
            f.advected_src = vec2(px, py) - f.dir * f.flow_scale;
            vec3 adv = sampleStateXYZ(s, f.advected_src.x, f.advected_src.y);
            f.advected_wet = adv.x;
            f.advected_pigment = adv.y;
            f.advected_thickness = adv.z;
            f.runoff_alpha = clamp(f.flow_scale * (0.26 + (metric - 1.0) * 0.12), 0.0, 1.0);
            float drip_bias = clamp(f.advected_wet - f.wet * 0.25, 0.0, 1.0);
            f.drip_head_alpha = clamp(f.runoff_alpha * s.drip_head * (0.35 + drip_bias), 0.0, 1.0);
        }
    }
    float pigment_presence = max(f.pigment, f.advected_pigment);
    float wet_presence = max(f.wet, f.advected_wet);
    f.pigment_gate = oil ? clamp((pigment_presence - 0.03) / 0.18, 0.0, 1.0)
                         : clamp((pigment_presence - 0.008) / 0.10, 0.0, 1.0);
    f.carrier_gate = oil ? f.pigment_gate
                         : clamp(f.pigment_gate * 0.7 + wet_presence * 0.45, 0.0, 1.0);
    f.color_runoff_alpha = f.runoff_alpha * f.carrier_gate;
    f.color_drip_head_alpha = f.drip_head_alpha * f.carrier_gate;
    return f;
}

// Fast pre-check for downstream gather: decides whether `cand` transports and
// targets `target` using only cand's own state + flow_normal (2 loads),
// avoiding bilinear advection loads for non-matching candidates.
bool candTargetsTexel(Surface s, ivec2 cand, ivec2 target) {
    uint ti = texelIndex(s, cand.x, cand.y);
    vec4 fl = flow_normal[ti];
    float flow_len = length(fl.xy);
    if (flow_len <= 1e-6 || fl.z <= 0.0) return false;
    float wet = state[ti].x;
    float effective_slope = max(0.18, fl.z);
    float metric = clamp(1.0 + log(1.0 + max(0.0, flow_len)) * 0.85, 1.0, 4.0);
    float flow_scale = min(6.0, s.runoff * effective_slope * metric * max(wet, 0.05) * pc.dt * 60.0 * 1.65);
    if (flow_scale <= 0.02) return false;
    float runoff_alpha = clamp(flow_scale * (0.26 + (metric - 1.0) * 0.12), 0.0, 1.0);
    if (runoff_alpha <= 0.01) return false;
    float trail = min(s.brush_radius_px * 0.6 + 2.0,
                      max(flow_scale * 0.95, s.brush_radius_px * clamp(wet, 0.15, 1.0) * 0.22));
    vec2 dir = fl.xy / flow_len;
    ivec2 tgt = clamp(ivec2(round(vec2(cand) + dir * trail)),
                      ivec2(0), ivec2(int(s.width) - 1, int(s.height) - 1));
    return tgt == target;
}

void tickTexel(Surface s, int px, int py) {
    bool oil = (s.flags & SURFACE_OIL) != 0u;
    uint ti = texelIndex(s, px, py);
    vec4 st = state[ti];
    vec4 cur = unpackColor(color[ti]);
    FlowEval f = evalFlow(s, px, py, oil);

    vec4 dst = cur;
    float next_pigment = st.y;
    float next_thickness = st.z;
    float next_wet = st.x;

    if (st.x > 0.001 || f.advected_wet > 0.001) {
        vec4 advected_pixel = f.flow_scale > 0.001 ? sampleColor(s, f.advected_src.x, f.advected_src.y) : cur;
        float pigment_presence = max(st.y, f.advected_pigment);
        float mix_alpha = clamp(s.diffusion * st.x *
            (oil ? (0.10 + f.pigment_gate * 0.90) : (0.22 + f.carrier_gate * 0.78)) * pc.dt * 60.0, 0.0, 1.0);

        vec3 sum = vec3(0.0); float sum_w = 0.0;
        if (mix_alpha > 0.015) {
            for (int oy = -1; oy <= 1; ++oy) {
                for (int ox = -1; ox <= 1; ++ox) {
                    uint si = texelIndex(s, px + ox, py + oy);
                    vec4 sst = state[si];
                    vec4 sp = unpackColor(color[si]);
                    // Coverage-weighted: pigment can reach a texel a step before
                    // its colour does (rgb still 0), which mixed in black.
                    float w = sst.y * (0.10 + sst.x) * (sp.a / 255.0);
                    if (w <= 0.0005) continue;
                    sum += vec3(srgbToLinear01(sp.r / 255.0), srgbToLinear01(sp.g / 255.0),
                                srgbToLinear01(sp.b / 255.0)) * w;
                    sum_w += w;
                }
            }
        }

        if (f.color_runoff_alpha > 0.001) {
            dst = carryPaint(dst, advected_pixel, f.color_runoff_alpha);
            if (f.color_drip_head_alpha > 0.001) {
                dst = carryPaint(dst, advected_pixel, f.color_drip_head_alpha);
            }
            liftLayerAlpha(dst, max(st.y, f.advected_pigment), max(st.x, f.advected_wet),
                           advected_pixel.a / 255.0, max(f.color_runoff_alpha, f.color_drip_head_alpha));
        }
        // Runoff redistributes relief without making a taller ridge than
        // either contributing texel, including relief from older settings.
        float retained_height = next_thickness *
                                (1.0 - f.color_runoff_alpha * (oil ? 0.10 : 0.28));
        float carried_height = f.advected_thickness * f.color_runoff_alpha * (oil ? 0.55 : 1.0);
        next_thickness = min(retained_height + carried_height,
                             max(next_thickness, f.advected_thickness));
        next_pigment = clamp(max(st.y * (oil ? 0.985 : 0.992),
                                 f.advected_pigment * (oil ? f.color_runoff_alpha : (0.28 + f.color_runoff_alpha * 0.72))) -
                             pc.dt * (oil ? (0.10 + s.absorption * 0.20) : (0.06 + s.absorption * 0.12)),
                             0.0, 1.0);
        if (sum_w > 0.0) {
            vec3 avg = sum / sum_w;
            vec3 avg255 = vec3(floor(linearToSrgb01(avg.r) * 255.0 + 0.5),
                               floor(linearToSrgb01(avg.g) * 255.0 + 0.5),
                               floor(linearToSrgb01(avg.b) * 255.0 + 0.5));
            dst = carryPaint(dst, vec4(avg255, 255.0), mix_alpha);
            liftLayerAlpha(dst, max(next_pigment, pigment_presence), max(st.x, f.advected_wet), 1.0, mix_alpha);
            float thickness_mix_alpha = clamp(mix_alpha * 0.32, 0.0, 1.0);
            float local_target = clamp(max(st.z, f.advected_thickness * (0.55 + f.color_runoff_alpha * 0.25)), 0.0, 1.0);
            next_thickness = clamp(next_thickness + (local_target - next_thickness) * thickness_mix_alpha, 0.0, 1.0);
        }
        float absorbed = s.absorption * max(st.x, f.advected_wet) * pc.dt * 0.7;
        next_thickness = max(0.0, next_thickness - absorbed * 0.35);
        next_wet = max(0.0, max(st.x, f.advected_wet * f.runoff_alpha) - (pc.dt / s.lifetime) - absorbed);
    }

    // Downstream transport, gathered: find the upstream texel whose CPU target
    // is this texel. The flow direction is piecewise constant per triangle, so
    // the search walks back along this texel's own direction, one texel at a
    // time up to the longest trail the CPU allows (brush_radius_px * 0.6 + 2).
    // ★ The step length must NOT come from this texel's own trail estimate: a
    // dry texel ahead of a stain has a ~0.3 px trail, so a search seeded by it
    // never leaves the texel and the wet front can never advance.
    if (f.has_downhill) {
        ivec2 self_xy = ivec2(px, py);
        int max_back = min(int(ceil(s.brush_radius_px * 0.6 + 2.0)), 12);
        for (int k = 1; k <= max_back; ++k) {
            ivec2 cand = clamp(ivec2(round(vec2(px, py) - f.dir * float(k))),
                               ivec2(0), ivec2(int(s.width) - 1, int(s.height) - 1));
            if (cand == self_xy) continue;
            if (!candTargetsTexel(s, cand, self_xy)) continue;
            FlowEval fq = evalFlow(s, cand.x, cand.y, oil);
            if (fq.wet > 0.001 || fq.advected_wet > 0.001) {
                vec4 source_px = unpackColor(color[texelIndex(s, cand.x, cand.y)]);
                float transport_alpha = clamp(fq.runoff_alpha * (oil ? 0.24 : 0.55) +
                                              fq.drip_head_alpha * (oil ? 0.12 : 0.35), 0.0, 1.0);
                float transported_wet = max(fq.wet * (oil ? (0.18 + transport_alpha * 0.08) : (0.55 + transport_alpha * 0.25)),
                                            fq.advected_wet * fq.runoff_alpha * (oil ? 0.32 : 1.0));
                float transported_pigment = clamp(max(
                    fq.pigment * (oil ? (0.58 + transport_alpha * 0.22) : (0.44 + transport_alpha * 0.28)),
                    fq.advected_pigment * (oil ? fq.color_runoff_alpha : (0.24 + fq.color_runoff_alpha * 0.76))), 0.0, 1.0);
                float pigment_transport_alpha = clamp(oil
                    ? (transport_alpha * (0.24 + transported_pigment * 0.76) + fq.color_runoff_alpha * 0.08) *
                          clamp((transported_pigment - 0.015) / 0.22, 0.0, 1.0)
                    : transport_alpha * (0.18 + transported_pigment * 0.82), 0.0, 1.0);
                if (pigment_transport_alpha > 0.001) {
                    dst = carryPaint(dst, source_px, pigment_transport_alpha);
                    liftLayerAlpha(dst, transported_pigment, transported_wet, source_px.a / 255.0, pigment_transport_alpha);
                }
                next_wet = max(next_wet, transported_wet * (0.16 + transported_pigment * 0.84));
                next_pigment = max(next_pigment, transported_pigment * (0.70 + pigment_transport_alpha * 0.20));
                break;
            }
        }
    }

    // Hidden picture: the reveal is permanent, never advected, and builds
    // gradually while wet paint sits on the texel (no instant 1-pop snap).
    float revealed = st.w;
    if (pictureOn(s)) {
        uint pic = pictureTexel(ti);
        uint kind = pictureKind(pic);
        float target = 0.0;
        if (kind == 2u) {
            target = pictureRevealTarget(s, pic, dst);
        } else if (kind == 1u) {
            target = smoothstep(0.10, 0.85, clamp(dst.a / 255.0, 0.0, 1.0));
        }
        if (target > revealed) {
            float rate = clamp(pc.dt * (0.5 + 1.5 * clamp(st.x, 0.0, 1.0)), 0.0, 0.20);
            revealed = min(target, revealed + (target - revealed) * rate);
            if (target - revealed < 0.02) revealed = target;
        }
    }
    color_scratch[ti] = packColor(dst);
    state_scratch[ti] = cleanState(vec4(next_wet, next_pigment, next_thickness, revealed));
}

void tickTile(uint tile_index) {
    Tile t = tiles[tile_index];
    if (t.valid_texels == 0u) return;
    Surface s = surfaces[t.surface];
    if (!workgroupDilatedActive(t, s)) return;
    for (uint k = 0u; k < TEXELS_PER_THREAD; ++k) {
        int x, y; tileTexel(t, k, x, y);
        if (!inSurface(s, x, y)) continue;
        tickTexel(s, x, y);
    }
    if (gl_LocalInvocationIndex == 0u) {
        atomicAdd(stats[t.surface * STATS_STRIDE + ST_TICKED_TILES], 1u);
    }
}

// ── RESOLVE / composite ─────────────────────────────────────────────────────

uint composite(uint base_packed, vec4 paint) {
    float a = clamp(paint.a / 255.0, 0.0, 1.0);
    if (a <= 0.0) return base_packed;
    vec4 b = unpackColor(base_packed);
    if (a >= 1.0) return packColor(vec4(paint.rgb, b.a));
    vec3 o;
    for (int c = 0; c < 3; ++c) {
        float bl = srgbToLinear01(b[c] / 255.0);
        float pl = srgbToLinear01(paint[c] / 255.0);
        o[c] = floor(linearToSrgb01(mix(bl, pl, a)) * 255.0 + 0.5);
    }
    return packColor(vec4(o, b.a));
}

// The picture's opacity at a picture texel (kind 1 or 2) and the paint left
// over it - shared by the composite and the overlay output.
float pictureAmount(Surface s, uint kind, float pic_alpha, inout vec4 layer, float revealed) {
    float amount = pic_alpha / 255.0;
    if (kind == 2u) {
        float hint = float((s.flags >> 24u) & 255u) / 255.0;
        amount *= clamp(max(revealed, hint), 0.0, 1.0);
        layer.a *= 1.0 - clamp(revealed, 0.0, 1.0);   // revealed area shows the clean picture
    } else {
        // kind 1: flags bits 8..15 = outline opacity while not revealed
        float outline = float((s.flags >> 8u) & 255u) / 255.0;
        amount *= clamp(max(outline, revealed), 0.0, 1.0);
        // ★ Paint gives way only as far as the reveal CHANGED what is visible
        //   (2026-11-24). Any paint reveals kind-1 texels, and on a pastel
        //   wall most texels are kind 1: with the outline already fully shown
        //   (outline = 1) the old `1 - revealed` erased every splat a moment
        //   after it landed. Outline 0 (invisible picture): the picture pixel
        //   takes the paint's place; outline 1: the paint simply stays.
        layer.a *= 1.0 - clamp(revealed, 0.0, 1.0) * (1.0 - outline);
    }
    return amount;
}

// Base colour + hidden picture + paint layer. Without a picture (or on a texel
// that is not part of it) this is exactly composite(base, layer).
uint surfaceComposite(Surface s, uint ti, vec4 layer, float revealed) {
    uint base = base_color[ti];
    if (!pictureOn(s)) return composite(base, layer);
    uint pic = pictureTexel(ti);
    uint kind = pictureKind(pic);
    if (kind == 0u) return composite(base, layer);
    vec4 b = unpackColor(base);
    vec4 p = unpackColor(pic);
    float amount = pictureAmount(s, kind, p.a, layer, revealed);
    vec3 o;
    for (int c = 0; c < 3; ++c) {
        float bl = srgbToLinear01(b[c] / 255.0);
        float pl = srgbToLinear01(p[c] / 255.0);
        o[c] = floor(linearToSrgb01(mix(bl, pl, amount)) * 255.0 + 0.5);
    }
    return composite(packColor(vec4(o, b.a)), layer);
}

// Overlay output: picture then paint, each over what is below, premultiplied in
// linear light. Over an opaque base b the renderer's b*(1-a)+rgb is exactly
// surfaceComposite's mix(mix(b, picture, ap), paint, a).
uint overlayComposite(Surface s, uint ti, vec4 layer, float revealed) {
    float ap = 0.0;
    vec3 pic = vec3(0.0);
    if (pictureOn(s)) {
        uint packed_pic = pictureTexel(ti);
        uint kind = pictureKind(packed_pic);
        if (kind != 0u) {
            vec4 p = unpackColor(packed_pic);
            ap = pictureAmount(s, kind, p.a, layer, revealed);
            for (int c = 0; c < 3; ++c) pic[c] = srgbToLinear01(p[c] / 255.0);
        }
    }
    float a = clamp(layer.a / 255.0, 0.0, 1.0);
    if (ap <= 0.0) {
        if (a <= 0.0) return 0u;
        if (a >= 1.0) return packColor(vec4(layer.rgb, 255.0));
    }
    float alpha = a + ap * (1.0 - a);
    vec3 o;
    for (int c = 0; c < 3; ++c) {
        float premul = srgbToLinear01(layer[c] / 255.0) * a + pic[c] * ap * (1.0 - a);
        o[c] = floor(linearToSrgb01(clamp(premul, 0.0, 1.0)) * 255.0 + 0.5);
    }
    return packColor(vec4(o, floor(alpha * 255.0 + 0.5)));
}

// What the output page holds for a texel: the composite over the base, or the
// premultiplied overlay a renderer puts over a tiled base.
uint surfaceOutput(Surface s, uint ti, vec4 layer, float revealed) {
    if ((s.flags & SURFACE_OVERLAY) != 0u) return overlayComposite(s, ti, layer, revealed);
    return surfaceComposite(s, ti, layer, revealed);
}

void markDirty(Tile t) {
    uint base = t.surface * STATS_STRIDE;
    atomicMin(stats[base + ST_DIRTY_MIN_X], t.tx);
    atomicMin(stats[base + ST_DIRTY_MIN_Y], t.ty);
    atomicMax(stats[base + ST_DIRTY_MAX_X], t.tx);
    atomicMax(stats[base + ST_DIRTY_MAX_Y], t.ty);
}

void resolveTile(uint tile_index) {
    Tile t = tiles[tile_index];
    if (t.valid_texels == 0u) return;
    Surface s = surfaces[t.surface];
    if (!workgroupDilatedActive(t, s)) return;
    uint lid = gl_LocalInvocationIndex;
    if (lid == 0u) s_flag = 0u;
    barrier();
    bool wet = false;
    uint changed = 0u;
    for (uint k = 0u; k < TEXELS_PER_THREAD; ++k) {
        int x, y; tileTexel(t, k, x, y);
        if (!inSurface(s, x, y)) continue;
        uint ti = texelIndex(s, x, y);
        vec4 st = cleanState(state_scratch[ti]);
        uint c = color_scratch[ti];
        // What the channel planes read: colour + wetness (own tile), and
        // thickness + coverage (normals of the neighbourhood).
        vec4 old_st = state[ti];
        uint old_c = color[ti];
        if (c != old_c || st.x != old_st.x || st.w != old_st.w) changed |= CHANGED_CONTENT;
        if (st.z != old_st.z || (c >> 24u) != (old_c >> 24u)) changed |= CHANGED_HEIGHT;
        if (st != old_st) state[ti] = st;
        if (c != old_c) color[ti] = c;
        out_color[ti] = surfaceOutput(s, ti, unpackColor(c), st.w);
        if (st.x > 0.001) wet = true;
    }
    if (wet) atomicOr(s_flag, 1u);
    if (changed != 0u) atomicOr(s_flag, changed << 1u);
    barrier();
    if (lid == 0u) {
        if ((s_flag & 1u) != 0u) tile_flags[2u * tile_index + 1u] = 1u;
        uint bits = s_flag >> 1u;
        if (bits != 0u) markTileChanged(tile_index, bits);
        markDirty(t);
    }
}

// ── ROTATE / CONSUME / COVERAGE / RESET ─────────────────────────────────────

#include "paint_wet_channels.glsl"

void rotateTile(uint tile_index) {
    if (tile_index >= pc.tile_count) return;
    uint next = tile_flags[2u * tile_index + 1u];
    tile_flags[2u * tile_index] = next;
    tile_flags[2u * tile_index + 1u] = 0u;
    // After CHANNELS read them; stamps of the frames until the next step set
    // them again.
    if (changedBitsAvailable()) tile_flags[tileChangedIndex(tile_index)] = 0u;
    if (next != 0u) {
        atomicAdd(stats[tiles[tile_index].surface * STATS_STRIDE + ST_ACTIVE_TILES], 1u);
    }
}

void coverageTile(uint tile_index) {
    Tile t = tiles[tile_index];
    if (t.valid_texels == 0u) return;
    Surface s = surfaces[t.surface];
    uint lid = gl_LocalInvocationIndex;
    if (lid < 4u) { s_sum[lid] = 0u; s_pic[lid] = 0u; }
    if (lid == 0u) { s_count = 0u; s_flag = 0u; }
    barrier();
    uint covered = 0u, valid = 0u, wet = 0u;
    uint roughness_changed = 0u, normal_changed = 0u;
    uint picture_texels = 0u, picture_revealed = 0u;
    const bool picture = pictureOn(s);
    uvec3 sum = uvec3(0u);
    for (uint k = 0u; k < TEXELS_PER_THREAD; ++k) {
        int x, y; tileTexel(t, k, x, y);
        if (!inSurface(s, x, y)) continue;
        uint ti = texelIndex(s, x, y);
        if (pos_valid[ti].w < 0.5 || pos_valid[ti].w > 1.5) continue;   // covered texels only
        ++valid;
        if (picture && pictureKind(pictureTexel(ti)) == 2u) {
            ++picture_texels;
            if (state[ti].w >= 0.5) ++picture_revealed;
        }
        vec4 c = unpackColor(color[ti]);
        if (c.a >= 127.5) {
            ++covered;
            sum += uvec3(c.rgb + 0.5);
        }
        if (state[ti].x > 0.001) ++wet;
        if (pc._p0 != 0u) {
            uint r_out = out_color[pc._p0 + ti];
            uint r_src = sourceChannel(1u, ti);
            if (r_out != r_src) {
                vec3 r = abs(unpackColor(r_out).rgb - unpackColor(r_src).rgb);
                if (max(max(r.x, r.y), r.z) > 1.0) ++roughness_changed;
            }
            uint n_out = out_color[3u * pc._p0 + ti];
            uint n_src = sourceChannel(3u, ti);
            if (n_out != n_src) {
                vec3 n = abs(unpackColor(n_out).rgb - unpackColor(n_src).rgb);
                if (max(max(n.x, n.y), n.z) > 1.0) ++normal_changed;
            }
        }
    }
    if (covered != 0u) {
        atomicAdd(s_count, covered);
        atomicAdd(s_sum[0], sum.r); atomicAdd(s_sum[1], sum.g); atomicAdd(s_sum[2], sum.b);
    }
    if (valid != 0u) atomicAdd(s_flag, valid);
    if (wet != 0u) atomicAdd(s_sum[3], wet);
    if (picture_texels != 0u) atomicAdd(s_pic[0], picture_texels);
    if (picture_revealed != 0u) atomicAdd(s_pic[1], picture_revealed);
    if (roughness_changed != 0u) atomicAdd(s_pic[2], roughness_changed);
    if (normal_changed != 0u) atomicAdd(s_pic[3], normal_changed);
    barrier();
    if (lid == 0u) {
        uint base = t.surface * STATS_STRIDE;
        if (s_count != 0u) {
            atomicAdd(stats[base + ST_COVERED_TEXELS], s_count);
            atomicAdd(stats[base + ST_SUM_R], s_sum[0]);
            atomicAdd(stats[base + ST_SUM_G], s_sum[1]);
            atomicAdd(stats[base + ST_SUM_B], s_sum[2]);
        }
        if (s_flag != 0u) atomicAdd(stats[base + ST_VALID_TEXELS], s_flag);
        if (s_sum[3] != 0u) atomicAdd(stats[base + ST_WET_TEXELS], s_sum[3]);
        if (s_pic[0] != 0u) atomicAdd(stats[base + ST_PICTURE_TEXELS], s_pic[0]);
        if (s_pic[1] != 0u) atomicAdd(stats[base + ST_PICTURE_REVEALED], s_pic[1]);
        if (s_pic[2] != 0u) atomicAdd(stats[base + ST_ROUGHNESS_TEXELS], s_pic[2]);
        if (s_pic[3] != 0u) atomicAdd(stats[base + ST_NORMAL_TEXELS], s_pic[3]);
    }
}

void resetTile(uint tile_index) {
    Tile t = tiles[tile_index];
    Surface s = surfaces[t.surface];
    const bool init_only = (pc._p1 & RESET_INIT_ONLY_BIT) != 0u;
    for (uint k = 0u; k < TEXELS_PER_THREAD; ++k) {
        int x, y; tileTexel(t, k, x, y);
        if (!inSurface(s, x, y)) continue;
        uint ti = texelIndex(s, x, y);
        color[ti] = 0u;
        state[ti] = vec4(0.0);
        color_scratch[ti] = 0u;
        state_scratch[ti] = vec4(0.0);
        if (!init_only) {
            out_color[ti] = (pictureOn(s) || (s.flags & SURFACE_OVERLAY) != 0u)
                ? surfaceOutput(s, ti, vec4(0.0), 0.0) : base_color[ti];
            if (pc._p0 != 0u) {
                for (uint channel=1u;channel<=3u;++channel)
                    out_color[channel*pc._p0+ti] = sourceChannel(channel,ti);
                // Bit 1 opts into the five-output atlas. Old hosts pass only 0/1,
                // so they must never access this extra output/source plane.
                if ((pc._p1 & 2u) != 0u) {
                    out_color[4u * pc._p0 + ti] = (s.flags & SURFACE_REVEAL_OPACITY) != 0u
                        ? 0u : 0xFFFFFFFFu;
                }
            }
        }
    }
    if (gl_LocalInvocationIndex == 0u) {
        tile_flags[2u * tile_index] = 0u;
        tile_flags[2u * tile_index + 1u] = 0u;
        if (!init_only) {
            // Its own planes are written above; the neighbours' normals read its
            // (now flat) height across the edge.
            markTileChanged(tile_index, CHANGED_CONTENT | CHANGED_HEIGHT);
            markDirty(t);
        }
    }
}

void main() {
    uint wg = gl_WorkGroupID.x;
    const uint mode = (RT_PAINT_MODE == 0xFFFFFFFFu) ? pc.mode : RT_PAINT_MODE;
    if (mode == MODE_COMPACT_CHANNELS) {
        compactChannelTiles();
        return;
    }
    if (mode == MODE_ROTATE) { rotateTile(gl_GlobalInvocationID.x); return; }
    if (mode == MODE_CONSUME) {
        if (gl_GlobalInvocationID.x == 0u) { counter[0] = 0u; counter[1] = 0u; }
        return;
    }
    // RESET of a tile RANGE: source_count (unused by this mode otherwise) is the
    // first tile, 0 for the whole atlas. One surface whose base colour changed
    // resets and republishes only its own tiles (2026-11-19: resetting all 20
    // surfaces of a game room re-read ~270 MB per colour step into the second
    // VkDevice of the Studio preview).
    if (mode == MODE_RESET) {
        uint t = wg + pc.source_count;
        if (t < pc.tile_count) resetTile(t);
        return;
    }
    if (wg >= pc.tile_count) return;
    if (mode == MODE_STAMP) stampTile(wg);
    else if (mode == MODE_TICK) tickTile(wg);
    else if (mode == MODE_RESOLVE) {
        if ((pc._p1 & COMPACT_CHANNELS) != 0u && gl_GlobalInvocationID.x == 0u) {
            resetChannelList();
        }
        resolveTile(wg);
    }
    else if (mode == MODE_COVERAGE) coverageTile(wg);
    else if (mode == MODE_CHANNELS || mode == MODE_CHANNELS_LIST) {
        bool listed = mode == MODE_CHANNELS_LIST;
        bool edited = !listed && (pc._p1 & CHANNEL_RANGE_BIT) != 0u;
        uint tile_index = listed ? tile_flags[channelListBase() + wg]
                                 : wg + (edited ? pc.source_count : 0u);
        if (tile_index < pc.tile_count) channelTile(tile_index, edited);
    }
    else if (mode == MODE_SEED_HEIGHT) {
        uint tile_index = wg + ((pc._p1 & CHANNEL_RANGE_BIT) != 0u ? pc.source_count : 0u);
        if (tile_index < pc.tile_count) seedHeightTile(tile_index);
    }
}
