#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform PC {
    int nx; int ny; int nz;
    float dt;
    float max_temperature;
} pc;
layout(set=0,binding=0) buffer Density { float density[]; };
layout(set=0,binding=1) buffer Temperature { float temperature[]; };
layout(set=0,binding=2) buffer Fuel { float fuel[]; };
layout(set=0,binding=3) buffer Interaction { float flame[]; };
layout(set=0,binding=4) readonly buffer Solid { float solid[]; };
layout(set=0,binding=5) readonly buffer SrcDensity { float src_d[]; };
layout(set=0,binding=6) readonly buffer SrcTemperature { float src_t[]; };
layout(set=0,binding=7) readonly buffer SrcFuel { float src_f[]; };
layout(set=0,binding=8) readonly buffer SrcFlame { float src_flame[]; };
layout(set=0,binding=9) readonly buffer SrcBand { float src_band[]; };
layout(set=0,binding=10) readonly buffer SrcIgnition { float src_ignition[]; };
layout(set=0,binding=11) readonly buffer SrcFuelCapacity { float src_capacity[]; };
layout(set=0,binding=12) readonly buffer SrcBurnRate { float src_burn[]; };
// First cell-count floats are filtered surface temperature; the second plane
// stores remaining combustible material (-1 means not initialized/contact lost).
layout(set=0,binding=13) buffer SurfaceState { float surface_state[]; };
uint idx(ivec3 p){return uint(p.x+p.y*pc.nx+p.z*pc.nx*pc.ny);}
bool inside(ivec3 p){return all(greaterThanEqual(p,ivec3(0)))&&all(lessThan(p,ivec3(pc.nx,pc.ny,pc.nz)));}
void main(){
    uint id=gl_GlobalInvocationID.x,count=uint(pc.nx*pc.ny*pc.nz);
    if(id>=count||solid[id]>.5)return;
    ivec3 p=ivec3(int(id%uint(pc.nx)),int((id/uint(pc.nx))%uint(pc.ny)),int(id/uint(pc.nx*pc.ny)));
    const ivec3 dirs[6]=ivec3[6](ivec3(1,0,0),ivec3(-1,0,0),ivec3(0,1,0),ivec3(0,-1,0),ivec3(0,0,1),ivec3(0,0,-1));
    vec4 rate=vec4(0);
    vec3 ignition_material=vec3(0);
    for(int d=0;d<6;++d)for(int step=1;step<=8;++step){
        ivec3 q=p+dirs[d]*step;if(!inside(q))break;uint s=idx(q);
        if(solid[s]>.5){
            float band=clamp(src_band[s],.25,8.0);
            if(float(step)<=band){
                float w=1.0-(float(step)-1.0)/max(band,1.0);
                rate=max(rate,vec4(src_d[s],src_t[s],src_f[s],src_flame[s])*w);
                if(src_ignition[s]>0.0){
                    // Threshold is a material property, not a falloff-weighted
                    // source rate. Weighting it would make the outer band ignite
                    // more easily than the actual wall.
                    ignition_material.x=max(ignition_material.x,src_ignition[s]);
                    ignition_material.y=max(ignition_material.y,src_capacity[s]*w);
                    ignition_material.z=max(ignition_material.z,src_burn[s]*w);
                }
            }
            break;
        }
    }
    density[id]=max(0.0,density[id]+rate.x*pc.dt);
    temperature[id]=clamp(temperature[id]+rate.y*pc.dt,0.0,pc.max_temperature);
    fuel[id]=max(0.0,fuel[id]+rate.z*pc.dt);
    flame[id]=max(flame[id],rate.w*pc.dt);

    uint fuel_state_id=count+id;
    if(ignition_material.x<=0.0||ignition_material.y<=0.0||ignition_material.z<=0.0){
        // Contact disappeared (important for animated colliders): cool quickly
        // and make a future surface at this grid cell start with fresh material.
        surface_state[id]=max(0.0,surface_state[id]-2.0*pc.dt);
        surface_state[fuel_state_id]=-1.0;
        return;
    }

    float surface_temperature=max(0.0,surface_state[id]);
    float remaining=surface_state[fuel_state_id];
    if(remaining<0.0) remaining=ignition_material.y;

    // First-order thermal inertia: the wall follows nearby gas temperature but
    // neither ignites from a one-frame spike nor stores energy forever.
    float transfer=1.0-exp(-3.0*pc.dt);
    surface_temperature=mix(surface_temperature,temperature[id],transfer);
    surface_temperature=max(0.0,surface_temperature-0.08*pc.dt);

    if(surface_temperature>=ignition_material.x&&remaining>0.0){
        float burned=min(remaining,ignition_material.z*pc.dt);
        remaining-=burned;
        // Pyrolysis releases vapour into the adjacent open cell. The regular
        // combustion pass then consumes it, so heat/smoke remain domain-driven.
        fuel[id]+=burned;
        density[id]+=burned*0.30;
        temperature[id]=min(
            pc.max_temperature,
            temperature[id]+burned*max(ignition_material.x,1.0));
        flame[id]=max(flame[id],clamp(ignition_material.z*0.25,0.0,1.0));
    }
    surface_state[id]=surface_temperature;
    surface_state[fuel_state_id]=remaining;
}
