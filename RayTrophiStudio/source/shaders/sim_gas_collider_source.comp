#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform PC {
    int nx; int ny; int nz;
    float dt;
    float max_temperature;
} pc;
layout(set=0,binding=0) buffer Density { float density[]; };
layout(set=0,binding=1) buffer Temperature { float temperature[]; };
layout(set=0,binding=2) buffer Fuel { float fuel[]; };
layout(set=0,binding=3) buffer Interaction { float flame[]; };
layout(set=0,binding=4) readonly buffer Solid { float solid[]; };
layout(set=0,binding=5) readonly buffer SrcDensity { float src_d[]; };
layout(set=0,binding=6) readonly buffer SrcTemperature { float src_t[]; };
layout(set=0,binding=7) readonly buffer SrcFuel { float src_f[]; };
layout(set=0,binding=8) readonly buffer SrcFlame { float src_flame[]; };
layout(set=0,binding=9) readonly buffer SrcBand { float src_band[]; };
// Pyrolysis used to live here too, keeping its surface state in a cell-indexed
// buffer. It has moved to the Material State Field (sim_msf_*), which keeps that
// state on the OBJECT so char survives losing contact and can drive shading and
// geometry. What remains here is plain emission: a collider that vents smoke,
// heat, fuel or flame regardless of what it is made of.
uint idx(ivec3 p){return uint(p.x+p.y*pc.nx+p.z*pc.nx*pc.ny);}
bool inside(ivec3 p){return all(greaterThanEqual(p,ivec3(0)))&&all(lessThan(p,ivec3(pc.nx,pc.ny,pc.nz)));}
void main(){
    uint id=gl_GlobalInvocationID.x,count=uint(pc.nx*pc.ny*pc.nz);
    if(id>=count||solid[id]>.5)return;
    ivec3 p=ivec3(int(id%uint(pc.nx)),int((id/uint(pc.nx))%uint(pc.ny)),int(id/uint(pc.nx*pc.ny)));
    const ivec3 dirs[6]=ivec3[6](ivec3(1,0,0),ivec3(-1,0,0),ivec3(0,1,0),ivec3(0,-1,0),ivec3(0,0,1),ivec3(0,0,-1));
    vec4 rate=vec4(0);
    for(int d=0;d<6;++d)for(int step=1;step<=8;++step){
        ivec3 q=p+dirs[d]*step;if(!inside(q))break;uint s=idx(q);
        if(solid[s]>.5){
            float band=clamp(src_band[s],.25,8.0);
            if(float(step)<=band){
                float w=1.0-(float(step)-1.0)/max(band,1.0);
                rate=max(rate,vec4(src_d[s],src_t[s],src_f[s],src_flame[s])*w);
            }
            break;
        }
    }
    density[id]=max(0.0,density[id]+rate.x*pc.dt);
    temperature[id]=clamp(temperature[id]+rate.y*pc.dt,0.0,pc.max_temperature);
    fuel[id]=max(0.0,fuel[id]+rate.z*pc.dt);
    flame[id]=max(flame[id],rate.w*pc.dt);
}
