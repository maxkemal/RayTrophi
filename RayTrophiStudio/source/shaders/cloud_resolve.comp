#version 460
#extension GL_GOOGLE_include_directive : require
// RayFusion clouds, pass 2 of 2: the RESOLVE (full resolution of the cloud
// target). cloud_raster.comp marched 1 of every N x N pixels; here every pixel
// reprojects the full-resolution history by the cloud depth into the previous
// camera, and
//   - a pixel marched THIS frame blends its fresh sample in;
//   - every other pixel keeps its history, clipped in motion to what the
//     surrounding fresh samples allow (no ghosting);
//   - where no history exists (first frame, off-screen) it takes the fresh
//     grid upsampled.
// The flash is not accumulated: it is the fresh grid's, upsampled, every frame.
//
// Why a full-resolution history: realtime_resolution_divisor = 2 cost the same
// march but kept the history at half resolution, and its bilinear upscale
// "shook under wind drift" (AtmosphereClouds.h). Here the march is cheap and
// the image is not.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "cloud_raster_frame.glsl"
#include "cloud_interleave.glsl"

layout(set = 0, binding = 8) uniform sampler2D prevHistory;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D curHistory;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D cloudOut;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D cloudFresh;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D cloudFreshAux;

// History fetch with a 5-tap Catmull-Rom (Jimenez 2016). A bilinear fetch
// re-blurs the history every frame, and under long accumulation that
// compounds into soft, detail-less clouds.
vec4 sampleHistoryCatmullRom(vec2 uv) {
    vec2 size = vec2(textureSize(prevHistory, 0));
    vec2 pos = uv * size;
    vec2 c = floor(pos - 0.5) + 0.5;
    vec2 f = pos - c;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 tc0 = (c - 1.0) / size, tc3 = (c + 2.0) / size;
    vec2 tc12 = (c + w2 / w12) / size;
    vec4 r = textureLod(prevHistory, vec2(tc12.x, tc0.y), 0.0) * (w12.x * w0.y) +
             textureLod(prevHistory, vec2(tc0.x, tc12.y), 0.0) * (w0.x * w12.y) +
             textureLod(prevHistory, tc12, 0.0) * (w12.x * w12.y) +
             textureLod(prevHistory, vec2(tc3.x, tc12.y), 0.0) * (w3.x * w12.y) +
             textureLod(prevHistory, vec2(tc12.x, tc3.y), 0.0) * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    r /= max(wsum, 1e-4);
    // Bicubic overshoot: radiance >= 0, transmittance in [0, 1].
    return vec4(max(r.rgb, vec3(0.0)), clamp(r.a, 0.0, 1.0));
}

ivec2 freshClamp(ivec2 c) {
    return clamp(c, ivec2(0), ivec2(int(cloudInterleave.freshW) - 1, int(cloudInterleave.freshH) - 1));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    uvec2 sz = worldData.info.xy;
    if (px.x >= int(sz.x) || px.y >= int(sz.y)) return;
    int N = max(int(cloudInterleave.n), 1);
    ivec2 phase = ivec2(int(cloudInterleave.phaseX), int(cloudInterleave.phaseY));

    // Fresh sample c sits at pixel c * N + phase.
    vec2 f = (vec2(px - phase)) / float(N);
    ivec2 nearest = freshClamp(ivec2(floor(f + 0.5)));
    bool fresh = all(equal(nearest * N + phase, px));

    vec4 cur;
    vec4 aux;
    if (fresh) {
        cur = imageLoad(cloudFresh, nearest);
        aux = imageLoad(cloudFreshAux, nearest);
    } else {
        ivec2 c0 = ivec2(floor(f));
        vec2 w = f - vec2(c0);
        ivec2 a00 = freshClamp(c0), a10 = freshClamp(c0 + ivec2(1, 0));
        ivec2 a01 = freshClamp(c0 + ivec2(0, 1)), a11 = freshClamp(c0 + ivec2(1, 1));
        cur = mix(mix(imageLoad(cloudFresh, a00), imageLoad(cloudFresh, a10), w.x),
                  mix(imageLoad(cloudFresh, a01), imageLoad(cloudFresh, a11), w.x), w.y);
        vec3 flash = mix(mix(imageLoad(cloudFreshAux, a00).rgb, imageLoad(cloudFreshAux, a10).rgb, w.x),
                         mix(imageLoad(cloudFreshAux, a01).rgb, imageLoad(cloudFreshAux, a11).rgb, w.x), w.y);
        // Depth is not interpolated: averaging a cloud depth with "none" (-1)
        // would reproject the edge to a point in between.
        aux = vec4(flash, imageLoad(cloudFreshAux, nearest).a);
    }

    // Neighbourhood statistics for variance clipping: the 3x3 fresh samples
    // around this pixel (N pixels apart, so the window widens with N).
    vec4 m1 = vec4(0.0), m2 = vec4(0.0);
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            vec4 c = imageLoad(cloudFresh, freshClamp(nearest + ivec2(dx, dy)));
            m1 += c; m2 += c * c;
        }
    m1 /= 9.0;
    vec4 sigma = sqrt(max(m2 / 9.0 - m1 * m1, vec4(0.0)));
    vec4 lo = m1 - 1.25 * sigma, hi = m1 + 1.25 * sigma;

    vec4 outv = cur;
    if (worldData.camFwd.w > 0.5) {
        vec2 uv = (vec2(px) + 0.5) / vec2(sz);
        vec2 ndc = uv * 2.0 - 1.0;
        float tanH = worldData.camPos.w;
        vec3 d = normalize(worldData.camFwd.xyz +
                           worldData.camRight.xyz * (ndc.x * worldData.camRight.w * tanH) -
                           worldData.camUp.xyz * (ndc.y * tanH));
        float depth = aux.a;
        // Clouds at their weighted depth; clear sky reprojects by direction.
        // The cloud at this sample was, last frame, one wind step upwind.
        vec3 drift = vec3(worldData.camUp.w, 0.0, worldData.prevUp.w);
        bool drifting = dot(drift, drift) > 1e-6;
        vec3 v = depth > 0.0 ? (worldData.camPos.xyz + d * depth - drift - worldData.prevPos.xyz) : d;
        float z = dot(v, worldData.prevFwd.xyz);
        if (z > 1e-4) {
            float tp = worldData.prevPos.w;
            vec2 pn = vec2(dot(v, worldData.prevRight.xyz) / (z * tp * worldData.prevRight.w),
                           -dot(v, worldData.prevUp.xyz) / (z * tp));
            vec2 puv = pn * 0.5 + 0.5;
            if (all(greaterThanEqual(puv, vec2(0.0))) && all(lessThanEqual(puv, vec2(1.0)))) {
                vec4 hist = sampleHistoryCatmullRom(puv);
                // In motion the history is clipped to what this neighbourhood
                // can be (no ghosting) instead of trusting the noisy new
                // sample more (which flickered). Static: no clip, pure
                // accumulation, so the converged image stays noise-free.
                float motion = length((puv - uv) * vec2(sz));
                float clipW = clamp(motion / 0.5, 0.0, 1.0);
                if (drifting) clipW = max(clipW, 0.5);
                hist = mix(hist, clamp(hist, lo, hi), clipW);
                if (fresh) {
                    float a = mix(0.06, 0.15, clamp(motion / 4.0, 0.0, 1.0));
                    // Evolving sky (time advancing): the shape itself changes,
                    // so the history may only lag a few frames behind.
                    if (drifting) a = max(a, 0.2);
                    // In motion a pixel gets a fresh sample only every N^2
                    // frames: give that sample the weight of the N^2 it
                    // stands for. Static keeps the slow, noise-free blend.
                    if (clipW > 0.05 || drifting) a = 1.0 - pow(1.0 - a, float(N * N));
                    outv = mix(hist, cur, a);
                } else {
                    // Between refreshes an evolving shape drifts away from
                    // the history; the upsampled grid pulls it back slowly.
                    // Static: a gentle pull into the fresh neighbourhood
                    // clears what the drifting period left in pixels that
                    // will not be marched for N^2 - 1 frames (the "blocks
                    // when play stops"); a converged pixel is inside the
                    // range and does not move.
                    outv = drifting ? mix(hist, cur, 0.05) : mix(hist, clamp(hist, lo, hi), 0.25);
                }
            }
        }
    }
    imageStore(curHistory, px, outv);
    imageStore(cloudOut, px, vec4(outv.rgb + aux.rgb, outv.a));
}
