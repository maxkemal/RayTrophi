#version 450
// Material State Field — thermal / pyrolysis integration (gather half).
//
// One invocation per surface element (triangle centroid). Reads the gas
// temperature of the nearest OPEN cell, trades heat with it through a film,
// integrates the element's persistent state, and records how much combustible
// mass it released this step. The pyrolysis deposit goes through
// sim_msf_scatter; the film heat is added here to a signed per-cell
// accumulator (several elements share a cell, so it needs atomics) and folded
// into the gas by sim_msf_resolve.
//
// MSF is now the sole owner of pyrolysis; the voxel surface_state path is gone.
// See docs/NODE_SIMULATION_ARCHITECTURE_PLAN.md (Faz 2b).
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    ivec4 dim;           // nx, ny, nz, element_count
    vec4  origin_voxel;  // xyz = grid origin (world), w = voxel size
    vec4  material0;     // ignition_T, fuel_capacity, burn_rate, gas film W/(m^2 K)
    vec4  material1;     // body capacity J/(K m^2), char_rate, dt, max_temperature
    // melt_enthalpy_span = latent heat of fusion expressed as the normalized
    // temperature span whose energy equals it (L/c / kelvin_per_unit).
    vec4  material2;     // water_capacity_kg_m2, melt_normalized, melt_enthalpy_span, mass_capacity
    vec4  material3;     // reference_K, kelvin_per_unit, emissivity, convect fixed point
    vec4  material4;     // vapour molar kg/mol (0 = dry air), cell volume m^3, unused, unused
} pc;

layout(set=0, binding=0) readonly buffer Centers { vec4 centers[]; };  // xyz world, w area
// Two vec4 per element:
//   [2i+0] x=temperature y=fuel_remaining z=char w=surface water (kg/m^2)
//   [2i+1] x=released_this_step y=melt z=mass_loss w=transferred_mass
// Slot [2i+1] is what sim_msf_scatter consumes. melt/mass_loss are written by
// later phases; they are allocated now so the stride never changes again.
layout(set=0, binding=1)          buffer State   { vec4 state[]; };
layout(set=0, binding=2) readonly buffer GasTemperature { float gas_t[]; };
layout(set=0, binding=3) readonly buffer Solid          { float solid[]; };
// Flame level of the cell (0..1): how much of the gas radiates like a flame.
layout(set=0, binding=4) readonly buffer Flame          { float flame[]; };
// Signed normalized temperature change of the cell, in 1/material3.w units.
layout(set=0, binding=5)          buffer AccumConvect   { int accum_convect[]; };
// Condensable vapour per cell (kg). Only read when material4.x > 0; otherwise
// the temperature buffer is bound here as a never-read dummy.
layout(set=0, binding=6) readonly buffer Vapour         { float vapour[]; };

// The gas field holds the VIRTUAL temperature Tv. Same closed form as
// airKelvinFromVirtual (GasSaturation.cpp) and sim_gas_combustion.
float airFromVirtual(float tv_in, float m) {
    const float R = 8.314462, P = 101325.0, Ma = 0.028965;
    float tv = max(tv_in, 1.0);
    float mv = pc.material4.x;
    if (!(m > 0.0) || !(mv > 0.0) || !(pc.material4.y > 0.0)) return tv;
    float k = m * R / (mv * P * pc.material4.y);
    float denominator = Ma + tv * k * (Ma - mv);
    float t = tv * mv / Ma;
    if (denominator > 1.0e-12) {
        float mixed = tv * Ma / denominator;
        if (k * mixed < 1.0) t = mixed;
    }
    return max(t, 1.0);
}

uint idx(ivec3 p) { return uint(p.x + p.y * pc.dim.x + p.z * pc.dim.x * pc.dim.y); }
bool inside(ivec3 p) {
    return all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, pc.dim.xyz));
}

// Solid-aware trilinear sample of the gas temperature.
//
// WHY FILTERED: elements are texels, so many of them share one voxel. Reading
// the NEAREST cell gives every texel in that voxel the identical temperature and
// makes ignition an all-or-nothing per-voxel decision — the burn mark then breaks
// up into isolated specks that snap on and off at voxel boundaries, and the
// pattern reads as belonging to the world grid instead of to the surface.
// Interpolating gives neighbouring texels a smooth gradient, so the mark grows as
// a connected patch that follows the flame.
//
// Solid cells are EXCLUDED from the filter rather than contributing zero: they
// hold no gas, and averaging their zero in would cool every sample near a wall —
// which is exactly where the surface being simulated lives.
float sampleGasFiltered(vec3 local) {
    vec3 f = local - vec3(0.5);        // cell centres sit at integer + 0.5
    ivec3 b = ivec3(floor(f));
    vec3 t = f - vec3(b);
    float acc = 0.0, wsum = 0.0;
    for (int k = 0; k < 2; ++k)
    for (int j = 0; j < 2; ++j)
    for (int i = 0; i < 2; ++i) {
        ivec3 q = b + ivec3(i, j, k);
        if (!inside(q)) continue;
        uint s = idx(q);
        if (solid[s] > 0.5) continue;
        float w = (i == 0 ? 1.0 - t.x : t.x) *
                  (j == 0 ? 1.0 - t.y : t.y) *
                  (k == 0 ? 1.0 - t.z : t.z);
        acc += gas_t[s] * w;
        wsum += w;
    }
    return wsum > 1e-6 ? acc / wsum : -1.0;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.dim.w)) return;

    float h = pc.origin_voxel.w;
    if (h <= 0.0) return;

    vec3 local = (centers[id].xyz - pc.origin_voxel.xyz) / h;
    ivec3 p = ivec3(floor(local));

    // ★ OUTSIDE THIS DOMAIN: leave the state completely alone.
    //
    // This pass runs once per gas domain, over EVERY element of every MSF object
    // in the scene. An element standing in domain A is still walked by domain B's
    // dispatch, and before Phase 4 it fell into the cooling branch below — so a
    // second smoke box anywhere in the scene quietly cooled everything twice and
    // capped how hot anything could get. Invisible in a one-domain test scene,
    // which is exactly why it survived this long.
    //
    // Ambient relaxation for these elements belongs to sim_msf_ambient, which
    // runs once per frame and knows about the world, not about this box.
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, pc.dim.xyz))) return;

    // Filtered first: this is what makes the burn mark a connected patch rather
    // than per-voxel speckle.
    float gas = sampleGasFiltered(local);

    // The element sits ON the surface, so its own cell is often flagged solid and
    // the filter can come back empty. Then walk outward for the nearest open cell
    // — that is still the gas the surface exchanges heat with. The search radius
    // is deliberately short: a surface more than a few voxels from any open cell
    // is buried, not exposed.
    if (gas < 0.0) {
        const ivec3 dirs[6] = ivec3[6](ivec3(1,0,0), ivec3(-1,0,0),
                                       ivec3(0,1,0), ivec3(0,-1,0),
                                       ivec3(0,0,1), ivec3(0,0,-1));
        for (int step = 1; step <= 3 && gas < 0.0; ++step) {
            for (int d = 0; d < 6; ++d) {
                ivec3 q = p + dirs[d] * step;
                if (!inside(q)) continue;
                uint s = idx(q);
                if (solid[s] <= 0.5) gas = max(gas, gas_t[s]);
            }
        }
    }

    vec4 st = state[id * 2u];
    vec4 aux = state[id * 2u + 1u];
    aux.x = 0.0;  // released this step; scatter reads it, so it must not persist
    float dt = pc.material1.z;

    if (gas < 0.0) {
        // Inside the domain but buried: no open cell within reach, so there is no
        // gas to exchange heat with this step. Char and remaining fuel are KEPT —
        // that is the deliberate difference from the old voxel path, which reset
        // its remaining-material plane the moment contact was lost and so
        // silently un-burned an animated object.
        //
        // No cooling here either: sim_msf_ambient owns relaxation, and doing it
        // in both places would cool a buried surface at double rate.
        state[id * 2u] = st;
        state[id * 2u + 1u] = aux;
        return;
    }

    // ── Surface <-> air film (2026-10-19) ────────────────────────────────────
    // ★ This used to be `st.x = mix(st.x, gas, 1 - exp(-thermal_response*dt))`:
    // the surface FOLLOWED the air at 1-8 1/s whatever stood behind it, and the
    // air never felt it. A 0.1 m iron block inside a domain was pinned to the
    // room air (only its faces outside the box warmed), and a hot plate heated
    // nothing. Now two bodies trade energy:
    //   element  C_e = body capacity (rho c depth, J/(K m^2)) * area
    //   air      C_g = rho_air(T) c_air h^3 of the cell
    //   film     G   = (h_conv + flame * eps sigma (Tg^2+Ts^2)(Tg+Ts)) * area
    // The element moves by the exact two-body relaxation; the cell gets
    // exactly -C_e dTs. Paper still lights in a flame (thin body, radiation),
    // iron barely notices a draught.
    // ★ The air's REAL temperature (2026-10-19, P2): the field holds Tv, and in
    // a steam cell Tv is far above T (373 K steam reads ~600 K) - the film
    // used to heat a surface over boiling water as if it were a flame. The
    // exchange runs in T; the cell's Tv moves by dT * Tv/T.
    // The target cell is the scatter pass's open-cell search, so heat lands
    // where pyrolysis vents.
    int target = -1;
    {
        if (inside(p) && solid[idx(p)] <= 0.5) {
            target = int(idx(p));
        } else {
            const ivec3 dirs[6] = ivec3[6](ivec3(1,0,0), ivec3(-1,0,0),
                                           ivec3(0,1,0), ivec3(0,-1,0),
                                           ivec3(0,0,1), ivec3(0,0,-1));
            for (int step = 1; step <= 3 && target < 0; ++step) {
                for (int d = 0; d < 6; ++d) {
                    ivec3 q = p + dirs[d] * step;
                    if (!inside(q)) continue;
                    uint s = idx(q);
                    if (solid[s] <= 0.5) { target = int(s); break; }
                }
            }
        }
    }
    float area_e = max(centers[id].w, 0.0);
    float body = pc.material1.x * area_e;           // J/K
    if (target >= 0 && body > 0.0 && pc.material3.y > 0.0) {
        uint cell = uint(target);
        float kpu = pc.material3.y;
        float tv = max(1.0, pc.material3.x + gas * kpu);
        float m = pc.material4.x > 0.0 ? max(vapour[cell], 0.0) : 0.0;
        float tg = airFromVirtual(tv, m);
        float air = (tg - pc.material3.x) / kpu;
        float ts = max(1.0, pc.material3.x + st.x * kpu);
        const float SIGMA = 5.670374e-8;
        float fl = clamp(flame[cell], 0.0, 1.0);
        float film = pc.material0.w +
                     fl * pc.material3.z * SIGMA * (tg * tg + ts * ts) * (tg + ts);
        float g = film * area_e;                    // W/K
        // rho = P Ma / (R Tv) exactly, vapour or not; c_air 1005 J/(kg K).
        float cg = (353.06 / tv) * 1005.0 * h * h * h;
        // The element only sees its SHARE of the cell's air (its area over the
        // most surface a cell can hold, ~3 faces), so the many elements of one
        // cell can never drive the air past where they all agree.
        float cgs = max(cg * area_e / (3.0 * h * h), 1e-12);
        float decay = 1.0 - exp(-g * dt * (1.0 / body + 1.0 / cgs));
        float eq = (body * st.x + cgs * air) / (body + cgs);
        float ds = (eq - st.x) * decay;
        st.x += ds;
        // kelvin_per_unit cancels: both sides are in the same normalized unit.
        float dg = clamp(-body * ds / cg * (tv / tg), -1.0, 1.0);
        int fixed_dg = int(round(dg * pc.material3.w));
        if (fixed_dg != 0) atomicAdd(accum_convect[cell], fixed_dg);
    }
    st.x = min(st.x, pc.material1.w);

    // ── Surface water (2026-10-18) ───────────────────────────────────────────
    // The boiling-point clamp that used to sit here threw the incoming heat
    // away. The water now pays for itself: the host budget (stepSurfaceWater)
    // turns everything above 373 K into evaporation and takes the latent heat
    // back out of the surface, so the energy that "pinned" the temperature is
    // accounted for instead of deleted. Only the saturation is read here, to
    // throttle pyrolysis below.
    float water_capacity = max(pc.material2.x, 1e-6);
    float moisture = clamp(max(st.w, 0.0) / water_capacity, 0.0, 1.0);

    // ── Melting: a latent-heat ENERGY BUDGET (Phase 6b, reworked) ────────────
    // ★ Deliberately the SAME SHAPE as the moisture gate above, because it is the
    // same physics: a first-order phase change absorbs energy at a fixed
    // temperature. Water boiling pins the surface at 373 K; iron melting pins it
    // at 1811 K. Writing them differently would have been two models of one law.
    //
    // ★★ WHAT CHANGED, AND WHY IT MATTERS
    //
    // This used to advance the melt fraction at a RATE:
    //     melt += (T - T_melt) * melt_rate * dt
    // Two things were wrong with that, and both were visible in results:
    //   - The amount melted depended on how LONG the surface sat above its melt
    //     point, not on how much ENERGY reached it. A blowtorch for a moment and
    //     a weak flame for the same wall-clock time melted about the same, which
    //     is the opposite of how melting works.
    //   - dt appeared explicitly, so the identical scene melted differently at a
    //     different substep count or frame rate.
    // It also needed a `mix(T_melt, T, melt)` fudge to avoid a self-cancelling
    // loop that stalled melting at 50%.
    //
    // The replacement is bookkeeping, not a rate. `st.x` currently holds the
    // temperature the heat exchange just produced. Anything ABOVE the melt point
    // is energy the solid had no other way to absorb, so it buys phase change:
    //
    //     melted_fraction = overshoot / melt_enthalpy_span
    //
    // and exactly that much is subtracted back off the temperature. dt appears
    // nowhere: the energy delivered this step is already baked into st.x by the
    // exponential-exact update above, so two half-steps deliver — and melt — the
    // same as one full step. Short burst versus sustained flame now compare on
    // total energy transferred, which is the physical question.
    //
    // Superheating falls out for free: once max_melt_fraction is reached the
    // budget can absorb nothing more, so molten iron climbs toward its boiling
    // point on its own. No special case, and no 50% stall to work around.
    float area = max(centers[id].w, 1e-8);
    float capacity = max(pc.material2.w * area, 1e-8);
    float burned_total = clamp(aux.z, 0.0, capacity);
    float transferred_total = clamp(aux.w, 0.0, capacity - burned_total);
    float max_melt_fraction = clamp(
        1.0 - (burned_total + transferred_total) / capacity, 0.0, 1.0);
    aux.y = min(aux.y, max_melt_fraction);
    float melt_enthalpy = pc.material2.z;
    float melt_over = st.x - pc.material2.y;
    if (melt_over > 0.0 && aux.y < max_melt_fraction && melt_enthalpy > 0.0) {
        // Spend the overshoot, but never more than the remaining solid can buy.
        float affordable = melt_over / melt_enthalpy;
        float applied = min(affordable, max_melt_fraction - aux.y);
        aux.y += applied;
        // Pay for it out of the temperature. When `applied` was capped by the
        // remaining solid, the unspent overshoot correctly stays as heat.
        st.x -= applied * melt_enthalpy;
    }
    float molten_mass = clamp(aux.y, 0.0, 1.0) * capacity;
    st.y = min(st.y, max(capacity - burned_total - transferred_total - molten_mass, 0.0));

    // Pyrolysis is suppressed by the same factor. Without this a surface sitting
    // exactly at the boiling point with an ignition point below it (paper ignites
    // at 506 K, water boils at 373 K — but a low kelvin_per_unit can invert that
    // in normalized space) would char while visibly soaked.
    if (moisture < 1.0 && st.x >= pc.material0.x && st.y > 0.0) {
        // ★ Burn rate and capacity are per unit AREA. Elements are texels, so
        // their count depends on the mask resolution — without the area factor
        // the same object would consume mass (and vent smoke) faster simply for
        // having a finer mask.
        float solid_available = max(
            capacity - burned_total - transferred_total - molten_mass, 0.0);
        // Damp the burn rate by remaining wetness so extinguishing is gradual
        // rather than a switch: a fire hosed down should die back over a moment,
        // and a barely-damp surface should smoulder rather than stop dead.
        float burned = min(solid_available,
                           pc.material0.z * area * dt * (1.0 - moisture));
        burned_total += burned;
        st.y = max(capacity - burned_total - transferred_total - molten_mass, 0.0);
        // Normalized by this element's own capacity so char saturates exactly as
        // the last of its combustible mass goes, at any resolution.
        st.z = clamp(st.z + burned * pc.material1.y / capacity, 0.0, 1.0);
        // Pyrolysis vapour handed to the scatter pass. The gas domain's regular
        // combustion step then consumes it, so heat and smoke stay domain-driven
        // exactly as they were under the old voxel path.
        aux.x = burned;
        aux.z = burned_total;  // cumulative pyrolysis mass loss
    }

    state[id * 2u] = st;
    state[id * 2u + 1u] = aux;
}
