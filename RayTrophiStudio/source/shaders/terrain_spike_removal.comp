// terrain_spike_removal.comp
// Vulkan port of spikeRemovalKernel (erosion_kernels.cu). Smooths isolated peaks
// (cells significantly higher than all 4 cardinal neighbors).
#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int mapWidth; int mapHeight;
    float cellSize; float heightScale;
    float pitThreshold; float spikeThreshold;
    int edgeFadeWidth;
} pc;

layout(set = 0, binding = 0) readonly  buffer HeightIn  { float heightIn[]; };
layout(set = 0, binding = 1) writeonly buffer HeightOut { float heightOut[]; };

void main() {
    int id = int(gl_GlobalInvocationID.x);
    int total = pc.mapWidth * pc.mapHeight;
    if (id >= total) return;

    int x = id % pc.mapWidth;
    int y = id / pc.mapWidth;
    if (x <= 0 || x >= pc.mapWidth - 1 || y <= 0 || y >= pc.mapHeight - 1) {
        heightOut[id] = heightIn[id];
        return;
    }

    int idx = id;
    float h = heightIn[idx];

    float hL = heightIn[idx - 1];
    float hR = heightIn[idx + 1];
    float hU = heightIn[idx - pc.mapWidth];
    float hD = heightIn[idx + pc.mapWidth];

    float avgNeighbor = (hL + hR + hU + hD) * 0.25;

    if (h > avgNeighbor + pc.spikeThreshold) {
        h = avgNeighbor * 0.3 + h * 0.7;
    }
    heightOut[idx] = h;
}
