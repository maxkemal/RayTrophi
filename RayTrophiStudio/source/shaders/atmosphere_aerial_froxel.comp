#version 460

// ═══════════════════════════════════════════════════════════════════════════
// AERIAL PERSPECTIVE FROXEL -- air + height fog between the camera and depth d
// ═══════════════════════════════════════════════════════════════════════════
// One thread per 32x32 screen cell marches the cell-centre ray through 32
// view-depth slices and writes, per slice end, the in-scattered radiance and
// transmittance (layout: aerial_froxel.glsl). Vulkan RT and RayFusion each run
// THIS shader on their own device with the same parameter block; parity comes
// from that, not from sharing a texture (two VkDevices cannot).
//
// Medium:
//   air   -- the sky-view LUT's model exactly (atmosphere_common.glsl): same
//            scattering, same view extinction (Rayleigh + Mie scattering), same
//            sun irradiance unit (atmosphere intensity). A far mountain fades
//            INTO the sky colour behind it instead of into a different blue.
//   fog   -- exponential height layer: sigma(y) = fog_density *
//            exp(-fog_falloff * max(y - fog_height, 0)), 1/m, scene y in metres,
//            only within fog_distance of the camera. Scatters fog_albedo of
//            what it extinguishes; lit by the sun through the transmittance
//            LUT (Henyey-Greenstein, fog_anisotropy) plus the sky-view LUT's
//            hemisphere average.
//   In non-Nishita world modes there is no LUT: air is off and the fog's
//   in-scatter is fog_albedo itself (radiance) -- the old flat fog mix.
// ═══════════════════════════════════════════════════════════════════════════

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D transmittanceLUT;
layout(binding = 1) uniform sampler2D skyviewLUT;

#define ATMOSPHERE_PARAMS_BINDING 2
#include "atmosphere_common.glsl"
#include "aerial_froxel.glsl"

layout(binding = 3, rgba16f) uniform writeonly image2D froxelAtlas;

// Written with vkCmdUpdateBuffer inside the frame's command buffer (never
// mapped): a host write could land while the previous frame's dispatch is
// still reading. Layout: Backend/AerialFroxelParams.h.
layout(std430, binding = 4) readonly buffer FroxelParams {
    vec4 origin;      // xyz camera position, w = 1 when the Nishita LUTs light the medium
    vec4 lowerLeft;   // xyz image-plane lower-left corner, w = 1 when air scattering is on
    vec4 horizontal;  // xyz image-plane width vector,      w = 1 when height fog is on
    vec4 vertical;    // xyz image-plane height vector
    vec4 fogA;        // density (1/m), height (m), falloff (1/m), distance (m)
    vec4 fogB;        // albedo rgb, anisotropy g
} fx;

const int STEPS_PER_SLICE = 4;

// Sky radiance averaged over the upper hemisphere, uniform in solid angle
// (sin(elevation) = 1/6, 3/6, 5/6). An isotropic scatterer under that sky
// in-scatters sigma_s * 0.5 * this (the lower hemisphere -- ground -- is
// taken as black).
vec3 skyHemisphereMean() {
    vec3 sum = vec3(0.0);
    for (int e = 0; e < 3; ++e) {
        float sinEl = (float(e) * 2.0 + 1.0) / 6.0;
        float cosEl = sqrt(max(1.0 - sinEl * sinEl, 0.0));
        for (int a = 0; a < 8; ++a) {
            float az = (float(a) + 0.5) * (2.0 * PI / 8.0);
            vec3 d = vec3(cos(az) * cosEl, sinEl, sin(az) * cosEl);
            sum += textureLod(skyviewLUT, skyViewLutUV(d), 0.0).rgb;
        }
    }
    return sum / 24.0;
}

// Integral of S * exp(-ext * s) over one step of length dt, divided by the
// entry transmittance (energy-conserving for optically thick steps).
vec3 stepInscatter(vec3 S, vec3 ext, float dt) {
    vec3 r;
    for (int c = 0; c < 3; ++c) {
        r[c] = (ext[c] > 1e-7) ? S[c] * (1.0 - exp(-ext[c] * dt)) / ext[c] : S[c] * dt;
    }
    return r;
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (cell.x >= AF_CELLS || cell.y >= AF_CELLS) return;

    bool lutLit = fx.origin.w > 0.5;
    bool airOn  = fx.lowerLeft.w > 0.5 && lutLit;
    bool fogOn  = fx.horizontal.w > 0.5 && fx.fogA.x > 0.0;

    vec2 uv  = (vec2(cell) + 0.5) / float(AF_CELLS);
    vec3 cam = fx.origin.xyz;
    vec3 dir = normalize(fx.lowerLeft.xyz + uv.x * fx.horizontal.xyz + uv.y * fx.vertical.xyz - cam);
    vec3 fwdN = normalize(cross(fx.horizontal.xyz, fx.vertical.xyz));
    vec3 fwd  = fx.lowerLeft.xyz + 0.5 * fx.horizontal.xyz + 0.5 * fx.vertical.xyz - cam;
    if (dot(fwdN, fwd) < 0.0) fwdN = -fwdN;
    // view depth -> ray length. Cell-centre rays are inside the frustum, so
    // this is bounded by the field of view (never near zero).
    float cosView = max(dot(dir, fwdN), 0.05);

    vec3  sunDir = atmoSunDirection();
    float mu     = dot(dir, sunDir);
    float Rg     = atmoPlanetRadius();
    float altOff = atmoAltitudeOffset();
    float atmoI  = atmoIntensity();

    float phaseR   = phaseRayleigh(mu);
    float phaseM   = min(phaseMie(mu), 2.0);   // same clamp as the sky-view LUT
    float phaseFog = phaseHenyeyGreenstein(fx.fogB.w, mu);
    vec3  fogAlbedo = clamp(fx.fogB.rgb, vec3(0.0), vec3(1.0));
    vec3  ambient   = lutLit ? 0.5 * skyHemisphereMean() : vec3(1.0);

    vec3 L = vec3(0.0), T = vec3(1.0);     // air + fog
    vec3 Lf = vec3(0.0), Tf = vec3(1.0);   // fog only

    float tPrev = 0.0;
    for (int k = 0; k < AF_SLICES; ++k) {
        float tEnd = afSliceEndDepth(k) / cosView;
        float dt = (tEnd - tPrev) / float(STEPS_PER_SLICE);
        for (int i = 0; i < STEPS_PER_SLICE; ++i) {
            float t = tPrev + (float(i) + 0.5) * dt;
            vec3 p = cam + dir * t;

            vec3 Tsun = vec3(1.0);
            vec3 inAir = vec3(0.0), extAir = vec3(0.0);
            if (lutLit) {
                vec3  P   = vec3(p.x, Rg + altOff + p.y, p.z);
                float alt = max(length(P) - Rg, 0.0);
                Tsun = textureLod(transmittanceLUT,
                                  transmittanceLutUV(dot(normalize(P), sunDir), alt), 0.0).rgb;
                if (airOn) {
                    vec3 sR = atmoRayleighScattering(alt);
                    vec3 sM = atmoMieScattering(alt);
                    inAir  = (sR * phaseR + sM * phaseM) * Tsun * atmoI;
                    extAir = sR + sM;
                }
            }

            vec3 inFog = vec3(0.0), extFog = vec3(0.0);
            if (fogOn && t <= fx.fogA.w) {
                float sigma = fx.fogA.x * exp(-fx.fogA.z * max(p.y - fx.fogA.y, 0.0));
                vec3 scat = sigma * fogAlbedo;
                inFog  = lutLit ? scat * (phaseFog * Tsun * atmoI + ambient)
                                : scat * ambient;
                extFog = vec3(sigma);
            }

            vec3 ext = extAir + extFog;
            L  += T  * stepInscatter(inAir + inFog, ext, dt);
            T  *= exp(-ext * dt);
            Lf += Tf * stepInscatter(inFog, extFog, dt);
            Tf *= exp(-extFog * dt);
        }
        tPrev = tEnd;

        int x = k * AF_CELLS + cell.x;
        imageStore(froxelAtlas, ivec2(x, AF_BLOCK_INSCATTER * AF_CELLS + cell.y),
                   vec4(min(L, vec3(60000.0)), 1.0));
        imageStore(froxelAtlas, ivec2(x, AF_BLOCK_TRANSMITTANCE * AF_CELLS + cell.y), vec4(T, 1.0));
        imageStore(froxelAtlas, ivec2(x, AF_BLOCK_FOG_INSCATTER * AF_CELLS + cell.y),
                   vec4(min(Lf, vec3(60000.0)), 1.0));
        imageStore(froxelAtlas, ivec2(x, AF_BLOCK_FOG_TRANS * AF_CELLS + cell.y), vec4(Tf, 1.0));
    }
}
