#version 450
// Device-resident ballistic particle step (particle roadmap Phase 1.5 Batch B).
//
// Ages, kills, applies gravity / buoyancy / force fields / drag and integrates
// the position of every live particle in place. Position and velocity are
// device authoritative for a resident system; age and alive are ALSO advanced
// on the host with the same float operations (ParticleDeviceResidency.cpp), so
// the host can allocate spawn slots without reading anything back. Keep the
// order of operations identical to the CPU reference in
// ParticleSimulationSystem::step: age += dt, kill if age >= lifetime, then
// v = (v + a*dt) * drag, p += v*dt.
#extension GL_GOOGLE_include_directive : require
#include "include/sim_force_fields.glsl"
layout(local_size_x=256) in;
layout(push_constant) uniform PC {
    int particle_count; float dt;
    float gravity_x; float gravity_y; float gravity_z;
    float buoyancy; float drag_factor; float time_seconds;
    uint system_mask; uint force_count;
} pc;
layout(set=0,binding=0) buffer PX {float px[];};
layout(set=0,binding=1) buffer PY {float py[];};
layout(set=0,binding=2) buffer PZ {float pz[];};
layout(set=0,binding=3) buffer VX {float vx[];};
layout(set=0,binding=4) buffer VY {float vy[];};
layout(set=0,binding=5) buffer VZ {float vz[];};
layout(set=0,binding=6) buffer Age {float age[];};
layout(set=0,binding=7) readonly buffer Lifetime {float lifetime[];};
layout(set=0,binding=8) buffer Alive {uint alive[];};
layout(set=0,binding=9,std430) readonly buffer ForceFields {PackedForceField fields[];};
void main(){
    int id=int(gl_GlobalInvocationID.x);
    if(id>=pc.particle_count||alive[id]==0u)return;
    float a_age=age[id]+pc.dt;
    age[id]=a_age;
    if(a_age>=lifetime[id]){alive[id]=0u;return;}
    vec3 p=vec3(px[id],py[id],pz[id]),v=vec3(vx[id],vy[id],vz[id]);
    vec3 a=vec3(pc.gravity_x,pc.gravity_y+pc.buoyancy,pc.gravity_z);
    for(uint i=0u;i<pc.force_count;++i)
        a+=simEvaluateForceField(fields[i],p,v,pc.time_seconds,pc.system_mask);
    v=(v+a*pc.dt)*pc.drag_factor;
    p+=v*pc.dt;
    px[id]=p.x;py[id]=p.y;pz[id]=p.z;
    vx[id]=v.x;vy[id]=v.y;vz[id]=v.z;
}
