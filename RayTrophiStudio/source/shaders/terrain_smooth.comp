// terrain_smooth.comp
// Vulkan port of smoothTerrainKernel (erosion_kernels.cu). Simple center-weighted
// 3x3 box blur used as a post-process pass after wind/hydraulic erosion. In-place
// Ping-ponged: every invocation reads one frozen surface and writes only its
// own output cell. The former in-place version was dispatch-order dependent
// and could erase narrow channels differently across GPU vendors.
#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int width; int height;
} pc;

layout(set = 0, binding = 0) readonly  buffer HeightIn  { float heightIn[]; };
layout(set = 0, binding = 1) writeonly buffer HeightOut { float heightOut[]; };

void main() {
    int id = int(gl_GlobalInvocationID.x);
    int total = pc.width * pc.height;
    if (id >= total) return;

    int x = id % pc.width;
    int y = id / pc.width;

    float sum = 0.0;
    float weightSum = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            int nx = x + dx;
            int ny = y + dy;
            if (nx >= 0 && nx < pc.width && ny >= 0 && ny < pc.height) {
                float w = (dx == 0 && dy == 0) ? 2.0 : 1.0;
                sum += heightIn[ny * pc.width + nx] * w;
                weightSum += w;
            }
        }
    }
    if (weightSum > 0.0) {
        heightOut[id] = sum / weightSum;
    } else {
        heightOut[id] = heightIn[id];
    }
}
