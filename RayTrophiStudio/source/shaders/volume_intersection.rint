/*
 * RayTrophi Studio — Vulkan Volume Intersection Shader
 * AABB Ray-Box Intersection for Procedural Volumetric Geometry
 *
 * This shader handles ray-AABB intersection testing for volume objects.
 * Works with VK_RAY_TRACING_SHADER_GROUP_TYPE_PROCEDURAL_HIT_GROUP_KHR.
 *
 * OptiX uyumluluk:
 *   - OptiX AABB tabanlı volume intersection mantığına eşdeğer
 *   - HitGroupData aabb_min/aabb_max ile uyumlu
 */

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Hit attributes — tNear and tFar passed to closest-hit for ray marching range
hitAttributeEXT vec2 volumeHitAttrib; // .x = tNear, .y = tFar

struct VkVolumeInstance {
    float transform[12];
    vec3  aabb_min;
    vec3  aabb_max;
    float density_multiplier;
    float density_remap_low;
    float density_remap_high;
    float noise_scale;
    vec3  scatter_color;
    float scatter_coefficient;
    float scatter_anisotropy;
    float scatter_anisotropy_back;
    float scatter_lobe_mix;
    float scatter_multi;
    vec3  absorption_color;
    float absorption_coefficient;
    vec3  emission_color;
    float emission_intensity;
    float step_size;
    int   max_steps;
    int   shadow_steps;
    float shadow_strength;
    int   volume_type;
    int   is_active;
    float voxel_size;
    int   _pad0;
    float inv_transform[12];
    uint64_t vdb_grid_address;
    uint64_t vdb_temp_address;
    float    _reserved[2];
    int   emission_mode;
    float temperature_scale;
    float blackbody_intensity;
    float max_temperature;
    int   color_ramp_enabled;
    int   ramp_stop_count;
    int   _ramp_pad[2];
    float ramp_positions[8];
    float ramp_colors_r[8];
    float ramp_colors_g[8];
    float ramp_colors_b[8];
    float pivot_offset[3];
    int   source_type;
    float _retired_cloud[8];   // retired Faz 3b: sky clouds are no longer a volume (ATMOSPHERE_CLOUDS.md)
    float _ext_reserved[12];
    // Appended acceleration block — MUST match VkVolumeInstance in
    // include/Backend/vulkan_volume_types.h (576 bytes). Every shader that
    // declares this struct carries the same tail: the SSBO stride is
    // per-declaration, so one stale copy shifts every instance after the first.
    uint64_t majorant_address;   // per-block density max for live dense gas (0 = none)
    float    majorant_dim[3];    // block-grid resolution
    float    majorant_block;     // cells per block edge
    uint64_t flame_address;      // combustion reaction field for live dense gas (0 = none)
    uint64_t emissive_list_address; // [0]=count, [1..]=emitting block indices
    float    emissive_capacity;
    float    iso_material_index;  // SDF isosurface material, 1-based (0 = none)
    // FULLY CLAIMED: [0]=pore amount, [1]=world units per pore cell,
    // [2]=pore size variation, [3]=coordinate space (0=Material, 1=Domain,
    // 2=World — see materialAnchor below / in volume_closesthit.rchit).
    float    _accel_reserved[4];
    // Material coordinate (UVW) RESIDUAL grid: dense xyz triples at sim-grid
    // resolution holding (uvw - cell centre). Consumed only in
    // volume_closesthit.rchit; mirrored here because the SSBO stride is
    // per-declaration. 0 = not published.
    uint64_t uvw_residual_address;
    // Same grid/origin/voxel as the residual field; 0 = not published.
    // Slotted beside the other address so the struct stays 624 bytes.
    uint64_t composition_address;
    float    uvw_dim[3];
    float    uvw_origin[3];
    float    uvw_voxel;
    // Explicit tail padding, mirroring vulkan_volume_types.h exactly. C++ pads
    // the alignas(16) struct to 608; scalar layout would stop at 600. Implicit
    // padding is where the two are free to disagree, and a stride mismatch does
    // not fail loudly — it reads the NEXT volume's fields as this one's.
    float    _uvw_pad[1];
};

layout(set = 0, binding = 9, scalar) readonly buffer VolumeBuffer { VkVolumeInstance v[]; } volumes;

void main() {
    // An empty simulation domain deliberately keeps its procedural AABB in the
    // TLAS so customIndex -> volume-SSBO slots remain stable across frame 0/1
    // and empty/non-empty transitions. It must nevertheless behave as if no
    // geometry exists. Reject it here, before reportIntersectionEXT: reporting
    // the AABB and returning `scattered=false` from closest-hit terminates the
    // camera path in raygen and paints the box black instead of revealing the
    // scene behind it.
    uint volIdx = gl_InstanceCustomIndexEXT;
    if (volumes.v[volIdx].is_active == 0) {
        return;
    }

    // AABB is implicitly defined by the procedural geometry bounds
    // gl_ObjectRayOriginEXT and gl_ObjectRayDirectionEXT are in object space
    vec3 rayOrigin = gl_ObjectRayOriginEXT;
    vec3 rayDir    = gl_ObjectRayDirectionEXT;
    
    // Unit AABB: [-0.5, 0.5]^3 in object space
    // The actual world-space size is handled by the instance transform
    vec3 boxMin = vec3(-0.5);
    vec3 boxMax = vec3( 0.5);
    
    // Slab-based ray-AABB intersection (Kay-Kajiya)
    vec3 invDir = 1.0 / rayDir;
    
    vec3 t0s = (boxMin - rayOrigin) * invDir;
    vec3 t1s = (boxMax - rayOrigin) * invDir;
    
    vec3 tSmaller = min(t0s, t1s);
    vec3 tLarger  = max(t0s, t1s);
    
    float rawTNear = max(max(tSmaller.x, tSmaller.y), tSmaller.z);
    float tNear = rawTNear;
    float boxFar = min(min(tLarger.x,  tLarger.y),  tLarger.z);

    bool liquidSurface = volumes.v[volIdx].source_type == 4;

    // Clamp to valid ray range
    tNear = max(tNear, gl_RayTminEXT);
    // ★★★★ gl_RayTmaxEXT here is "the closest hit found SO FAR in traversal",
    // i.e. it depends on the order the BVH happens to visit boxes in. A liquid
    // surface box coincident with a fog box reports its entry 1 mm behind the
    // fog's (isoBias below). When the BVH visited the liquid first, the FOG's
    // interval was clamped to that 1 mm: the fog marched 1 mm, stepped ~1 cm
    // past it, re-entered, and did it again — every hop charged as a bounce.
    // Measured 2026-09-28 (render.volume_counters region on the dark patch):
    // 6.44 of 7.92 bounces per path were fog segments, 58% of paths died on
    // the bounce cap, and the gas->liquid arbiter searched for the liquid's
    // exit inside that 1 mm and found it 0.04% of the time. Plain fog with no
    // liquid still paid 2.66 bounces per path.
    // A gas/fog box therefore reports its TRUE exit: anything in front of it
    // is found by its own solid probe and the arbiter, which are exactly the
    // clamps this was standing in for. The liquid
    // surface keeps the clamp: its own march was validated against it.
    float tFar = liquidSurface
        ? min(boxFar, gl_RayTmaxEXT)
        : boxFar;

    // Report hit if we have a valid intersection interval
    if (tNear < tFar && tFar > 0.0 && tNear <= gl_RayTmaxEXT) {
        volumeHitAttrib = vec2(tNear, tFar);
        float reportT = tNear;


        // Coincident participating media must be accumulated before a liquid
        // redirect changes the path. SurfaceSDF is therefore slightly behind
        // gas/fog at an equal AABB entry; the gas closest-hit clamps itself to
        // the actual nearest SDF crossing and explicitly hands the ray over.
        if (liquidSurface) {
            float isoBias = max(0.001, 0.0001 * max(tFar, 1.0));
            reportT = tNear + isoBias;
        }

        reportIntersectionEXT(reportT, 0u); // hitKind = 0 (volume type)
    }
}
