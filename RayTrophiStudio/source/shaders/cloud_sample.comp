#version 460
// Measurement entry point for the cloud field (world.sample_clouds). Evaluates
// the SAME cloudDensity() the renderers use (cloud_common.glsl) at query
// points, so a script measures the field the picture is made of -- there is
// no CPU mirror to drift from it.
//
// mode 0: density (1/m) at query.a
// mode 1: transmittance exp(-integral sigma) along query.a -> query.b,
//         `steps` midpoint samples with full detail
// mode 2: base-shape density (no detail) at query.a
// mode 3: precipitation rate (mm/h) at query.a (cloudPrecipAt)
// mode 4: dominant precipitation form id at query.a (0 none, 1 rain,
//         2 drizzle, 3 snow, 4 sleet, 5 graupel, 6 hail, 7 freezing rain,
//         8 ice pellets; cloudPrecipFormIdAt)
// mode 5: storm cell volume signed distance (m, negative inside; 1e6 outside
//         every box or with volumes off; cloudVolumeSdf)
// mode 6: near-camera drop state at query.a.xyz (near_precip.glsl, the state
//         the drawing uses), component query.a.w: 0 rate mm/h, 1 first form
//         id, 2 second form id, 3/4 their shares, 5/6 their drops per m^3,
//         7 first form streak length m (speed x shutter), 8 its fall speed
//         m/s, 9 its drawn radius m, 10 drop range m (= where the camera
//         ray's curtain starts; 0 = near drops off)
// mode 7: the per-frame near-drop state for the renderers (NOT a query):
//         one invocation evaluates nearStateCompute at cloudParams.nearState
//         .camera and writes it at results[pc.pad ...]; here `results`
//         aliases the params buffer itself (VulkanDevice::updateCloudRtParams,
//         Backend::kCloudNearStateFloatOffset). Reads only camera / sun.

#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

#define CLOUD_SET 0
#define CLOUD_BINDING_BASE 0
#define CLOUD_CELL_BINDING 7
#define CLOUD_VOLUME_BINDING 8
#include "cloud_common.glsl"
#include "near_precip.glsl"

struct CloudQuery { vec4 a; vec4 b; };
layout(set = 0, binding = 5, std430) readonly buffer Queries { CloudQuery queries[]; };
layout(set = 0, binding = 6, std430) writeonly buffer Results { float results[]; };

layout(push_constant) uniform PC {
    uint mode;
    uint count;
    uint steps;
    uint pad;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    vec3 a = queries[i].a.xyz;
    vec3 b = queries[i].b.xyz;
    if (pc.mode == 0u) {
        results[i] = cloudDensity(a, true);
    } else if (pc.mode == 2u) {
        results[i] = cloudDensity(a, false);
    } else if (pc.mode == 3u) {
        results[i] = cloudPrecipAt(a);
    } else if (pc.mode == 4u) {
        results[i] = cloudPrecipFormIdAt(a);
    } else if (pc.mode == 7u) {
        if (i != 0u) return;
        vec4 s[6];
        nearStateCompute(cloudParams.nearState.camera.xyz, normalize(cloudParams.nearState.sun.xyz), s);
        for (int k = 0; k < 6; ++k)
            for (int c = 0; c < 4; ++c)
                results[pc.pad + uint(k * 4 + c)] = s[k][c];
    } else if (pc.mode == 6u) {
        NearPrecipForm f0, f1;
        float rate = nearPrecipForms(a, f0, f1);
        int k = int(queries[i].a.w + 0.5);
        vec3 v = cloudSurfaceWind() + vec3(0.0, -f0.fall, 0.0);
        float r = 0.0;
        if (k == 0) r = rate;
        else if (k == 1) r = float(f0.id);
        else if (k == 2) r = float(f1.id);
        else if (k == 3) r = f0.share;
        else if (k == 4) r = f1.share;
        else if (k == 5) r = f0.density;
        else if (k == 6) r = f1.density;
        else if (k == 7) r = f0.id > 0 ? length(v) * cloudShutter() : 0.0;
        else if (k == 8) r = f0.id > 0 ? f0.fall : 0.0;
        else if (k == 9) r = f0.id > 0 ? f0.radius : 0.0;
        else if (k == 10) r = cloudNearPrecipRange();
        results[i] = r;
    } else if (pc.mode == 5u) {
        results[i] = cloudVolumesActive() ? cloudVolumeSdf(a, cloudAltitude(a)) : 1e6;
    } else {
        uint n = max(pc.steps, 1u);
        float len = length(b - a);
        float dt = len / float(n);
        vec3 dir = len > 0.0 ? (b - a) / len : vec3(0.0);
        float tau = 0.0;
        for (uint k = 0u; k < n; ++k) {
            vec3 p = a + dir * ((float(k) + 0.5) * dt);
            tau += cloudDensity(p, true) * dt;
        }
        results[i] = exp(-tau);
    }
}
