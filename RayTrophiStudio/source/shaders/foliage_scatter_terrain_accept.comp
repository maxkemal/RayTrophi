#version 460

layout(local_size_x = 256) in;

struct Settings {
    uvec4 meta;
    uvec4 terrain;
    vec4 worldToLocal[4];
    vec4 localToWorld[4];
    vec4 heightSlopeEdge;
    vec4 curvature;
    vec4 direction;
    vec4 scale;
    vec4 rotation;
    vec4 offsetMask;
    vec4 brush;
    ivec4 maskSlots;
};

layout(set=0,binding=0,std430) readonly buffer SettingsBuffer { Settings settings[]; };
layout(set=0,binding=1,std430) readonly buffer Heights { float heights[]; };
layout(set=0,binding=2,std430) readonly buffer DensityField { float densityField[]; };
layout(set=0,binding=3,std430) readonly buffer ExclusionField { float exclusionField[]; };
layout(set=0,binding=4,std430) readonly buffer ScaleField { float scaleField[]; };
// x = include splat, y = exclusion splat. Host resamples the source texture to
// the heightmap grid once, avoiding texture descriptors in the shared backend.
layout(set=0,binding=5,std430) readonly buffer SplatFields { vec2 splatFields[]; };
// Low 31 bits = rejection mask; high bit = accepted. Candidate ID is the array index.
layout(set=0,binding=6,std430) writeonly buffer Decisions { uint decisions[]; };

layout(push_constant) uniform PC { uint count; uint settingsIndex; uint pad0; uint pad1; } pc;

const uint HAS_DENSITY       = 1u << 0;
const uint HAS_EXCLUSION     = 1u << 1;
const uint HAS_SCALE         = 1u << 2;
const uint HAS_SPLAT_INCLUDE = 1u << 3;
const uint HAS_SPLAT_EXCLUDE = 1u << 4;
const uint ALLOW_RIDGES      = 1u << 7;
const uint ALLOW_FLATS       = 1u << 8;
const uint ALLOW_GULLIES     = 1u << 9;

const uint REJECT_EDGE             = 1u << 0;
const uint REJECT_HEIGHT           = 1u << 1;
const uint REJECT_SLOPE            = 1u << 2;
const uint REJECT_CURVATURE        = 1u << 3;
const uint REJECT_DIRECTION        = 1u << 4;
const uint REJECT_EXCLUSION_FIELD  = 1u << 5;
const uint REJECT_EXCLUSION_SPLAT  = 1u << 6;
const uint REJECT_DENSITY          = 1u << 7;

uint hash32(uint value) {
    value ^= value >> 16u; value *= 0x7feb352du;
    value ^= value >> 15u; value *= 0x846ca68bu;
    value ^= value >> 16u; return value;
}
float random01(uint seed,uint id,uint stream) {
    return float(hash32(seed ^ hash32(id + 0x9e3779b9u*(stream+1u))) >> 8u) * (1.0/16777216.0);
}

#define DECLARE_GRID_SAMPLER(FN,DATA) \
float FN(vec2 uv,uint w,uint h){ \
    vec2 g=clamp(uv,vec2(0),vec2(1))*vec2(w-1u,h-1u); \
    uvec2 a=uvec2(g);uvec2 b=min(a+uvec2(1),uvec2(w-1u,h-1u));vec2 f=fract(g); \
    float v0=mix(DATA[a.y*w+a.x],DATA[a.y*w+b.x],f.x); \
    float v1=mix(DATA[b.y*w+a.x],DATA[b.y*w+b.x],f.x);return mix(v0,v1,f.y); \
}
DECLARE_GRID_SAMPLER(sampleHeightGrid,heights)
DECLARE_GRID_SAMPLER(sampleDensityGrid,densityField)
DECLARE_GRID_SAMPLER(sampleExclusionGrid,exclusionField)
DECLARE_GRID_SAMPLER(sampleScaleGrid,scaleField)
vec2 sampleSplat(vec2 uv,uint w,uint h) {
    uint x=min(uint(clamp(uv.x,0.0,1.0)*float(w-1u)),w-1u);
    uint y=min(uint((1.0-clamp(uv.y,0.0,1.0))*float(h-1u)),h-1u);
    return splatFields[y*w+x];
}

void main() {
    uint id=gl_GlobalInvocationID.x; if(id>=pc.count)return;
    Settings s=settings[pc.settingsIndex]; uint w=s.terrain.x,h=s.terrain.y,flags=s.terrain.w;
    uint seed=s.meta.z; uint mode=s.meta.x;
    vec2 uv;
    if(mode==1u) {
        float radius=sqrt(random01(seed,id,2u))*s.brush.z;
        float angle=random01(seed,id,3u)*6.28318530718;
        uv=s.brush.xy+vec2(cos(angle),sin(angle))*radius;
    } else uv=vec2(random01(seed,id,2u),random01(seed,id,3u));

    uint reject=0u;
    if(any(lessThan(uv,vec2(s.heightSlopeEdge.w))) || any(greaterThan(uv,vec2(1.0-s.heightSlopeEdge.w)))) reject|=REJECT_EDGE;
    float rawHeight=sampleHeightGrid(uv,w,h);
    float worldHeight=rawHeight*s.scale.w;
    if(worldHeight<s.heightSlopeEdge.x||worldHeight>s.heightSlopeEdge.y)reject|=REJECT_HEIGHT;

    int step=max(1,int(s.curvature.z));
    ivec2 cell=ivec2(round(uv*vec2(w-1u,h-1u)));
    cell=clamp(cell,ivec2(step),ivec2(int(w)-1-step,int(h)-1-step));
    float hl=heights[cell.y*int(w)+cell.x-step],hr=heights[cell.y*int(w)+cell.x+step];
    float hu=heights[(cell.y-step)*int(w)+cell.x],hd=heights[(cell.y+step)*int(w)+cell.x];
    float hc=heights[cell.y*int(w)+cell.x];
    float cellX=max(1e-6,s.rotation.z),cellZ=max(1e-6,s.rotation.w);
    float dx=((hr-hl)*s.scale.w)/(2.0*cellX*float(step));
    float dz=((hd-hu)*s.scale.w)/(2.0*cellZ*float(step));
    float slope=degrees(atan(sqrt(dx*dx+dz*dz)));
    if(slope>s.heightSlopeEdge.z)reject|=REJECT_SLOPE;
    float curve=((hl+hr+hu+hd)-4.0*hc)/float(step*step)*1000.0;
    bool ridge=curve<s.curvature.x,gully=curve>s.curvature.y,flatRegion=!ridge&&!gully;
    if((ridge&&(flags&ALLOW_RIDGES)==0u)||(flatRegion&&(flags&ALLOW_FLATS)==0u)||(gully&&(flags&ALLOW_GULLIES)==0u))reject|=REJECT_CURVATURE;

    if(s.direction.y>0.01&&slope>2.0) {
        float aspect=degrees(atan(-dx,-dz)); if(aspect<0.0)aspect+=360.0;
        float difference=abs(aspect-s.direction.x);if(difference>180.0)difference=360.0-difference;
        float weight=max(0.0,cos(radians(difference)));
        float probability=mix(1.0,weight,clamp(s.direction.y,0.0,1.0));
        if(random01(seed,id,4u)>probability)reject|=REJECT_DIRECTION;
    }

    float density=(flags&HAS_DENSITY)!=0u?sampleDensityGrid(uv,w,h):1.0;
    float exclusion=(flags&HAS_EXCLUSION)!=0u?sampleExclusionGrid(uv,w,h):-1.0;
    uint splatW=uint(max(s.maskSlots.z,1)),splatH=uint(max(s.maskSlots.w,1));
    vec2 splat=sampleSplat(uv,splatW,splatH);
    if(exclusion>=0.0&&exclusion>=s.offsetMask.z)reject|=REJECT_EXCLUSION_FIELD;
    if((flags&HAS_SPLAT_EXCLUDE)!=0u&&splat.y>=s.offsetMask.z)reject|=REJECT_EXCLUSION_SPLAT;
    float includeWeight=clamp(density,0.0,1.0)*((flags&HAS_SPLAT_INCLUDE)!=0u?clamp(splat.x,0.0,1.0):1.0);
    if((flags&HAS_SPLAT_INCLUDE)!=0u&&splat.x<0.2)includeWeight=0.0;
    if(random01(seed,id,0u)>includeWeight)reject|=REJECT_DENSITY;
    decisions[id]=reject|(reject==0u?0x80000000u:0u);
}
