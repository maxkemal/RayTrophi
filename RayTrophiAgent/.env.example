# RayTrophi agent runtime configuration. Copy to .env and fill in.

# mock | openai | gemini | local
# mock needs no key and exercises the tool loop and the panel end to end.
LLM_PROVIDER=local

# OpenAI (the best-tested tool-calling path)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local, OpenAI-compatible server (Ollama, LM Studio).
# The model must support tool calling or it will never touch the engine.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b

# IPC
IPC_PIPE_NAME=\\.\pipe\RayTrophiStudio
POLL_INTERVAL_SEC=1.0

# Orchestrator limits
MAX_TOOL_ITERATIONS=16
MAX_HISTORY_MESSAGES=60
